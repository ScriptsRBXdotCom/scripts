local function getRequiredSpeed(area)
    for _, descendant in ipairs(area:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            local number = tostring(descendant.Text):match("[Ss]peed%s+[Rr]equired:%s*([%d,%.]+)")
            if number then
                return tonumber((number:gsub(",", "")))
            end
        end
    end
    return requiredSpeedByCourse[selectedArea]
end

local function setRouteProtection(character, active)
    if active then
        if protectedCharacter and protectedCharacter ~= character then
            setRouteProtection(protectedCharacter, false)
        end
        protectedCharacter = character
        protectedRoot = character and character:FindFirstChild("HumanoidRootPart")
        if protectedRoot and savedAnchored == nil then
            savedAnchored = protectedRoot.Anchored
        end
        if protectedRoot then
            protectedRoot.AssemblyLinearVelocity = Vector3.zero
            protectedRoot.AssemblyAngularVelocity = Vector3.zero
            protectedRoot.Anchored = true
        end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if savedTouch[part] == nil then
                    savedTouch[part] = part.CanTouch
                end
                part.CanTouch = false
            end
        end
        return
    end
    if protectedCharacter then
        for part, canTouch in pairs(savedTouch) do
            if part.Parent and part:IsDescendantOf(protectedCharacter) then
                part.CanTouch = canTouch
            end
            savedTouch[part] = nil
        end
    end
    if protectedRoot and protectedRoot.Parent then
        protectedRoot.Anchored = savedAnchored == true
        protectedRoot.AssemblyLinearVelocity = Vector3.zero
        protectedRoot.AssemblyAngularVelocity = Vector3.zero
    end
    protectedCharacter = nil
    protectedRoot = nil
    savedAnchored = nil
end

local function stop()
    if closed then
        return
    end
    closed = true
    enabled = false
    setRouteProtection(nil, false)
    RunService:UnbindFromRenderStep("RingFarmApproach")
    if approachHumanoid and approachHumanoid.Parent then
        approachHumanoid:Move(Vector3.zero)
    end
    approachTarget = nil
    if deathConnection then
        deathConnection:Disconnect()
    end
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    if not window.unloaded then
        window:Unload()
    end
end
