RunService:BindToRenderStep("RingFarmApproach", Enum.RenderPriority.Last.Value, function(deltaTime)
    if not approachTarget or not approachHumanoid or not approachRoot then
        return
    end
    if closed or window.unloaded or not enabled or approachHumanoid.Health <= 0
        or approachRoot.Parent ~= player.Character then
        approachHumanoid:Move(Vector3.zero)
        approachTarget = nil
        return
    end
    local offset = approachTarget - approachRoot.Position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    if horizontal.Magnitude < 2 then
        approachHumanoid:Move(Vector3.zero)
        return
    end
    local speed = math.max(approachHumanoid.WalkSpeed, 1)
    local strength = math.min(1, 24 / speed, horizontal.Magnitude / (speed * math.max(deltaTime, 0.001) * 2))
    approachHumanoid:Move(horizontal.Unit * strength, false)
end)

