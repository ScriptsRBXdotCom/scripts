local function watchCharacter(character)
    if deathConnection then
        deathConnection:Disconnect()
        deathConnection = nil
    end
    visited = {}
    resumeAt = os.clock() + 0.75
    nextFinishAttempt = 0
    log("Respawn detected; waiting for living character")
    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10)
        if closed or window.unloaded or player.Character ~= character or not humanoid then
            return
        end
        deathConnection = humanoid.Died:Connect(function()
            if lastRing and os.clock() - lastRingTime < 1 then
                dangerousUntil[lastRing] = os.clock() + 30
                log("Pausing visits to the last ring for 30 seconds after death")
            end
            visited = {}
            log("Character died; Autofarm will resume after respawn")
            if enabled then
                if resettingCycle then
                    resettingCycle = false
                elseif not selectNextCourse(selectedArea) then
                    returnToCycleStart()
                end
                task.spawn(function()
                    for _, delaySeconds in ipairs({ 0, 0.15, 0.4, 0.8, 1.4 }) do
                        if delaySeconds > 0 then
                            task.wait(delaySeconds)
                        end
                        if player.Character ~= character then
                            return
                        end
                        local currentCore = ReplicatedStorage:FindFirstChild("Core")
                        local currentRemotes = currentCore and currentCore:FindFirstChild("Remotes")
                        local session = currentRemotes and currentRemotes:FindFirstChild("Session")
                        if session and session:IsA("RemoteEvent") then
                            session:FireServer({ Action = "DeclineRevive" })
                        end
                    end
                    log("Sent revive decline requests")
                end)
            end
        end)
    end)
end
