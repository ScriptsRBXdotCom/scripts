local function nearestRing(area, position)
    local candidates = {}
    for _, ring in ipairs(CollectionService:GetTagged("SonicRing")) do
        if ring:IsA("BasePart") and ring:IsDescendantOf(area)
            and (ring.LocalTransparencyModifier < 1 or failures > 0) and not visited[ring]
            and os.clock() >= (dangerousUntil[ring] or 0) then
            table.insert(candidates, ring)
        end
    end
    if #candidates == 0 then
        return nil
    end

    if ringRouteArea ~= area then
        ringRoute = {}
        ringRouteArea = area
        local pads = workspace:FindFirstChild("FinishPads")
        local pad = pads and pads:FindFirstChild(selectedArea)
        local finish = pad and pad:FindFirstChild("Touch")
        local cursor = position
        if finish and finish:IsA("BasePart") then
            local farthestDistance = -1
            for _, ring in ipairs(candidates) do
                local distance = (ring.Position - finish.Position).Magnitude
                if distance > farthestDistance then
                    farthestDistance = distance
                    cursor = ring.Position
                end
            end
        end
        while #candidates > 0 do
            local bestIndex = 1
            local bestDistance = math.huge
            for index, ring in ipairs(candidates) do
                local distance = (ring.Position - cursor).Magnitude
                if distance < bestDistance then
                    bestIndex = index
                    bestDistance = distance
                end
            end
            local ring = table.remove(candidates, bestIndex)
            table.insert(ringRoute, ring)
            cursor = ring.Position
        end
        log("Built entrance-to-finish route with " .. #ringRoute .. " rings")
    end

    for _, ring in ipairs(ringRoute) do
        if not visited[ring] and ring:IsDescendantOf(area)
            and (ring.LocalTransparencyModifier < 1 or failures > 0)
            and os.clock() >= (dangerousUntil[ring] or 0) then
            return ring
        end
    end
    return nil
end

