local function switchCourse(courseNumber, direction)
    switchingCourse = true
    areaDropdown:Set(tostring(courseNumber))
    switchingCourse = false
    log("Trying " .. direction .. " course " .. courseNumber)
end

local function selectNextCourse(failedCourse)
    local current = tonumber(selectedArea)
    if not current then
        return false
    end
    failedCourses[tostring(failedCourse or current)] = true
    local nextCourse
    for _, option in ipairs(options) do
        local courseNumber = tonumber(option)
        if courseNumber and not failedCourses[tostring(courseNumber)] then
            if courseNumber > current and (not nextCourse or courseNumber < nextCourse) then
                nextCourse = courseNumber
            end
        end
    end
    if nextCourse then
        switchCourse(nextCourse, "next")
        return true
    end
    return false
end

local function returnToCycleStart()
    failedCourses = {}
    switchingCourse = true
    areaDropdown:Set(tostring(cycleStartCourse))
    switchingCourse = false
    log("Returning to cycle start course " .. tostring(cycleStartCourse))
end
