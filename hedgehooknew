local function getFinishTouch(courseName)
    local pads = workspace:FindFirstChild("FinishPads")
    local pad = pads and pads:FindFirstChild(courseName)
    local touch = pad and pad:FindFirstChild("Touch")
    if touch and touch:IsA("BasePart") then
        return touch
    end

    local streamPosition = lastCoursePosition[courseName]
    if streamPosition then
        log("Finish pad is streamed out; requesting the end of course " .. courseName)
        pcall(player.RequestStreamAroundAsync, player, streamPosition, 1)
    end

    local deadline = os.clock() + 1
    repeat
        RunService.Heartbeat:Wait()
        pads = workspace:FindFirstChild("FinishPads")
        pad = pads and pads:FindFirstChild(courseName)
        touch = pad and pad:FindFirstChild("Touch")
    until touch or os.clock() >= deadline or closed or window.unloaded
        or not enabled or selectedArea ~= courseName

    return touch and touch:IsA("BasePart") and touch or nil
end

local function approachFinish(area, character, root, humanoid)
    local course = selectedArea
    local points = course == "1" and { 370, 380, 390, 395 } or { 620, 650, 680, 710, 738 }
    local track = area:FindFirstChild("Track")
    assert(track, "Course " .. course .. " track is unavailable")
    local parameters = RaycastParams.new()
    parameters.FilterType = Enum.RaycastFilterType.Include
    parameters.FilterDescendantsInstances = { track }
    log("Walking Course " .. course .. " finish approach")
    for index, x in ipairs(points) do
        if closed or window.unloaded or not enabled or selectedArea ~= course
            or player.Character ~= character or humanoid.Health <= 0 then
            humanoid:Move(Vector3.zero)
            return false
        end
        local hit = workspace:Raycast(Vector3.new(x, 150, 4), Vector3.new(0, -200, 0), parameters)
        assert(hit, "Course " .. course .. " track surface unavailable at X=" .. x)
        local destination = hit.Position + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0)
        if index == 1 then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(destination)
            RunService.Heartbeat:Wait()
        else
            approachHumanoid = humanoid
            approachRoot = root
            approachTarget = destination
            local deadline = os.clock() + 6
            repeat
                RunService.Heartbeat:Wait()
            until (root.Position - destination).Magnitude < 6 or os.clock() >= deadline
                or closed or window.unloaded or not enabled or selectedArea ~= course
                or player.Character ~= character or humanoid.Health <= 0
            approachTarget = nil
            humanoid:Move(Vector3.zero)
            if closed or window.unloaded or not enabled or selectedArea ~= course
                or player.Character ~= character or humanoid.Health <= 0
                or (root.Position - destination).Magnitude >= 6 then
                humanoid:Move(Vector3.zero)
                log("Finish approach interrupted at X=" .. x
                    .. " | Position " .. tostring(root.Position)
                    .. " | Target " .. tostring(destination)
                    .. " | Distance " .. string.format("%.2f", (root.Position - destination).Magnitude)
                    .. " | Health " .. tostring(humanoid.Health)
                    .. " | WalkSpeed " .. tostring(humanoid.WalkSpeed))
                return false
            end
        end
    end
    humanoid:Move(Vector3.zero)
    return true
end

task.spawn(function()
    local waiting = false
    while not closed and not window.unloaded do
        if enabled and os.clock() >= resumeAt then
            local ok, problem = pcall(function()
                local character = player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local area = getArea()
                if not root or not humanoid or humanoid.Health <= 0 or not area then
                    return
                end
                local requiredSpeed = getRequiredSpeed(area)
                if requiredSpeed and humanoid.WalkSpeed + 0.01 < requiredSpeed then
                    local requirementKey = selectedArea .. ":" .. requiredSpeed
                    if lastRequirementMessage ~= requirementKey then
                        lastRequirementMessage = requirementKey
                        log("Course " .. selectedArea .. " requires movement speed " .. requiredSpeed
                            .. "; current movement speed is " .. string.format("%.1f", humanoid.WalkSpeed))
                    end
                    local fallbackCourse = lastSuccessfulCourse or cycleStartCourse
                    if tostring(fallbackCourse) ~= selectedArea then
                        switchCourse(tonumber(fallbackCourse), "last successful")
                        local claimedAt = lastClaimAt[tostring(fallbackCourse)]
                        resumeAt = math.max(resumeAt, os.clock() + CLAIM_COOLDOWN,
                            claimedAt and claimedAt + CLAIM_COOLDOWN or 0)
                        log("Course " .. tostring(fallbackCourse)
                            .. " is the highest unlocked course; waiting before retrying it")
                    else
                        resumeAt = math.max(resumeAt, os.clock() + 1)
                    end
                    return
                end
                lastRequirementMessage = nil
                local ring = nearestRing(area, root.Position)
                if not ring then
                    if selectedArea ~= "Lobby" and os.clock() >= nextFinishAttempt then
                        setRouteProtection(nil, false)
                        RunService.Heartbeat:Wait()
                        local touch = getFinishTouch(selectedArea)
                        if not touch then
                            local unavailableCourse = selectedArea
                            log("Finish pad is unavailable for course " .. unavailableCourse)
                            if not selectNextCourse(unavailableCourse) then
                                returnToCycleStart()
                                resettingCycle = true
                                log("No later finish pad is available; resetting character")
                                task.defer(function()
                                    if player.Character == character and humanoid.Health > 0 then
                                        humanoid.Health = 0
                                    end
                                end)
                            end
                            return
                        end
                        if (selectedArea == "1" or selectedArea == "2")
                            and not approachFinish(area, character, root, humanoid) then
                            local failedApproachCourse = selectedArea
                            if not selectNextCourse(failedApproachCourse) then
                                returnToCycleStart()
                                resettingCycle = true
                                log("Finish approach failed on the highest course; resetting character")
                                task.defer(function()
                                    if player.Character == character and humanoid.Health > 0 then
                                        humanoid.Health = 0
                                    end
                                end)
                            end
                            return
                        end
                        local stats = player:FindFirstChild("leaderstats")
                        local wins = stats and stats:FindFirstChild("Wins")
                        local beforeWins = wins and wins.Value
                        local attemptArea = selectedArea
                        nextFinishAttempt = os.clock() + 3
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        local landing = touch.CFrame * CFrame.new(0,
                            touch.Size.Y / 2 + humanoid.HipHeight + root.Size.Y / 2, 0)
                        -- Separate from the pad before landing again to create a fresh touch.
                        root.CFrame = landing + Vector3.new(0, 6, 0)
                        RunService.Heartbeat:Wait()
                        if closed or window.unloaded or not enabled or selectedArea ~= attemptArea
                            or player.Character ~= character or humanoid.Health <= 0 then
                            return
                        end
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.CFrame = landing
                        log("Reached finish pad for course " .. attemptArea)
                        local deadline = os.clock() + 0.25
                        repeat
                            RunService.Heartbeat:Wait()
                        until os.clock() >= deadline or not enabled or closed or window.unloaded
                            or selectedArea ~= attemptArea or player.Character ~= character
                            or humanoid.Health <= 0 or (wins and beforeWins and wins.Value > beforeWins)
                        if closed or window.unloaded or not enabled or selectedArea ~= attemptArea then
                            return
                        end
                        local afterWins = wins and wins.Value
                        log("Finish result: Wins " .. tostring(beforeWins) .. " -> " .. tostring(afterWins))
                        if player.Character ~= character or humanoid.Health <= 0 then
                            log("Character died or respawned during finish attempt")
                        elseif beforeWins and afterWins and afterWins > beforeWins then
                            failures = 0
                            failedCourses = {}
                            lastSuccessfulCourse = attemptArea
                            lastClaimAt[attemptArea] = os.clock()
                            visited = {}
                            resumeAt = lastClaimAt[attemptArea] + CLAIM_COOLDOWN
                            nextFinishAttempt = 0
                            log("Successful claim; course " .. attemptArea
                                .. " will restart after the server claim cooldown")
                        else
                            failures = failures + 1
                            visited = {}
                            if not selectNextCourse(attemptArea) then
                                returnToCycleStart()
                                resettingCycle = true
                                log("Highest available course failed; resetting character for a fresh cycle")
                                task.defer(function()
                                    if player.Character == character and humanoid.Health > 0 then
                                        humanoid.Health = 0
                                    end
                                end)
                            end
                        end
                        return
                    end
                    if not waiting then
                        log("Waiting for fresh loaded rings or a ring reset")
                        waiting = true
                    end
                    return
                end
                waiting = false
                if selectedArea == "3" or selectedArea == "4" then
                    setRouteProtection(character, true)
                else
                    setRouteProtection(nil, false)
                end
                visited[ring] = true
                local before = speedValue()
                local target = ring.Position
                lastCoursePosition[selectedArea] = target
                lastRing = ring
                lastRingTime = os.clock()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                local height = math.min(3, ring.Size.X * 0.5 + 1.5)
                root.CFrame = CFrame.new(target + Vector3.new(0, height, 0))
                log("Visited " .. ring:GetFullName() .. " at " .. tostring(target))
                local deadline = os.clock() + delaySeconds
                repeat
                    RunService.Heartbeat:Wait()
                until os.clock() >= deadline or not enabled or closed or window.unloaded
                    or player.Character ~= character or humanoid.Health <= 0
                if closed or window.unloaded then
                    return
                end
                local arrivalDistance = (root.Position - target).Magnitude
                if player.Character == character and humanoid.Health > 0
                    and arrivalDistance > math.max(6, ring.Size.X * 0.5 + 3) then
                    local settleFailures = (ringSettleFailures[ring] or 0) + 1
                    ringSettleFailures[ring] = settleFailures
                    if settleFailures < 2 then
                        visited[ring] = nil
                        resumeAt = os.clock() + 0.05
                        log("Teleport did not settle at ring; one fast retry | Distance "
                            .. string.format("%.2f", arrivalDistance))
                    else
                        log("Skipping ring after two snapbacks | Distance "
                            .. string.format("%.2f", arrivalDistance))
                    end
                    return
                end
                ringSettleFailures[ring] = nil
                log("Speed " .. before .. " -> " .. speedValue()
                    .. " | Distance " .. string.format("%.2f", arrivalDistance)
                    .. " | Health " .. tostring(humanoid.Health))
            end)
            if not ok then
                approachTarget = nil
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid:Move(Vector3.zero)
                end
                resumeAt = os.clock() + 3
                log("Retrying in 3 seconds after error: " .. tostring(problem))
            end
        end
        RunService.Heartbeat:Wait()
    end
    stop()
end)
