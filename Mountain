-- UPGRADE HELPERS
--------------------------------------------------

local function decode(value)
	if typeof(value) ~= "string" then
		return {}
	end

	local success, result = pcall(function()
		return HttpService:JSONDecode(value)
	end)

	if success and result then
		return result
	end

	return {}
end

--------------------------------------------------
-- OWNED UPGRADES
--------------------------------------------------

local function getOwned()
	local owned = {}

	local personal = decode(
		Player:GetAttribute("OwnedUpgrades")
	)

	for id, value in pairs(personal) do
		if value then
			owned[id] = true
		end
	end

	local squad = decode(
		State:GetAttribute("SquadOwned")
	)

	for id, value in pairs(squad) do
		if value then
			owned[id] = true
		end
	end

	return owned
end

--------------------------------------------------
-- AVAILABLE UPGRADES
--------------------------------------------------

local function getAvailableUpgrades()
	local owned = getOwned()
	local upgrades = {}

	for treeName, tree in pairs(UpgradeTree) do
		for id, upgrade in pairs(tree) do
			if upgrade.cost and not owned[id] then
				local dependencyMet =
					upgrade.dependency == "origin"
					or owned[upgrade.dependency]

				if dependencyMet then
					table.insert(upgrades, {
						id = id,
						name = upgrade.name,
						tree = treeName,
						cost = upgrade.cost.amount
							or math.huge,
						currency = upgrade.cost.currency
					})
				end
			end
		end
	end

	-- Cheapest available upgrade first
	table.sort(upgrades, function(a, b)
		if a.cost == b.cost then
			return a.id < b.id
		end

		return a.cost < b.cost
	end)

	return upgrades
end

--------------------------------------------------
-- PURCHASE FUNCTION
--------------------------------------------------

local function purchaseUpgrade(upgrade)
	if not upgrade then
		return false
	end

	local success, purchased, reason = pcall(function()
		return TreePurchase:InvokeServer(upgrade.id)
	end)

	if not success then
		warn(
			"TreePurchase error:",
			purchased
		)

		return false
	end

	if purchased == true then
		print(
			"PURCHASED:",
			upgrade.id,
			"Cost:",
			upgrade.cost
		)

		return true
	end

	print(
		"Can't buy:",
		upgrade.id,
		reason
	)

	return false
end

