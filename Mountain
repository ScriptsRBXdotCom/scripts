--------------------------------------------------
-- AUTO UPGRADE LOOP
--------------------------------------------------

task.spawn(function()
	while true do
		if not AutoUpgrade then
			task.wait(0.25)
			continue
		end

		local upgrades = getAvailableUpgrades()
		local purchasedSomething = false

		for _, upgrade in ipairs(upgrades) do
			if not AutoUpgrade then
				break
			end

			-- No unused "reason" variable here anymore
			local success, result = pcall(function()
				return TreePurchase:InvokeServer(
					upgrade.id
				)
			end)

			if success and result == true then
				print(
					"Purchased:",
					upgrade.id,
					upgrade.cost
				)

				purchasedSomething = true

				-- Allow ownership attributes to update
				task.wait(0.15)

				-- Rescan the tree because new upgrades
				-- may now be unlocked
				break
			end

			task.wait(0.05)
		end

		if not purchasedSomething then
			task.wait(UpgradeDelay)
		end
	end
end)
