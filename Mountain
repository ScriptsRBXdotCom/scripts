--------------------------------------------------
-- GET BLOCKS IN ROW
--------------------------------------------------

local function getBlocksInRow(row)
	local blocks = {}

	for _, block in ipairs(Mountain:GetChildren()) do
		if block:IsA("BasePart") then
			local x, y, z = block.Name:match(
				"^(%d+)_(%d+)_(%d+)$"
			)

			x = tonumber(x)
			y = tonumber(y)
			z = tonumber(z)

			if x == row then
				table.insert(blocks, {
					part = block,
					y = y,
					z = z
				})
			end
		end
	end

	table.sort(blocks, function(a, b)
		if a.y == b.y then
			return a.z < b.z
		end

		return a.y < b.y
	end)

	return blocks
end

--------------------------------------------------
-- AUTO MINE LOOP
--------------------------------------------------

task.spawn(function()
	while true do
		if not AutoMine then
			task.wait(0.2)
			continue
		end

		local blocks = getBlocksInRow(CurrentRow)

		-- Current row is empty
		if #blocks == 0 then
			print("Row", CurrentRow, "cleared")

			CurrentRow += 1

			print("Starting row", CurrentRow)

			task.wait(0.15)
			continue
		end

		for _, data in ipairs(blocks) do
			if not AutoMine then
				break
			end

			local block = data.part

			while AutoMine
				and block
				and block.Parent
			do
				MineHit:FireServer(
					block.Name,
					Damage
				)

				task.wait(MineDelay)
			end
		end
	end
end)

