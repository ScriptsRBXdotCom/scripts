--====================================================
-- SETTINGS
--====================================================

local Settings = {
    AutoMerge = false,
    AutoBuyPickaxe = false,
    AutoWeaponLevel = false,
    AutoSwingSpeed = false,
    AutoEquipBest = false,
    AutoAdventureEgg = false,
}

-- Your board appears to have 9 plot cells.
local MAX_PLOT_ID = 9

-- We don't know the exact Character slot maximum yet.
-- Invalid locations are simply ignored by the scanner.
local MAX_CHARACTER_ID = 20

local MERGE_DELAY = 0.35
local BUY_DELAY = 0.5
local EQUIP_DELAY = 2
local EGG_DELAY = 0.5
local UPGRADE_DELAY = 30

--====================================================
-- SAFE REMOTE CALL
--====================================================

local function safeInvoke(remote, ...)
    local arguments = {...}

    local success, result = pcall(function()
        return remote:InvokeServer(
            table.unpack(arguments)
        )
    end)

    if not success then
        warn("[Auto Farm] Remote error:", result)
    end

    return success, result
end

--====================================================
-- AUTO MERGE
--====================================================

local function location(locationType, id)
    return {
        type = locationType,
        id = tostring(id)
    }
end

local function getWeaponAt(locationData)
    local success, weapon = pcall(function()
        return WeaponUtils.GetPhysicalWeapon(
            Player,
            locationData
        )
    end)

    if success then
        return weapon
    end

    return nil
end

local function addLocation(groups, locationData)
    local weapon = getWeaponAt(locationData)

    if not weapon then
        return
    end

    local weaponName = weapon.Name

    groups[weaponName] =
        groups[weaponName] or {}

    table.insert(
        groups[weaponName],
        {
            weapon = weapon,
            location = locationData
        }
    )
end

local function scanWeapons()
    local groups = {}

    -- Plot slots
    for id = 1, MAX_PLOT_ID do
        addLocation(
            groups,
            location("Plot", id)
        )
    end

    -- Character slots
    for id = 1, MAX_CHARACTER_ID do
        addLocation(
            groups,
            location("Character", id)
        )
    end

    return groups
end

local function findMergePair()
    local groups = scanWeapons()

    for weaponName, entries in pairs(groups) do
        if #entries >= 2 then
            return entries[1], entries[2], weaponName
        end
    end

    return nil
end

local function autoMergeOnce()
    local first, second, weaponName =
        findMergePair()

    if not first or not second then
        return false
    end

    print(
        "[Auto Merge]",
        weaponName,
        first.location.type,
        first.location.id,
        "->",
        second.location.type,
        second.location.id
    )

    safeInvoke(
        MergeRemote,
        first.location,
        second.location
    )

    return true
end

--====================================================
-- LOOPS
--====================================================

task.spawn(function()
    while true do
        if Settings.AutoMerge then
            local merged = autoMergeOnce()

            if merged then
                task.wait(MERGE_DELAY)
            else
