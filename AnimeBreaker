end

--------------------------------------------------
-- FIND ENEMIES
--------------------------------------------------

local function GetEnemies()
    local results = {}

    local enemyFolder =
        GetEnemyFolder()

    if not enemyFolder then
        return results
    end

    for _, gui in ipairs(
        PlayerGui:GetDescendants()
    ) do

        if gui:IsA("BillboardGui")
            and gui.Name == "EnemyBillboard"
            and gui.Adornee
        then

            local title =
                gui:FindFirstChild("Title")

            local model =
                gui.Adornee
                    :FindFirstAncestorOfClass(
                        "Model"
                    )

            if title
                and title:IsA("TextLabel")
                and model
                and model:IsDescendantOf(
                    enemyFolder
                )
            then

                local hp, maxHp =
                    GetHealthFromBillboard(gui)

                table.insert(
                    results,
                    {
                        Name = title.Text,
                        Model = model,
                        Root = gui.Adornee,
                        Billboard = gui,
                        Health = hp,
                        MaxHealth = maxHp,
                    }
                )
            end
        end
    end

    return results
end

--------------------------------------------------
-- ENEMY TYPES
--------------------------------------------------

local function GetEnemyTypes()
    local seen = {}
    local list = {}

    for _, enemy in ipairs(
        GetEnemies()
    ) do

        if enemy.Name ~= ""
            and not seen[enemy.Name]
        then

            seen[enemy.Name] = true
            table.insert(
                list,
                enemy.Name
            )
        end
    end

    table.sort(list)

    return list
end

--------------------------------------------------
-- REFRESH LIST
-- KEEP CURRENT SELECTION
--------------------------------------------------

local function GetRefreshEnemyTypes()
    local list =
        GetEnemyTypes()

    if SelectedEnemy then
        local exists = false

        for _, name in ipairs(list) do
            if name == SelectedEnemy then
                exists = true
                break
            end
        end

        if not exists then
            table.insert(
                list,
                SelectedEnemy
            )

            table.sort(list)
        end
    end

    return list
end

--------------------------------------------------
-- TARGET ALIVE
--------------------------------------------------

local function IsTargetAlive(target)
    if not target then
        return false
    end

    if not target.Model
        or not target.Model.Parent
        or not target.Root
        or not target.Root.Parent
        or not target.Billboard
        or not target.Billboard.Parent
    then
        return false
    end

    local hp =
        GetHealthFromBillboard(
            target.Billboard
        )

    return hp ~= nil
        and hp > 0
end

--------------------------------------------------
-- CLOSEST ENEMY
--------------------------------------------------

local function GetClosestEnemy(enemyName)
    if not enemyName then
        return nil
    end

    local character =
        Player.Character

    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return nil
    end

    local closest = nil
    local closestDistance = math.huge

    for _, enemy in ipairs(
        GetEnemies()
    ) do

        if enemy.Name == enemyName
            and enemy.Health
            and enemy.Health > 0
            and enemy.Root
            and enemy.Root.Parent
        then

            local distance =
                (
                    root.Position
                    - enemy.Root.Position
                ).Magnitude

            if distance
                < closestDistance
            then
                closestDistance = distance
                closest = enemy
            end
        end
    end

    return closest
end

