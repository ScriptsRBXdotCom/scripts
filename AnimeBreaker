--------------------------------------------------
-- AUTO FARM
-- INSTANT TELEPORT
--------------------------------------------------

RunService.Heartbeat:Connect(
    function()

        if not AutoFarm then
            return
        end

        --------------------------------------------------
        -- KEEP REMEMBERING SELECTED MOB TYPE
        --------------------------------------------------

        if not SelectedEnemy then
            return
        end

        local character =
            Player.Character

        local root =
            character
            and character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root then
            return
        end

        --------------------------------------------------
        -- GET ANOTHER NPC ONLY IF CURRENT DIED/GONE
        --------------------------------------------------

        if not IsTargetAlive(
            CurrentTarget
        ) then

            CurrentTarget =
                GetClosestEnemy(
                    SelectedEnemy
                )

        end

        --------------------------------------------------
        -- WAIT FOR AN NPC OF THAT TYPE
        --------------------------------------------------

        if not CurrentTarget then
            return
        end

        if not CurrentTarget.Root
            or not CurrentTarget.Root.Parent
        then

            CurrentTarget =
                nil

            return
        end

        --------------------------------------------------
        -- INSTANT TELEPORT
        --------------------------------------------------

        root.CFrame =
            CurrentTarget.Root.CFrame
            * CFrame.new(
                0,
                0,
                4
            )

        --------------------------------------------------
        -- REMOVE MOVEMENT / FALLING JITTER
        --------------------------------------------------

        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero

    end
)

