--------------------------------------------------
-- NUMBER PARSER
--------------------------------------------------

local function ParseNumber(text)
    if not text then
        return nil
    end

    text = text:gsub(",", ""):gsub("%s+", "")

    local number, suffix =
        text:match("^([%d%.]+)([KMBT]?)$")

    number = tonumber(number)

    if not number then
        return nil
    end

    local multipliers = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12,
    }

    if suffix ~= "" then
        number = number * multipliers[suffix]
    end

    return number
end

--------------------------------------------------
-- HEALTH
--------------------------------------------------

local function GetHealthFromBillboard(billboard)
    if not billboard then
        return nil, nil
    end

    local bar =
        billboard:FindFirstChild("Bar")

    local amount =
        bar and bar:FindFirstChild("Amount")

    if not amount
        or not amount:IsA("TextLabel")
    then
        return nil, nil
    end

    local currentText, maxText =
        amount.Text:match(
            "^%s*(.-)%s*/%s*(.-)%s*$"
        )

    if not currentText
        or not maxText
    then
        return nil, nil
    end

    return
        ParseNumber(currentText),
        ParseNumber(maxText)
end

