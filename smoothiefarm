--========================================================
-- CHARACTER
--========================================================

local function getRoot()

	local character = LocalPlayer.Character

	if not character then
		return nil
	end

	return character:FindFirstChild(
		"HumanoidRootPart"
	)

end

--========================================================
-- AUTO DETECT PLAYER PLOT
--========================================================

local CurrentPlot = nil

local function findMyPlot()

	local plots = workspace:FindFirstChild(
		"Plots"
	)

	if not plots then
		CurrentPlot = nil
		return nil
	end

	for _, plot in ipairs(
		plots:GetChildren()
	) do

		local ownerId =
			plot:GetAttribute(
				"OwnerUserId"
			)

		if ownerId ==
			LocalPlayer.UserId then

			CurrentPlot = plot

			return plot
		end

	end

	CurrentPlot = nil

	return nil
end

local function getPlot()

	if CurrentPlot
		and CurrentPlot.Parent
		and CurrentPlot:GetAttribute(
			"OwnerUserId"
		) == LocalPlayer.UserId then

		return CurrentPlot
	end

	return findMyPlot()
end

findMyPlot()

-- Keep plot updated if player is
-- assigned a different one.
task.spawn(function()

	while task.wait(1) do
		findMyPlot()
	end

end)

--========================================================
-- BUTTON SYSTEM
--========================================================

local function getButton(buttonName)

	local plot = getPlot()

	if not plot then
		return nil
	end

	local buttons =
		plot:FindFirstChild(
			"Buttons"
		)

	if not buttons then
		return nil
	end

	local holder =
		buttons:FindFirstChild(
			buttonName
		)

	if not holder then
		return nil
	end

	local button =
		holder:FindFirstChild(
			"Button"
		)

	if button and button:IsA(
		"BasePart"
	) then

		return button
	end

	return nil
end

local function touchButton(
	buttonName
)

	local root = getRoot()

	local button =
		getButton(buttonName)

	if not root or not button then
		return
	end

	pcall(function()

		firetouchinterest(
			root,
			button,
			0
		)

		task.wait()

		firetouchinterest(
			root,
			button,
			1
		)

	end)

end

--========================================================
-- AUTO COLLECT FRUIT
--========================================================

local FruitDrops =
	workspace:WaitForChild(
		"FruitDrops"
	)

local CollectRequest =
	ReplicatedStorage
		:WaitForChild("Remotes")
		:WaitForChild(
			"CollectRequest"
		)

local collectingFruit = {}

local function collectFruit(fruit)

	if not Config.AutoCollectFruit then
		return
	end

	if not fruit then
		return
	end

	if not fruit:IsA("Model") then
		return
	end

	if fruit.Parent ~= FruitDrops then
		return
	end

	if collectingFruit[fruit] then
		return
	end

	if fruit:GetAttribute(
		"Collected"
	) then
		return
	end

	-- Only touch fruit belonging to us
	local owner =
		fruit:GetAttribute(
			"Owner"
		)

	if owner == nil then
		return
	end

	if owner ~= LocalPlayer.UserId then
		return
	end

	local root = getRoot()

	if not root then
		return
	end

	collectingFruit[fruit] = true

	task.spawn(function()

		if not fruit.Parent then
			collectingFruit[fruit] = nil
			return
		end

		-- Move the fruit locally beside player.
		-- This is the method you confirmed works.
		pcall(function()

			fruit:PivotTo(
				root.CFrame
				* CFrame.new(
					0,
					0,
					-1
				)
			)

		end)

		task.wait(0.02)

		if fruit.Parent
			and not fruit:GetAttribute(
				"Collected"
			) then

			pcall(function()

				CollectRequest:FireServer(
					fruit
				)

			end)

		end

		-- Very quick retry availability
		task.delay(
			0.05,
			function()

				collectingFruit[fruit] =
					nil

			end
		)

	end)

end

-- Existing fruits
task.spawn(function()

	while task.wait(
		Config.FruitDelay
	) do

		if Config.AutoCollectFruit then

			for _, fruit in ipairs(
				FruitDrops:GetChildren()
			) do

				if not collectingFruit[
					fruit
				] then

					task.spawn(
						collectFruit,
						fruit
					)

				end

			end

		end

	end

end)

-- New fruits
FruitDrops.ChildAdded:Connect(
	function(fruit)

		if not Config.AutoCollectFruit then
			return
		end

		-- Owner can replicate shortly
		-- after ChildAdded.
		task.delay(
			0.03,
			function()

				if fruit.Parent then
					collectFruit(
						fruit
					)
				end

			end
		)

	end
)

FruitDrops.ChildRemoved:Connect(
	function(fruit)

		collectingFruit[fruit] = nil

	end
)

