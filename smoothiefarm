--========================================================
-- FRUIT SLICE STATE
--========================================================

local SliceContainer = nil

local sliced = {}

local swipeId = 0

local MegaActive = false

--========================================================
-- MINIGAME START
--========================================================

StartMinigame.OnClientEvent:Connect(
	function(
		cameraCFrame,
		container,
		fieldOfView,
		showWindow,
		arena
	)

		SliceContainer = container

		table.clear(sliced)

		if Config.AutoStart
			and showWindow then

			task.delay(
				0.25,
				function()

					pcall(function()

						GameOverChoice
							:FireServer(
								"start"
							)

					end)

				end
			)

		end

	end
)

--========================================================
-- FIND ACTIVE SLICE CONTAINER
--========================================================

local function findSliceContainer()

	if SliceContainer
		and SliceContainer.Parent then

		return SliceContainer
	end

	-- Fallback if script was executed
	-- after round already started.
	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		if object:GetAttribute(
			"SliceObjectId"
		) ~= nil then

			SliceContainer =
				object.Parent

			return SliceContainer

		end

	end

	return nil
end

--========================================================
-- SLICE OBJECT
--========================================================

local function sliceFruitObject(
	object
)

	if not Config.AutoSlice then
		return
	end

	if not object
		or not object.Parent then

		return
	end

	local id =
		object:GetAttribute(
			"SliceObjectId"
		)

	if id == nil then
		return
	end

	if sliced[id] then
		return
	end

	local kind =
		object:GetAttribute(
			"SliceKind"
		)

	-- Avoid bombs
	if kind == "Bomb" then
		return
	end

	local success, position =
		pcall(function()

			return object:GetPivot()
				.Position

		end)

	if not success then
		return
	end

	sliced[id] = true

	swipeId += 1

	pcall(function()

		SliceObject:FireServer(
			id,
			position,
			swipeId
		)

	end)

	-- If server left it alive,
	-- allow retry.
	task.delay(
		0.2,
		function()

			if object
				and object.Parent
				and object:GetAttribute(
					"SliceObjectId"
				) == id then

				sliced[id] = nil

			end

		end
	)

end

--========================================================
-- AUTO SLICE LOOP
--========================================================

task.spawn(function()

	while task.wait(
		Config.SliceDelay
	) do

		if Config.AutoSlice then

			local container =
				findSliceContainer()

			if container then

				for _, object in ipairs(
					container:GetChildren()
				) do

					if object:GetAttribute(
						"SliceObjectId"
					) ~= nil
						and object:GetAttribute(
							"SliceKind"
						) ~= "Bomb" then

						task.spawn(
							sliceFruitObject,
							object
						)

					end

				end

			end

		end

	end

end)

--========================================================
-- MEGA FRUIT
--========================================================

local megaThreadRunning = false

local function startMegaSpam()

	if megaThreadRunning then
		return
	end

	megaThreadRunning = true

	task.spawn(function()

		while MegaActive
			and Config.AutoMega do

			pcall(function()

				MegaHit:FireServer()

			end)

			task.wait(0.04)

		end

		megaThreadRunning = false

	end)

end

MegaEvent.OnClientEvent:Connect(
	function(action, data)

		if action == "start" then

			MegaActive = true

			if Config.AutoMega then

				startMegaSpam()

			end

		elseif action == "end" then

			MegaActive = false

		end

	end
)

--========================================================
-- AUTO CLAIM
--========================================================

task.spawn(function()

	while task.wait(0.25) do

		if Config.AutoClaim then

			local PlayerGui =
				LocalPlayer:FindFirstChild(
					"PlayerGui"
				)

			local loss =
				PlayerGui
				and PlayerGui
					:FindFirstChild(
						"Window_MiniGameLoss"
					)

			if loss and loss.Enabled then

				pcall(function()

					GameOverChoice
						:FireServer(
							"claim"
						)

				end)

				task.wait(0.75)

			end

		end

	end

end)

