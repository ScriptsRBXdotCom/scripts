--========================================================
-- REMAINING OBJECTIVE PARTS
--========================================================

local function GetRemainingParts(
    Object
)
    local Parts = {}

    if not Object
        or not Object.Parent
    then
        return Parts
    end

    if Object:IsA(
        "BasePart"
    ) then
        table.insert(
            Parts,
            Object
        )
    end

    for _, Descendant in ipairs(
        Object:GetDescendants()
    ) do
        if Descendant:IsA(
            "BasePart"
        )
            and Descendant.Parent
            and Descendant.Transparency < 1
        then
            table.insert(
                Parts,
                Descendant
            )
        end
    end

    return Parts
end

local function GetNearestRemainingPart(
    Object,
    Origin
)
    local Best
    local BestDistance =
        math.huge

    for _, Part in ipairs(
        GetRemainingParts(
            Object
        )
    ) do
        local Distance =
            (
                Part.Position
                - Origin
            ).Magnitude

        if Distance <
            BestDistance
        then
            BestDistance =
                Distance

            Best =
                Part
        end
    end

    return Best,
        BestDistance
end

--========================================================
-- NEAREST CRUSHABLE
--========================================================

local function FindNearestCrushable()
    local Origin =
        GetOrigin()

    local Best
    local BestDistance =
        math.huge

    for _, Object in ipairs(
        Objectives:GetChildren()
    ) do
        if IsCrushable(
            Object
        ) then
            local Part,
                Distance =
                GetNearestRemainingPart(
                    Object,
                    Origin
                )

            if Part
                and Distance <
                    BestDistance
            then
                BestDistance =
                    Distance

                Best =
                    Object
            end
        end
    end

    return Best,
        BestDistance
end

--========================================================
-- QUEST TARGET
--========================================================

local function FindQuestTarget()
    local Quest =
        GetQuest()

    local Wanted =
        Normalize(
            QuestToObjective(
                Quest
            )
        )

    local Origin =
        GetOrigin()

    local Best
    local BestDistance =
        math.huge

    for _, Object in ipairs(
        Objectives:GetChildren()
    ) do
        if IsCrushable(Object)
            and Normalize(
                Object.Name
            ) == Wanted
        then
            local Part,
                Distance =
                GetNearestRemainingPart(
                    Object,
                    Origin
                )

            if Part
                and Distance <
                    BestDistance
            then
                BestDistance =
                    Distance

                Best =
                    Object
            end
        end
    end

    if Best then
        return Best,
            false,
            BestDistance
    end

    if Settings.NearestFallback then
        local Fallback,
            Distance =
            FindNearestCrushable()

        return Fallback,
            true,
            Distance
    end

    return nil,
        false,
        math.huge
end

--========================================================
-- COLLISION HIT
--========================================================

local function HitPart(
    Vehicle,
    Part
)
    if not Vehicle
        or not Vehicle.Parent
        or not Part
        or not Part.Parent
    then
        return false
    end

    local TargetPosition =
        Part.Position

    local VehiclePosition =
        Vehicle:GetPivot().Position

    local Direction =
        Vector3.new(
            TargetPosition.X
                - VehiclePosition.X,

            0,

            TargetPosition.Z
                - VehiclePosition.Z
        )

    if Direction.Magnitude
        < 0.1
    then
        Direction =
            Vector3.new(
                0,
                0,
                -1
            )
    else
        Direction =
            Direction.Unit
    end

    --====================================================
    -- APPROACH TARGET
    --====================================================

    local Approach =
        TargetPosition
        - Direction
        * Settings.ApproachDistance

    Approach +=
        Vector3.new(
            0,
            Settings.VerticalOffset,
            0
        )

    Vehicle:PivotTo(
        CFrame.lookAt(
            Approach,

            Vector3.new(
                TargetPosition.X,
                Approach.Y,
                TargetPosition.Z
            )
        )
    )

    task.wait(
        Settings.CleanupDelay
    )

    if not Part.Parent then
        return true
    end

    --====================================================
    -- IMPACT THROUGH TARGET
    --====================================================

    local Impact =
        TargetPosition
        + Direction
        * Settings.CollisionDepth

    Impact +=
        Vector3.new(
            0,
            Settings.VerticalOffset,
            0
        )

    Vehicle:PivotTo(
        CFrame.lookAt(
            Impact,
            Impact + Direction
        )
    )

    return true
end

--========================================================
-- DESTROY OBJECTIVE / CLEAN FRAGMENTS
--========================================================

local function DestroyObjective(
    Vehicle,
    Objective
)
    if not Vehicle
        or not Objective
    then
        return false
    end

    local StartPosition =
        GetPosition(
            Objective
        )

    Runtime.LastTarget =
        Objective

    Runtime.LastTargetPosition =
        StartPosition

    for Pass = 1,
        Settings.CleanupPasses
    do
        if not Settings.Enabled
            or Runtime.StorageResetting
        then
            break
        end

        --================================================
        -- IMMEDIATELY STOP IF STORAGE FILLS
        --================================================

        if Settings.AutoUnload
            and VehicleStorageFull()
        then
            break
        end

        if not Objective.Parent then
            return true
        end

        if not Vehicle.Parent then
            break
        end

        local Part,
            Distance =
            GetNearestRemainingPart(
                Objective,

                Vehicle
                    :GetPivot()
                    .Position
            )

        if not Part then
            return true
        end

        --================================================
        -- FRAGMENT DISTANCE CHECK
        --================================================

        if StartPosition then
            local FragmentDistance =
                (
                    Part.Position
                    - StartPosition
                ).Magnitude

            if FragmentDistance >
                Settings.CleanupRadius
            then
                print(
                    "[Cleanup] Fragment outside radius:",
                    math.floor(
                        FragmentDistance
                    )
                )

                break
            end
        end

        print(
            "[Cleanup]",
            Pass,
            "/",
            Settings.CleanupPasses,

            Part.Name,

            "distance:",
            math.floor(
                Distance
            )
        )

        HitPart(
            Vehicle,
            Part
        )

        task.wait(
            Settings.CleanupDelay
        )
    end

    return true
end

--========================================================
-- CHARACTER FALLBACK
--========================================================

local function CharacterTeleport(
    Objective
)
    local Root =
        GetRoot()

    if not Root then
        return false
    end

    local Part =
        GetNearestRemainingPart(
            Objective,
            Root.Position
        )

    if not Part then
        return false
    end

    local TargetPosition =
        Part.Position

    local Delta =
        TargetPosition
        - Root.Position

    local Direction =
        Vector3.new(
            Delta.X,
            0,
            Delta.Z
        )

    if Direction.Magnitude
        < 0.1
    then
        Direction =
            Vector3.new(
                0,
                0,
                -1
            )
    else
        Direction =
            Direction.Unit
    end

    local Destination =
        TargetPosition
        - Direction
        * Settings.CharacterDistance

    Destination +=
        Vector3.new(
            0,
            3,
            0
        )

    Root.CFrame =
        CFrame.lookAt(
            Destination,
            TargetPosition
        )

    return true
end

--========================================================
-- AUTO STORAGE RESET
--========================================================

local function DoVehicleStorageReset()
    if Runtime.StorageResetting then
        return
    end

    if not Settings.AutoUnload then
        return
    end

    Runtime.StorageResetting =
        true

    local Current,
        Maximum,
        Percent =
        GetVehicleStorage()

    print(
        "[Storage] FULL",
        Current,
        "/",
        Maximum,
        math.floor(
            Percent * 100
        ) .. "%"
    )

    Window:Notify({
        title = "Vehicle Storage Full",

        content =
            tostring(
                math.floor(
                    Current
                )
            )
            .. "/"
            .. tostring(
                math.floor(
                    Maximum
                )
            )
            .. " - resetting run"
    })

    --====================================================
    -- SAVE CURRENT FARM POSITION
    --====================================================

    local OldVehicle =
        FindVehicle()

    if OldVehicle then
        Runtime.ReturnCFrame =
            OldVehicle:GetPivot()
    else
        Runtime.ReturnCFrame =
            nil
    end

    --====================================================
    -- END RUN
    -- {1}
    --====================================================

    EndRun()

    WaitForDashboard(
        false,
        Settings.RunEndTimeout
    )

    task.wait(
        Settings.PlotReturnDelay
    )

    --====================================================
    -- START NEW RUN
    -- {0}
    --====================================================

    StartRun()

    task.wait(
        Settings.StartRunDelay
    )

    WaitForDashboard(
        true,
        Settings.VehicleSpawnTimeout
    )

    --====================================================
    -- FIND NEW VEHICLE
    --====================================================

    local Vehicle =
        WaitForVehicle(
            Settings.VehicleSpawnTimeout
        )

    if not Vehicle then
        warn(
            "[Storage] New vehicle not found"
        )

        Window:Notify({
            title = "Storage",
            content = "Vehicle spawn failed"
        })

        Runtime.StorageResetting =
            false

        return
    end

    task.wait(
        Settings.ReturnDelay
    )

    --====================================================
    -- RECHECK STORAGE
    --====================================================

    local NewCurrent,
        NewMaximum =
        GetVehicleStorage()

    print(
        "[Storage] New run:",
        NewCurrent,
        "/",
        NewMaximum
    )

    --====================================================
    -- GO DIRECTLY BACK TO CURRENT QUEST TARGET
    --====================================================

    local Target =
        FindQuestTarget()

    if Target then
        local Part =
            GetNearestRemainingPart(
                Target,

                Vehicle
                    :GetPivot()
                    .Position
            )

        if Part then
            print(
                "[Storage] Returning directly to:",
                Target.Name
            )

            HitPart(
                Vehicle,
                Part
            )

        elseif Runtime.ReturnCFrame then
            Vehicle:PivotTo(
                Runtime.ReturnCFrame
            )
        end

    elseif Runtime.ReturnCFrame then

        Vehicle:PivotTo(
            Runtime.ReturnCFrame
        )
    end

    Runtime.StorageResetting =
        false

    Window:Notify({
        title = "Storage",

        content =
            "Run reset - resumed farming"
    })
end

