--========================================================
-- VEHICLE SEARCH
--========================================================

local function FindVehicle()
    local Vehicles =
        workspace:FindFirstChild(
            "vehicles"
        )

    if not Vehicles then
        return nil
    end

    -- Try ownership attributes first
    for _, Vehicle in ipairs(
        Vehicles:GetChildren()
    ) do
        if Vehicle:IsA("Model") then
            local Owner =
                Vehicle:GetAttribute(
                    "ownerId"
                )
                or Vehicle:GetAttribute(
                    "ownerid"
                )
                or Vehicle:GetAttribute(
                    "owner"
                )
                or Vehicle:GetAttribute(
                    "playerId"
                )

            if Owner == Player.UserId
                or Owner == Player.Name
                or tostring(Owner)
                    == tostring(
                        Player.UserId
                    )
            then
                return Vehicle
            end
        end
    end

    -- Closest fallback
    local Root =
        GetRoot()

    if not Root then
        return nil
    end

    local Best
    local BestDistance =
        math.huge

    for _, Vehicle in ipairs(
        Vehicles:GetChildren()
    ) do
        if Vehicle:IsA("Model") then
            local Distance =
                (
                    Vehicle
                        :GetPivot()
                        .Position
                    - Root.Position
                ).Magnitude

            if Distance <
                BestDistance
            then
                BestDistance =
                    Distance

                Best =
                    Vehicle
            end
        end
    end

    return Best
end

local function WaitForVehicle(
    Timeout
)
    local Start =
        os.clock()

    while os.clock() - Start
        < (Timeout or 10)
    do
        local Vehicle =
            FindVehicle()

        if Vehicle
            and Vehicle.Parent
        then
            return Vehicle
        end

        task.wait(0.15)
    end

    return nil
end

--========================================================
-- DASHBOARD WAIT
--========================================================

local function WaitForDashboard(
    ShouldExist,
    Timeout
)
    local Start =
        os.clock()

    while os.clock() - Start
        < (Timeout or 5)
    do
        local Label =
            GetVehicleStorageLabel()

        if ShouldExist then
            if Label then
                return true
            end
        else
            if not Label then
                return true
            end
        end

        task.wait(0.1)
    end

    return false
end

