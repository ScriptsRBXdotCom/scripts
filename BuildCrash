                    )
            end
        )
end

--========================================================
-- MAIN FARM LOOP
--========================================================

task.spawn(function()

    while true do

        task.wait(
            Settings.FarmDelay
        )

        if not Settings.Enabled then
            continue
        end

        --================================================
        -- STORAGE HAS HIGHEST PRIORITY
        --================================================

        if Settings.AutoUnload
            and VehicleStorageFull()
        then

            DoVehicleStorageReset()

            continue
        end

        if Runtime.StorageResetting then
            continue
        end

        --================================================
        -- FIND CURRENT QUEST TARGET
        --================================================

        local Target,
            Fallback,
            Distance =
            FindQuestTarget()

        if not Target then

            warn(
                "[Farm] No target found"
            )

            TryClaims()

            continue
        end

        Runtime.LastTarget =
            Target

        Runtime.LastTargetPosition =
            GetPosition(
                Target
            )

        print(
            "[Farm]",

            Fallback
                and "NEAREST"
                or "QUEST",

            GetQuest(),

            "=>",

            Target.Name,

            "HP:",
            Target:GetAttribute(
                "totalObjectiveHealth"
            ),

            "Distance:",
            math.floor(
                Distance
            )
        )

        --================================================
        -- VEHICLE COLLISION
        --================================================

        local Vehicle =
            FindVehicle()

        if Settings.VehicleCollision
            and Vehicle
        then

            if Settings
                .CleanupFragments
            then

                DestroyObjective(
                    Vehicle,
                    Target
                )

            else

                local Part =
                    GetNearestRemainingPart(
                        Target,

                        Vehicle
                            :GetPivot()
                            .Position
                    )

                if Part then
                    HitPart(
                        Vehicle,
                        Part
                    )
                end
            end

        elseif Settings
            .CharacterFallback
        then

            CharacterTeleport(
                Target
