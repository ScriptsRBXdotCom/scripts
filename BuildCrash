            or not Vehicle
        then
            warn(
                "Missing target or vehicle"
            )

            return
        end

        local Part =
            GetNearestRemainingPart(
                Target,

                Vehicle
                    :GetPivot()
                    .Position
            )

        if Part then
            print(
                "[Debug] Hitting:",
                Part:GetFullName()
            )

            HitPart(
                Vehicle,
                Part
            )
        end
    end
})

DebugTab:CreateButton({
    name = "Print Remaining Fragments",

    callback = function()

        local Target =
            FindQuestTarget()

        if not Target then
            warn(
                "No target"
            )

            return
        end

        local Parts =
            GetRemainingParts(
                Target
            )

        print(
            "====== FRAGMENTS ======"
        )

        for Index,
            Part in ipairs(
                Parts
            )
        do
            local Distance =
                Runtime.LastTargetPosition
                and (
                    Part.Position
                    - Runtime.LastTargetPosition
                ).Magnitude
                or 0

            print(
                Index,
                Part:GetFullName(),

                "Position:",
                Part.Position,

                "Distance:",
                math.floor(
                    Distance
                )
            )
        end

        print(
            "TOTAL:",
            #Parts
        )
    end
})

