    end

    local Dashboard =
        Bottom:FindFirstChild(
            "vehicleDashboard"
        )

    if not Dashboard then
        return nil
    end

    local Frame =
        Dashboard:FindFirstChild(
            "frame"
        )

    if not Frame then
        return nil
    end

    return Frame:FindFirstChild(
        "amountText"
    )
end

local function ParseStorageText(Text)
    if not Text then
        return 0, 0
    end

    local Current,
        Maximum =
        tostring(Text):match(
            "([%d,%.]+)%s*/%s*([%d,%.]+)"
        )

    if not Current
        or not Maximum
    then
        return 0, 0
    end

    Current =
        Current:gsub(
            ",",
            ""
        )

    Maximum =
        Maximum:gsub(
            ",",
            ""
        )

    return tonumber(Current) or 0,
        tonumber(Maximum) or 0
end

local function GetVehicleStorage()
    local Label =
        GetVehicleStorageLabel()

    if not Label then
        return 0,
            0,
            0
    end

    local Current,
        Maximum =
        ParseStorageText(
            Label.Text
        )

    local Percent = 0

    if Maximum > 0 then
        Percent =
            Current / Maximum
    end

    Runtime.LastStorageCurrent =
        Current

    Runtime.LastStorageMax =
        Maximum

    return Current,
        Maximum,
        Percent
end

local function VehicleStorageFull()
    local Current,
        Maximum,
        Percent =
        GetVehicleStorage()

    if Maximum <= 0 then
        return false
    end

    return Percent >=
        Settings.UnloadAtPercent
end

