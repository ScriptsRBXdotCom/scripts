local Claiming = false

local function TryClaims()
    if not Settings.AutoClaim
        or Claiming
        or not QuestNet
    then
        return
    end

    Claiming =
        true

    task.spawn(function()
        local Success,
            Result =
            pcall(function()

                return QuestNet
                    .claimGettingStartedReward
                    .call()

            end)

        if Success
            and Result
        then
            print(
                "[Quest] Getting Started claimed"
            )
        end
    end)

    task.spawn(function()
        local Success,
            Result =
            pcall(function()

                return QuestNet
                    .claimConveyorReward
                    .call()

            end)

        if Success
            and Result
        then
            print(
                "[Quest] Conveyor claimed"
            )
        end
    end)

    task.delay(
        Settings.ClaimDelay,

        function()
            Claiming =
                false
        end
    )
end

