--========================================================
-- STRING HELPERS
--========================================================

local function Trim(Text)
    return tostring(Text)
        :gsub("^%s+", "")
        :gsub("%s+$", "")
end

local function Normalize(Text)
    return Trim(Text)
        :lower()
        :gsub("%s+", "")
        :gsub("_", "")
        :gsub("%-", "")
        :gsub("[^%w]", "")
end

local function GetQuest()
    return QuestLabel.Text
end

local function QuestToObjective(Text)
    local Lower =
        Trim(Text):lower()

    if QuestAliases[Lower] then
        return QuestAliases[Lower]
    end

    return Normalize(Lower)
end

