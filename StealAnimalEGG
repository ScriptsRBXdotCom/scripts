--========================================================
-- CHARACTER
--========================================================

local function getCharacter()
	return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
	local char = getCharacter()

	return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local char = getCharacter()

	return char:FindFirstChildOfClass("Humanoid")
end

local function applyMovement()
	local hum = getHumanoid()

	if not hum then
		return
	end

	hum.WalkSpeed = walkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = jumpPower
end

Player.CharacterAdded:Connect(function()
	task.wait(1)

	applyMovement()
end)

--========================================================
-- TELEPORT
--========================================================

local function teleportToCFrame(cf)
	local char = getCharacter()

	if not char then
		return false
	end

	char:PivotTo(cf)

	return true
end

--========================================================
-- PLAYER PLOT
--========================================================

local function getMyPlot()

	-- Try actual ownership first
	for _, object in ipairs(workspace:GetChildren()) do

		if object:IsA("Model")
			and object.Name:match("^Base %d+$") then

			local ownerId =
				object:GetAttribute("OwnerUserId")

			if ownerId == Player.UserId then
				return object
			end
		end
	end

	-- Fallback to Base 3
	return workspace:FindFirstChild("Base 3")
end

local function teleportToPlot()

	local plot = getMyPlot()

	if not plot then
		return false
	end

	local target =
		plot:FindFirstChild("BaseSpawn")
		or plot:FindFirstChild("SpawnPoint")
		or plot:FindFirstChild("PetYard")

	if not target then
		return false
	end

	if target:IsA("BasePart") then

		teleportToCFrame(
			target.CFrame
				+ Vector3.new(0, 3, 0)
		)

		return true
	end

	return false
end

--========================================================
-- EGG RARITY
--========================================================

local function getEggRarity(model)

	local success, result1, result2 =
		pcall(function()

			return AnimalIndexArt.tierOf(model)
		end)

	if not success then
		return nil
	end

	-- depending on what tierOf returns
	if typeof(result2) == "string" then
		return result2
	end

	if typeof(result1) == "string" then
		return result1
	end

	return nil
end

--========================================================
-- EGG SCANNER
--========================================================

local function getEggs()

	local eggs = {}

	for _, zone in ipairs(Zones:GetChildren()) do

		local eggBeds =
			zone:FindFirstChild("EggBeds")

		if eggBeds then

			for _, bed in ipairs(eggBeds:GetChildren()) do

				for _, object in ipairs(bed:GetChildren()) do

					if object:IsA("Model") then

						local prompt =
							object:FindFirstChild(
								"EggPrompt",
								true
							)

						if prompt
							and prompt:IsA(
								"ProximityPrompt"
							) then

							table.insert(
								eggs,
								{
									Model = object,
									Prompt = prompt,
									Rarity =
										getEggRarity(
											object
										),
									Bed = bed,
									Zone = zone
								}
							)
						end
					end
				end
			end
		end
	end

	return eggs
end

--========================================================
-- NEAREST EGG
--========================================================

local function getNearestEgg()

	local hrp = getRoot()

	if not hrp then
		return nil
	end

	local closest = nil
	local closestDistance = math.huge

	for _, egg in ipairs(getEggs()) do

		local correctRarity =
			selectedRarity == "Any"
			or egg.Rarity == selectedRarity

		if correctRarity
			and egg.Model
			and egg.Model.Parent then

			local success, pivot =
				pcall(function()

					return egg.Model:GetPivot()
				end)

			if success then

				local distance =
					(
						hrp.Position
						- pivot.Position
					).Magnitude

				if distance < closestDistance then

					closestDistance = distance
					closest = egg
				end
			end
		end
	end

	return closest
end

--========================================================
-- PROMPT POSITION
--========================================================

local function getPromptPosition(prompt)

	if not prompt
		or not prompt.Parent then

		return nil
	end

	local parent = prompt.Parent

	if parent:IsA("Attachment") then
		return parent.WorldPosition
	end

	if parent:IsA("BasePart") then
		return parent.Position
	end

	local part =
		prompt:FindFirstAncestorWhichIsA(
			"BasePart"
		)

	if part then
		return part.Position
	end

	return nil
end

--========================================================
-- TELEPORT BESIDE PROMPT
--========================================================

local function teleportToPrompt(prompt)

	local position =
		getPromptPosition(prompt)

	if not position then
		return false
	end

	local char = getCharacter()

	if not char then
		return false
	end

	-- Stand directly beside the egg
	local targetPosition =
		position
		+ Vector3.new(0, 1.5, 2.5)

	char:PivotTo(
		CFrame.lookAt(
			targetPosition,
			position
		)
	)

	return true
end

--========================================================
-- TRIGGER PROMPT
--========================================================

local function triggerPrompt(prompt)

	if not prompt
		or not prompt.Parent then

		return false
	end

	-- Save original properties
	local oldDistance =
		prompt.MaxActivationDistance

	local oldLOS =
		prompt.RequiresLineOfSight

	local oldEnabled =
		prompt.Enabled

	-- Temporarily make interaction easier
	prompt.Enabled = true

	prompt.RequiresLineOfSight = false

	prompt.MaxActivationDistance =
		math.max(
			oldDistance,
			20
		)

	task.wait(0.1)

	local triggered = false

	--====================================================
	-- Method 1:
	-- Normal Roblox ProximityPrompt input
	--====================================================

	local success =
		pcall(function()

			prompt:InputHoldBegin()

			task.wait(
				math.max(
					prompt.HoldDuration,
					0.05
				)
				+ 0.05
			)

			prompt:InputHoldEnd()
		end)

	if success then
		triggered = true
	end

	--====================================================
	-- Method 2:
	-- Executor fallback
	--====================================================

	if fireproximityprompt then

		task.wait(0.05)

		pcall(function()

			fireproximityprompt(
				prompt,
				prompt.HoldDuration
			)
		end)

		triggered = true
	end

	-- Restore original prompt settings later
	task.delay(
		0.5,
		function()

			if prompt
				and prompt.Parent then

				prompt.MaxActivationDistance =
					oldDistance

				prompt.RequiresLineOfSight =
					oldLOS

				prompt.Enabled =
					oldEnabled
			end
		end
	)

	return triggered
end

--========================================================
-- TELEPORT TO EGG
--========================================================

local function teleportToEgg()

	local egg = getNearestEgg()

	if not egg then
		return false
	end

	-- Use actual prompt position first
	if teleportToPrompt(egg.Prompt) then
		return true, egg
	end

	-- fallback
	local success, pivot =
		pcall(function()

			return egg.Model:GetPivot()
		end)

	if not success then
		return false
	end

	teleportToCFrame(
		pivot
			+ Vector3.new(0, 3, 0)
	)

	return true, egg
end

