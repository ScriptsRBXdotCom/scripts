--========================================================
-- AUTO FARM LOOP
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		if not autoFarm then

			task.wait(0.15)
			continue
		end

		local egg =
			getNearestEgg()

		if not egg then

			setStatus(
				"No "
					.. selectedRarity
					.. " eggs"
			)

			task.wait(0.5)

			continue
		end

		local prompt =
			egg.Prompt

		local eggModel =
			egg.Model

		-- Egg disappeared already
		if not eggModel
			or not eggModel.Parent then

			task.wait(0.1)

			continue
		end

		if not prompt
			or not prompt.Parent then

			task.wait(0.1)

			continue
		end

		--================================================
		-- TP DIRECTLY BESIDE PROMPT
		--================================================

		local teleported =
			teleportToPrompt(
				prompt
			)

		if not teleported then

			setStatus(
				"Couldn't locate prompt"
			)

			task.wait(0.3)

			continue
		end

		-- Let position replicate
		task.wait(0.25)

		--================================================
		-- ACTIVATE PROMPT
		--================================================

		setStatus(
			"Stealing "
				.. tostring(
					egg.Rarity
					or "Egg"
				)
		)

		triggerPrompt(
			prompt
		)

		--================================================
		-- WAIT BEFORE NEXT EGG
		--
		-- Stops rapid TP spam.
		-- If egg gets removed, loop can continue sooner.
		--================================================

		local startTime =
			os.clock()

		repeat

			task.wait(0.1)

			if not autoFarm then
				break
			end

			if not eggModel.Parent then
				break
			end

			if not prompt.Parent then
				break
			end

		until
			os.clock()
				- startTime
				>= 1.25

		task.wait(0.15)
	end
end)

