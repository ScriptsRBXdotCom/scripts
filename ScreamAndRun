		data.Highlight.Enabled =
			Config.ESP.MonsterHighlight


		data.Gui.Enabled =
			Config.ESP.MonsterDistance


		data.Box.Visible =
			Config.ESP.MonsterBox


		if
			Config.ESP.MonsterDistance
			and root
		then

			local monsterPart =
				GetMonsterPart(
					monster
				)


			if monsterPart then

				local distance =
					(
						root.Position
						- monsterPart.Position
					).Magnitude


				data.Label.Text =
					string.format(
						"%s [%.0f studs]",
						monster.Name,
						distance
					)
			end
		end
	end
end


