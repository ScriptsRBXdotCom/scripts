				and prompt:IsA(
					"ProximityPrompt"
				)
			then

				table.insert(
					result,
					{
						Model =
							backpack,

						Handle =
							handle,

						Prompt =
							prompt,
					}
				)
			end
		end
	end

	return result
end


--========================================================
-- LOCK TARGETS
--========================================================

local LockNames = {
	"GreenLock",
	"RedLock",
	"WhiteLock",
}


local function GetLockMainPart(
	container
)

	if not container then
		return nil
	end

	local directLock =
		container:FindFirstChild(
			"Lock"
		)

	if
		directLock
		and directLock:IsA(
			"BasePart"
		)
	then

		return directLock
	end

	if container:IsA("BasePart") then

		return container
	end

	return container:
		FindFirstChildWhichIsA(
			"BasePart",
			true
		)
end


local function GetLocks()

	local result = {}

	for _, name in ipairs(
		LockNames
	) do

		local container =
			Workspace:FindFirstChild(
				name
			)

		if container then

			local part =
				GetLockMainPart(
					container
				)

			if part then

				table.insert(
					result,
					{
						Name =
							name,

						Container =
							container,

						Part =
							part,
					}
				)
			end
		end
	end

	return result
end


--========================================================
-- LOCK TELEPORT POSITION
--========================================================

local function GetLockTeleportCFrame(
	lockInfo
)

	if
		not lockInfo
		or not lockInfo.Part
	then

		return nil
	end

	local part =
		lockInfo.Part

	local character =
		GetCharacter()

	local rayParams =
		RaycastParams.new()

	rayParams.FilterType =
		Enum.RaycastFilterType.Exclude

	local exclude = {}

	if character then

		table.insert(
			exclude,
			character
		)
	end

	if lockInfo.Container then

		table.insert(
			exclude,
			lockInfo.Container
		)
	end

	rayParams.FilterDescendantsInstances =
		exclude


	local bestPosition =
		nil

	local bestScore =
		-math.huge


	for i = 1, 16 do

		local angle =
			(
				(i - 1)
				/ 16
			)
			* math.pi
			* 2


		local candidate =
			part.Position
			+ Vector3.new(
				math.cos(angle) * 4,
				0,
				math.sin(angle) * 4
			)


		local result =
			Workspace:Raycast(

				candidate
				+ Vector3.new(
					0,
					7,
					0
				),

				Vector3.new(
					0,
					-18,
					0
				),

				rayParams
			)


		if
			result
			and result.Instance
			and result.Normal.Y > 0.55
		then

			if
				not result.Instance:IsA(
					"BasePart"
				)
				or result.Instance.CanCollide
			then

				local position =
					result.Position
					+ Vector3.new(
						0,
						3,
						0
					)

				local monsterDistance =
					DistanceFromClosestMonster(
						position
					)

				if
					monsterDistance
					> bestScore
				then

					bestScore =
						monsterDistance

					bestPosition =
						position
				end
			end
		end
	end


	if not bestPosition then

		bestPosition =
			part.Position
			+ Vector3.new(
				0,
				2.5,
				4
			)
	end


	return FaceTarget(
		bestPosition,
		part.Position
	)
end


