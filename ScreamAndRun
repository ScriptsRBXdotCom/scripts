local function FindNearestLock()

	local root =
		GetRoot()

	if not root then
		return nil
	end

	local best =
		nil

	local bestDistance =
		math.huge

	for _, lockInfo in ipairs(
		GetLocks()
	) do

		local distance =
			(
				root.Position
				- lockInfo.Part.Position
			).Magnitude

		if distance < bestDistance then

			bestDistance =
				distance

			best =
				lockInfo
		end
	end

	return best
end


local function FindSafestLock()

	local best =
		nil

	local bestDistance =
		-math.huge

	for _, lockInfo in ipairs(
		GetLocks()
	) do

		local distance =
			DistanceFromClosestMonster(
				lockInfo.Part.Position
			)

		if distance > bestDistance then

			bestDistance =
				distance

			best =
				lockInfo
		end
	end

	return best
end


local function TeleportToLock(
	lockInfo
)

	if not lockInfo then
		return false
	end

	local cframe =
		GetLockTeleportCFrame(
			lockInfo
		)

	if not cframe then
		return false
	end

	return TeleportCharacter(
