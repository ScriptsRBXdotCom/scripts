--========================================================
-- CHARACTER HELPERS
--========================================================

local function GetCharacter()

	return Player.Character
end


local function GetRoot()

	local character =
		GetCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild(
		"HumanoidRootPart"
	)
end


local function GetHumanoid()

	local character =
		GetCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass(
		"Humanoid"
	)
end


local function StopVelocity()

	local root =
		GetRoot()

	if not root then
		return
	end

	root.AssemblyLinearVelocity =
		Vector3.zero

	root.AssemblyAngularVelocity =
		Vector3.zero
end


local function TeleportCharacter(
	targetCFrame
)

	local character =
		GetCharacter()

	if not character then
		return false
	end

	StopVelocity()

	character:PivotTo(
		targetCFrame
	)

	StopVelocity()

	return true
end


--========================================================
-- MONSTER HELPERS
--========================================================

local function IsMonsterName(
	name
)

	for _, wanted in ipairs(
		Config.MonsterNames
	) do

		if name == wanted then
			return true
		end
	end

	return false
end


local function GetMonsterPart(
	monster
)

	if not monster then
		return nil
	end

	return monster:FindFirstChild(
		"HumanoidRootPart"
	)
		or monster.PrimaryPart
		or monster:FindFirstChildWhichIsA(
			"BasePart",
			true
		)
end


local function GetMonsters()

	local result = {}

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if
			object:IsA("Model")
			and IsMonsterName(
				object.Name
			)
		then

			table.insert(
				result,
				object
			)
		end
	end

	return result
end


local function DistanceFromClosestMonster(
	position
)

	local closest =
		math.huge

	local found =
		false

	for _, monster in ipairs(
		GetMonsters()
	) do

		local part =
			GetMonsterPart(
				monster
			)

		if part then

			found =
				true

			local distance =
				(
					position
					- part.Position
				).Magnitude

			if distance < closest then

				closest =
					distance
			end
		end
	end

	if not found then
		return math.huge
	end

	return closest
end


local function GetNearestMonster()

	local root =
		GetRoot()

	if not root then

		return nil,
			math.huge
	end

	local nearest =
		nil

	local bestDistance =
		math.huge

	for _, monster in ipairs(
		GetMonsters()
	) do

		local part =
			GetMonsterPart(
				monster
			)

		if part then

			local distance =
				(
					root.Position
					- part.Position
				).Magnitude

			if distance < bestDistance then

				bestDistance =
					distance

				nearest =
					monster
			end
		end
	end

	return nearest,
		bestDistance
end


--========================================================
-- FACE TARGET
--========================================================

local function FaceTarget(
	position,
	targetPosition
)

	local target =
		Vector3.new(
			targetPosition.X,
			position.Y,
			targetPosition.Z
		)

	if
		(
			target
			- position
		).Magnitude < 0.1
	then

		target =
			position
			+ Vector3.new(
				0,
				0,
				-1
			)
	end

	return CFrame.lookAt(
		position,
		target
	)
end


--========================================================
-- FIND SAFEST POSITION AROUND PART
--========================================================

local function FindSafestCirclePosition(
	part,
	radius,
	height,
	samples
)

	if not part or not part.Parent then

		return nil,
			-math.huge
	end

	local bestPosition =
		nil

	local bestMonsterDistance =
		-math.huge

	samples =
		samples or 12

	for i = 1, samples do

		local angle =
			(
				(i - 1)
				/ samples
			)
			* math.pi
			* 2

		local position =
			part.Position
			+ Vector3.new(
				math.cos(angle) * radius,
				height,
				math.sin(angle) * radius
			)

		local monsterDistance =
			DistanceFromClosestMonster(
				position
			)

		if
			monsterDistance
			> bestMonsterDistance
		then

			bestMonsterDistance =
				monsterDistance

			bestPosition =
				position
		end
	end

	return bestPosition,
		bestMonsterDistance
end


