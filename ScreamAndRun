-- PLAYER MODS
--========================================================

local OriginalHumanoid =
	setmetatable(
		{},
		{
			__mode = "k"
		}
	)


local function SaveHumanoid(
	humanoid
)

	if
		OriginalHumanoid[
			humanoid
		]
	then

		return
	end


	OriginalHumanoid[
		humanoid
	] = {

		WalkSpeed =
			humanoid.WalkSpeed,

		JumpHeight =
			humanoid.JumpHeight,

		UseJumpPower =
			humanoid.UseJumpPower,
	}
end


local function ApplyPlayerMods()

	local humanoid =
		GetHumanoid()


	if not humanoid then
		return
	end


	SaveHumanoid(
		humanoid
	)


	if
		Config.Player.WalkSpeedEnabled
	then

		humanoid.WalkSpeed =
			Config.Player.WalkSpeed
	end


	if Config.Player.JumpEnabled then

		humanoid.UseJumpPower =
			false


		humanoid.JumpHeight =
			Config.Player.JumpHeight
	end
end


local function RestoreWalkSpeed()

	local humanoid =
		GetHumanoid()


	if not humanoid then
		return
	end


	local state =
		OriginalHumanoid[
			humanoid
		]


	if state then

		humanoid.WalkSpeed =
			state.WalkSpeed
	end
end


local function RestoreJump()

	local humanoid =
		GetHumanoid()


	if not humanoid then
		return
	end


	local state =
		OriginalHumanoid[
			humanoid
		]


	if state then

		humanoid.UseJumpPower =
			state.UseJumpPower


		humanoid.JumpHeight =
			state.JumpHeight
	end
end


