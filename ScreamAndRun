	)
end


--========================================================
-- INSTA WIN
--========================================================

local function GetExitTouchPart()

	local exit =
		Workspace:FindFirstChild(
			"Exit"
		)

	if not exit then
		return nil
	end

	----------------------------------------------------
	-- workspace.Exit itself might be the touching part
	----------------------------------------------------

	if exit:IsA("BasePart") then

		return exit
	end


	----------------------------------------------------
	-- Prefer a BasePart that actually contains
	-- TouchInterest.
	----------------------------------------------------

	for _, object in ipairs(
		exit:GetDescendants()
	) do

		if
			object:IsA("BasePart")
			and object:FindFirstChildWhichIsA(
				"TouchTransmitter"
			)
		then

			return object
		end
	end


	----------------------------------------------------
	-- Some executors / explorers display TouchInterest
	-- slightly differently, so also check by name.
	----------------------------------------------------

	for _, object in ipairs(
		exit:GetDescendants()
	) do

		if object:IsA("BasePart") then

			local touch =
				object:FindFirstChild(
					"TouchInterest"
				)

			if touch then
				return object
			end
		end
	end


	----------------------------------------------------
	-- Final fallback = any BasePart inside Exit.
	----------------------------------------------------

	return exit:
		FindFirstChildWhichIsA(
			"BasePart",
			true
		)
end


local function InstaWin()

	local root =
		GetRoot()

	local character =
		GetCharacter()

	local exitPart =
		GetExitTouchPart()


	if
		not root
		or not character
	then

		return
	end


	if not exitPart then

		Rayfield:Notify({

			Title =
				"Insta Win",

			Content =
				"workspace.Exit was not found.",

			Duration =
				3,
		})

		return
	end


	----------------------------------------------------
	-- Save where we were standing.
	----------------------------------------------------

	local oldCFrame =
		root.CFrame


	----------------------------------------------------
	-- Stop movement first.
	----------------------------------------------------

	StopVelocity()


	----------------------------------------------------
	-- If firetouchinterest exists, explicitly fire
	-- touch begin/end several times.
	----------------------------------------------------

	if
		type(firetouchinterest)
		== "function"
	then

		for _ = 1, 5 do

			pcall(
				firetouchinterest,
				root,
				exitPart,
				0
			)


			task.wait(0.03)


			pcall(
				firetouchinterest,
				root,
				exitPart,
				1
			)


			task.wait(0.03)
		end
	end


	----------------------------------------------------
	-- PHYSICAL FALLBACK:
	--
	-- Move through the Exit rather than landing at one
	-- position for a single frame.
	----------------------------------------------------

	local exitCF =
		exitPart.CFrame


	local positions = {

		exitCF
			* CFrame.new(
				0,
				2,
				5
			),

		exitCF
			* CFrame.new(
				0,
				2,
				1
			),

		exitCF
			* CFrame.new(
				0,
				2,
				0
			),

		exitCF
			* CFrame.new(
				0,
				2,
				-1
			),

		exitCF
			* CFrame.new(
				0,
				2,
				-5
			),
	}


	for pass = 1, 3 do

		for _, cframe in ipairs(
			positions
		) do

			if not character.Parent then
				return
			end


			StopVelocity()


			character:PivotTo(
				cframe
			)


			StopVelocity()


			------------------------------------------------
			-- Give Touched a real physics frame.
			------------------------------------------------

			RunService.Heartbeat:Wait()

			RunService.Heartbeat:Wait()
		end
	end


	----------------------------------------------------
	-- Stay inside the exit briefly so server-side touch
	-- logic has time to register.
	----------------------------------------------------

	character:PivotTo(
		exitPart.CFrame
	)


	StopVelocity()


	task.wait(0.35)


	----------------------------------------------------
	-- If the win script didn't move/kill/end us,
	-- return to where we came from after a short wait.
	----------------------------------------------------

	if
		character.Parent
		and root.Parent
	then

		local distanceFromExit =
			(
				root.Position
				- exitPart.Position
			).Magnitude


		if distanceFromExit < 20 then

			character:PivotTo(
				oldCFrame
			)


			StopVelocity()
		end
	end
end


--========================================================
-- INSTANT PROXIMITY PROMPTS
--========================================================

local OriginalPromptTimes = {}

local PromptConnection =
	nil


local function MakePromptInstant(
	prompt
)

	if
		not prompt:IsA(
			"ProximityPrompt"
		)
	then

		return
	end

	if
		OriginalPromptTimes[
			prompt
		] == nil
	then

		OriginalPromptTimes[
			prompt
		] =
			prompt.HoldDuration
	end

	prompt.HoldDuration =
		0
end


local function SetInstantPrompts(
	enabled
)

	Config.Auto.InstantPrompts =
		enabled

	if enabled then

		for _, object in ipairs(
			Workspace:GetDescendants()
		) do

			if object:IsA(
				"ProximityPrompt"
			) then

				MakePromptInstant(
					object
				)
			end
		end


		if PromptConnection then

			PromptConnection:
				Disconnect()
		end


		PromptConnection =
			Workspace.DescendantAdded:
				Connect(

					function(object)

						if
							Config.Auto.InstantPrompts
							and object:IsA(
								"ProximityPrompt"
							)
						then

							task.defer(
								function()

									if object.Parent then

										MakePromptInstant(
											object
										)
									end
								end
							)
						end
					end
				)

	else

		if PromptConnection then

			PromptConnection:
				Disconnect()

			PromptConnection =
				nil
		end


		for prompt,
			oldTime in pairs(
				OriginalPromptTimes
			)
		do

			if prompt.Parent then

				prompt.HoldDuration =
					oldTime
			end
		end


		table.clear(
			OriginalPromptTimes
		)
	end
end


--========================================================
-- TRIGGER PROMPT
--========================================================

local function TriggerPrompt(
	prompt
)

	if
		not prompt
		or not prompt.Parent
		or not prompt.Enabled
	then

		return false
	end


	if
		type(fireproximityprompt)
		== "function"
	then

		local success =
			pcall(
				fireproximityprompt,
				prompt
			)

		if success then
			return true
		end
	end


	local success =
		pcall(function()

			prompt:InputHoldBegin()


			if Config.Auto.InstantPrompts then

				task.wait(
					Config.Search.PressTime
				)

			else

				task.wait(

					math.max(

						prompt.HoldDuration,

						Config.Search.PressTime
					)
				)
			end


			prompt:InputHoldEnd()

		end)


	return success
end


--========================================================
-- TELEPORT TO BACKPACK
--========================================================

local function TeleportToBackpack(
	info
)

	if
		not info
		or not info.Handle
		or not info.Handle.Parent
	then

		return false,
			0
	end


	local position,
		monsterDistance =
		FindSafestCirclePosition(

			info.Handle,

			Config.Search.Radius,

			Config.Search.Height,

			12
		)


	if not position then

		return false,
			0
	end


	if
		monsterDistance
		< Config.Search.MinimumCatDistance
	then

		return false,
			monsterDistance
	end


	return TeleportCharacter(

		FaceTarget(
			position,
			info.Handle.Position
		)

	), monsterDistance
end


--========================================================
-- SEARCH ONE BACKPACK
--========================================================

local function SearchBackpack(
	info
)

	if
		not info
		or not info.Handle.Parent
		or not info.Prompt.Parent
	then

		return true
	end


	local moved,
		monsterDistance =
		TeleportToBackpack(
			info
		)


	if not moved then

		return false,
			monsterDistance
	end


	task.wait(
		Config.Search.TeleportDelay
	)


	local root =
		GetRoot()


	if root then

		local newDistance =
			DistanceFromClosestMonster(
				root.Position
			)


		if
			newDistance
			< Config.Search.MinimumCatDistance
		then

			return false,
				newDistance
		end
	end


	StopVelocity()


	for _ = 1,
		Config.Search.Attempts
	do

		if
			not Config.Auto.SearchBackpacks
		then

			return false,
				0
		end


		if
			not info.Prompt.Parent
			or not info.Handle.Parent
		then

			return true,
				math.huge
		end


		TriggerPrompt(
			info.Prompt
		)


		task.wait(
			Config.Search.AfterPrompt
		)


		if
			not info.Prompt.Parent
			or not info.Prompt.Enabled
		then

			return true,
				math.huge
		end
	end


	return true,
		math.huge
end


--========================================================
-- SAVE SAFE LOCATION
--========================================================

local function UpdateSafeLocation()

	if Searching or SafetyBusy then
		return
	end


	local root =
		GetRoot()

	if not root then
		return
	end


	local now =
		os.clock()


	if
		now - LastSafeSave
		< Config.Safety.SaveInterval
	then

		return
	end


	LastSafeSave =
		now


	local monsterDistance =
		DistanceFromClosestMonster(
			root.Position
		)


	if
		monsterDistance
		>= Config.Safety.RecordDistance
	then

		LastSafeCFrame =
			root.CFrame
	end
end


--========================================================
-- RETURN AFTER SEARCH
--========================================================

local function ReturnAfterSearch()

	local root =
		GetRoot()

	if not root then
		return
	end


	if SearchStartCFrame then

		local distance =
			DistanceFromClosestMonster(
				SearchStartCFrame.Position
			)


		if distance >= 35 then

			TeleportCharacter(
				SearchStartCFrame
			)

			return
		end
	end


	if LastSafeCFrame then

		local distance =
			DistanceFromClosestMonster(
				LastSafeCFrame.Position
			)


		if distance >= 35 then

			TeleportCharacter(
				LastSafeCFrame
			)

			return
		end
	end


	if
		DistanceFromClosestMonster(
			root.Position
		) >= 35
	then

		return
	end


	local safestLock =
		FindSafestLock()


	if safestLock then

		TeleportToLock(
			safestLock
		)
	end
end


--========================================================
-- AUTO SEARCH ALL BACKPACKS
--========================================================

local function AutoSearchBackpacks()

	if Searching then
		return
	end


	local root =
		GetRoot()

	if not root then
		return
	end


	Searching =
		true


	SearchStartCFrame =
		root.CFrame


	local waiting =
		GetBackpacks()


	local total =
		#waiting


	local searched =
		0


	local dangerRounds =
		0


	while
		Config.Auto.SearchBackpacks
		and #waiting > 0
	do

		local madeProgress =
			false


		local nextRound = {}


		for _, info in ipairs(
			waiting
		) do

			if
				not Config.Auto.SearchBackpacks
			then

				break
			end


			local success,
				monsterDistance =
				SearchBackpack(
					info
				)


			if success then

				searched =
					searched + 1


				madeProgress =
					true

			else

				table.insert(
					nextRound,
					info
				)


				if
					monsterDistance
					< Config.Search.MinimumCatDistance
				then

					task.wait(
						0.03
					)
				end
			end


			task.wait(
				Config.Search.BetweenBackpacks
			)
		end


		waiting =
			nextRound


		if #waiting == 0 then
			break
		end


		dangerRounds =
			dangerRounds + 1


		if
			dangerRounds
			>= Config.Search.MaxDangerRounds
		then

			break
		end


		if not madeProgress then

			task.wait(
				Config.Search.DangerRetryDelay
			)

		else

			task.wait(
				0.08
			)
		end
	end


	Config.Auto.SearchBackpacks =
		false


	Searching =
		false


	ReturnAfterSearch()


	pcall(function()

		Rayfield:Notify({

			Title =
				"Auto Search",

			Content =
				string.format(
					"Finished %d/%d backpacks.",
					searched,
					total
				),

			Duration =
				4,
		})

	end)
end


--========================================================
-- AUTO SAFETY
--========================================================

local function AutoSafetyUpdate()

	UpdateSafeLocation()


	if
		not Config.Auto.AutoSafety
	then

		return
	end


	if Searching or SafetyBusy then
		return
	end


	local monster,
		distance =
		GetNearestMonster()


	if not monster then
		return
	end


	if
		distance
		> Config.Safety.DangerDistance
	then

		return
	end


	if
		os.clock()
		- LastSafetyTeleport
		< Config.Safety.Cooldown
	then

		return
	end


	SafetyBusy =
		true


	LastSafetyTeleport =
		os.clock()


	if LastSafeCFrame then

		local currentSafety =
			DistanceFromClosestMonster(
				LastSafeCFrame.Position
			)


		if
			currentSafety
			>= Config.Safety.DangerDistance
		then

			TeleportCharacter(
				LastSafeCFrame
			)


			task.wait(
				0.05
			)


			SafetyBusy =
				false


			return
		end
	end


	local lock =
		FindSafestLock()


	if lock then

		TeleportToLock(
			lock
		)


		task.wait(
			0.05
		)


		local _,
			afterDistance =
			GetNearestMonster()


		if
			afterDistance
			> Config.Safety.DangerDistance
		then

			SafetyBusy =
				false


			return
		end
	end


	local bestBackpack =
		nil

	local bestDistance =
		-math.huge


	for _, info in ipairs(
		GetBackpacks()
	) do

		local position,
			distance =
			FindSafestCirclePosition(

				info.Handle,

				Config.Search.Radius,

				Config.Search.Height,

				12
			)


		if
			position
			and distance > bestDistance
		then

			bestDistance =
				distance

			bestBackpack =
				{
					Info =
						info,

					Position =
						position,
				}
		end
	end


	if
		bestBackpack
		and bestDistance
			> Config.Safety.DangerDistance
	then

		TeleportCharacter(

			FaceTarget(

				bestBackpack.Position,

				bestBackpack.Info.Handle.Position
			)
		)
	end


	SafetyBusy =
		false
end


