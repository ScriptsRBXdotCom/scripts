-- farm

local selectedNPC =
    "Nearest Active NPC"

local autoFarm = false
local autoMelee = true

local farmHeight = 3
local maxTargetDistance = 5000
local hitDistance = 8

local meleeInterval = 0.05
local meleeHoldTime = 0.015

local currentFarmTarget = nil

local respawning = false
local farmGeneration = 0

local function npcMatchesSelection(npc)
    if not targetIsValid(npc) then
        return false
    end

    if selectedNPC
        == "Nearest Active NPC"
    then
        return true
    end

    return cleanNPCName(npc.Name)
        == cleanNPCName(
            selectedNPC
        )
end

local function acquireFarmTarget()
    if not characterAlive() then
        return nil, math.huge
    end

    local root =
        getRoot()

    if not root then
        return nil, math.huge
    end

    local bestNPC = nil
    local bestDistance =
        math.huge

    -- IMPORTANT:
    -- fresh scan every time.
    -- same hierarchy ESP scans.

    for _, npc in ipairs(
        getAllLiveNPCs()
    ) do
        if npcMatchesSelection(npc) then
            local distance =
                (
                    root.Position
                    - npc.Root.Position
                ).Magnitude

            if distance
                < bestDistance
            then
                bestNPC = npc
                bestDistance =
                    distance
            end
        end
    end

    return bestNPC, bestDistance
end

local function positionAtNPC(npc)
    if not targetIsValid(npc)
        or not characterAlive()
    then
        return false
    end

    local root =
        getRoot()

    if not root then
        return false
    end

    local npcPosition =
        npc.Root.Position

    local targetPosition =
        npcPosition
        + Vector3.new(
            0,
            farmHeight,
            0
        )

    root.CFrame =
        CFrame.new(
            targetPosition
        )

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

