local meleeHoldTime = 0.015

local farmLoadedRegion = nil
local currentFarmTarget = nil

local respawning = false
local farmGeneration = 0

local function findNearestRegionNPC(
    regionName,
    requestedName
)
    if not characterAlive() then
        return nil, math.huge
    end

    local playerRoot = getRoot()

    local closest = nil
    local closestDistance = math.huge

    local requestedClean =
        cleanNPCName(requestedName)

    local anyNPC =
        requestedName == "Nearest Active NPC"

    for _, npc in ipairs(
        getActiveNPCEntries(regionName)
    ) do
        local matches =
            anyNPC
            or cleanNPCName(npc.Name)
            == requestedClean

        if matches then
            local distance =
                (
                    playerRoot.Position
                    - npc.Root.Position
                ).Magnitude

            if distance < closestDistance then
                closest = npc
                closestDistance = distance
            end
        end
    end

    return closest, closestDistance
end

local function findAnyMatchingNPC()
    local requestedClean =
        cleanNPCName(selectedNPC)

    local anyNPC =
        selectedNPC == "Nearest Active NPC"

    for _, npc in ipairs(
        getActiveNPCEntries(selectedRegion)
    ) do
        if anyNPC
            or cleanNPCName(npc.Name)
            == requestedClean
        then
            return npc
        end
    end

    return nil
end

local function positionAtNPC(npc)
    if not targetIsValid(npc) then
        return false
    end

    local _, _, playerRoot =
        waitForAliveCharacter()

    if not targetIsValid(npc) then
        return false
    end

    local npcPosition =
        npc.Root.Position

    local targetPosition =
        npcPosition
        + Vector3.new(
            0,
            farmHeight,
            0
        )

    local flatLook =
        Vector3.new(
            npcPosition.X,
            targetPosition.Y,
            npcPosition.Z
        )

    if (
        targetPosition - flatLook
    ).Magnitude > 0.01 then
        playerRoot.CFrame =
            CFrame.lookAt(
                targetPosition,
                flatLook
            )
    else
        playerRoot.CFrame =
            CFrame.new(targetPosition)
    end

    playerRoot.AssemblyLinearVelocity =
        Vector3.zero

    playerRoot.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

local function loadFarmArea()
    if not selectedRegion then
        return false
    end

    if farmLoadedRegion ==
        selectedRegion
    then
        return true
    end

    if not teleportToRegion(
        selectedRegion
    ) then
        return false
    end

    farmLoadedRegion =
        selectedRegion

    window:Notify({
        title = "Auto Farm",
        content =
            "Waiting for "
            .. selectedRegion
            .. " NPCs..."
    })

    task.wait(2)

    refreshAreaNPCs(selectedRegion)

    return true
end

-- respawn

local function returnToFarmAfterRespawn()
    if respawning then
        return
    end

    respawning = true

    task.spawn(function()
        print("[FARM] Respawning...")

        combatRelease()

        local _, _, root =
            waitForAliveCharacter()

        task.wait(0.5)

        if not autoFarm then
            respawning = false
            return
        end

        local target =
            currentFarmTarget

        if not targetIsValid(target) then
            target =
                findAnyMatchingNPC()
        end

        local timeout =
            os.clock() + 8

        while autoFarm
            and not targetIsValid(target)
            and os.clock() < timeout
        do
            task.wait(0.25)

            target =
                findAnyMatchingNPC()
        end

        if autoFarm
            and targetIsValid(target)
        then
            currentFarmTarget =
                target

            positionAtNPC(target)

            print(
                "[FARM] Returned to",
                target.Name,
                "after respawn"
            )

            window:Notify({
                title = "Auto Farm",
                content =
                    "Returned to "
                    .. target.Name
            })

        elseif autoFarm then
            -- Region is still considered loaded.
            -- Do NOT teleport back to crystal.
            currentFarmTarget = nil

            print(
                "[FARM] Respawned; waiting for NPC."
            )
        end

        if root and root.Parent then
            root.AssemblyLinearVelocity =
                Vector3.zero
        end

        respawning = false
    end)
end

Player.CharacterRemoving:Connect(function()
    if autoFarm then
        respawning = true
        currentFarmTarget =
            targetIsValid(currentFarmTarget)
            and currentFarmTarget
            or nil
    end

    pcall(combatRelease)
end)

Player.CharacterAdded:Connect(function()
    if autoFarm then
        respawning = false
        returnToFarmAfterRespawn()
    end
end)

