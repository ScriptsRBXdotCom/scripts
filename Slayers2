-- player

local function getCharacter()
    local character = Player.Character

    if character and character.Parent then
        return character
    end

    return Player.CharacterAdded:Wait()
end

local function getRoot()
    local character = getCharacter()

    return character:FindFirstChild("HumanoidRootPart")
        or character:WaitForChild("HumanoidRootPart")
end

local function getHumanoid()
    local character = Player.Character

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

local function characterAlive()
    local character = Player.Character

    if not character or not character.Parent then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    return humanoid
        and root
        and humanoid.Health > 0
end

local function waitForAliveCharacter()
    while true do
        local character = Player.Character

        if character and character.Parent then
            local humanoid =
                character:FindFirstChildOfClass("Humanoid")

            local root =
                character:FindFirstChild("HumanoidRootPart")

            if humanoid
                and root
                and humanoid.Health > 0
            then
                return character, humanoid, root
            end
        end

        task.wait(0.1)
    end
end

local function getObjectRoot(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object:FindFirstChild("HumanoidRootPart")
            or object:FindFirstChild("LowerTorso")
            or object:FindFirstChild("Torso")
            or object:FindFirstChild("Root")
            or object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

-- regions

local function getHumanoidRegions()
    return Humanoids:FindFirstChild("Regions") or Humanoids
end

local function getHumanoidRegion(regionName)
    local regions = getHumanoidRegions()

    if not regions then
        return nil
    end

    return regions:FindFirstChild(regionName)
end

local function getDebreeRegion(regionName)
    return DebreeRegions:FindFirstChild(regionName)
end

local AREA_CRYSTALS = {
    ["Bamboo Grove"] = "SpawnCrystal",
    ["Butterfly Estate"] = "SpawnCrystal",
    ["Final Selection Plains"] = "SpawnCrystal - Final Selection",
    ["Hidden Mist Village"] = "SpawnCrystal",
    ["Iceveil Valley"] = "SpawnCrystal - Iceveil Settlement",
    ["Mistfall Harbor"] = "SpawnCrystal",
    ["Windy Peak"] = "SpawnCrystal"
}

local function findSpawnCrystal(region)
    if not region then
        return nil
    end

    local expected = AREA_CRYSTALS[region.Name]

    if expected then
        local crystal = region:FindFirstChild(expected)

        if crystal then
            return crystal
        end
    end

    local normal = region:FindFirstChild("SpawnCrystal")

    if normal then
        return normal
    end

    for _, object in ipairs(region:GetChildren()) do
        if string.find(
            string.lower(object.Name),
            "spawncrystal",
            1,
            true
        ) then
            return object
        end
    end

    return nil
end

local function getObjectCFrame(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    if object:IsA("Attachment") then
        return object.WorldCFrame
    end

    if object:IsA("Model") then
        local success, pivot = pcall(function()
            return object:GetPivot()
        end)

        if success and pivot then
            return pivot
        end
    end

    local part =
        object:FindFirstChildWhichIsA("BasePart", true)

    if part then
        return part.CFrame
    end

    return nil
end

local function getTeleportableRegions()
    local result = {}

    for _, region in ipairs(DebreeRegions:GetChildren()) do
        if findSpawnCrystal(region) then
            table.insert(result, region.Name)
        end
    end

    table.sort(result)

    return result
end

local function teleportToRegion(regionName)
    local region = getDebreeRegion(regionName)

    if not region then
        return false
    end

    local crystal = findSpawnCrystal(region)

    if not crystal then
        return false
    end

    local cf = getObjectCFrame(crystal)

    if not cf then
        return false
    end

    local _, _, root = waitForAliveCharacter()

    root.CFrame =
        cf * CFrame.new(0, 5, 0)

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

-- npc

local function getRegionActiveNPCs(regionName)
    local region = getHumanoidRegion(regionName)

    if not region then
        return nil
    end

    return region:FindFirstChild("ActiveNpcs")
end

local function cleanNPCName(name)
    local cleaned = tostring(name or "")

    cleaned = cleaned:gsub("%*", "")
    cleaned = cleaned:gsub("^%s+", "")
    cleaned = cleaned:gsub("%s+$", "")

    return string.lower(cleaned)
end

local function displayNPCName(name)
    local cleaned = tostring(name or "")

    cleaned = cleaned:gsub("%*", "")
    cleaned = cleaned:gsub("^%s+", "")
    cleaned = cleaned:gsub("%s+$", "")

    return cleaned
end

local function resolveNPC(entry)
    if not entry then
        return nil
    end

    if entry:IsA("Model") then
        local humanoid =
            entry:FindFirstChildOfClass("Humanoid")

        if humanoid then
            local root =
                entry:FindFirstChild("HumanoidRootPart")
                or entry:FindFirstChild("LowerTorso")
                or entry:FindFirstChild("Torso")
                or entry.PrimaryPart
                or entry:FindFirstChildWhichIsA("BasePart")

            if root then
                return {
                    Entry = entry,
                    Character = entry,
                    Humanoid = humanoid,
                    Root = root,
                    RawName = entry.Name,
                    Name = displayNPCName(entry.Name)
                }
            end
        end
    end

    for _, child in ipairs(entry:GetChildren()) do
        if child:IsA("Model") then
            local humanoid =
                child:FindFirstChildOfClass("Humanoid")

            if humanoid then
                local root =
                    child:FindFirstChild("HumanoidRootPart")
                    or child:FindFirstChild("LowerTorso")
                    or child:FindFirstChild("Torso")
                    or child.PrimaryPart
                    or child:FindFirstChildWhichIsA("BasePart")

                if root then
                    return {
                        Entry = entry,
                        Character = child,
                        Humanoid = humanoid,
                        Root = root,
                        RawName = child.Name,
                        Name = displayNPCName(child.Name)
                    }
                end
            end
        end
    end

    return nil
end

local function targetIsValid(npc)
    return npc
        and npc.Entry
        and npc.Entry.Parent
        and npc.Character
        and npc.Character.Parent
        and npc.Root
        and npc.Root.Parent
        and npc.Humanoid
        and npc.Humanoid.Parent
        and npc.Humanoid.Health > 0
end

local function getActiveNPCEntries(regionName)
    local active =
        getRegionActiveNPCs(regionName)

    if not active then
        return {}
    end

    local result = {}

    for _, entry in ipairs(active:GetChildren()) do
        local npc = resolveNPC(entry)

        if targetIsValid(npc) then
            table.insert(result, npc)
        end
    end

    return result
end

local function refreshAreaNPCs(regionName)
    local active =
        getRegionActiveNPCs(regionName)

    if not active then
        print("[NPC]", regionName, "not loaded")
        return {}, 0
    end

    local npcs =
        getActiveNPCEntries(regionName)

    local counts = {}

    for _, npc in ipairs(npcs) do
        counts[npc.Name] =
            (counts[npc.Name] or 0) + 1
    end

    local names = {}

    for name, count in pairs(counts) do
        table.insert(names, name)

        print(
            "[NPC]",
            name,
            "x" .. tostring(count)
        )
    end

    table.sort(names)

    print(
        "[NPC]",
        regionName,
        "total:",
        #npcs
    )

    return names, #npcs
end

