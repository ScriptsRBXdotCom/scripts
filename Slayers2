    end
})

RunService.Heartbeat:Connect(function(dt)
    if not speedEnabled
        or autoFarm
        or flyEnabled
        or not characterAlive()
    then
        return
    end

    local humanoid =
        getHumanoid()

    local root =
        getRoot()

    if not humanoid
        or not root
        or humanoid.Health <= 0
    then
        return
    end

    local direction =
        humanoid.MoveDirection

    if direction.Magnitude <= 0.01 then
        return
    end

    local extraSpeed =
        math.max(
            0,
            speedAmount - 16
        )

    if extraSpeed <= 0 then
        return
    end

    root.CFrame =
        root.CFrame
        + direction.Unit
        * extraSpeed
        * dt
end)

