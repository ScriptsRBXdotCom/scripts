farmTab:CreateToggle({
    name = "Auto Farm",
    currentValue = false,

    callback = function(value)
        autoFarm = value
        farmGeneration += 1

        local thisGeneration =
            farmGeneration

        if not value then
            currentFarmTarget = nil
            respawning = false

            pcall(combatRelease)

            return
        end

        task.spawn(function()
            if not loadFarmArea() then
                autoFarm = false
                return
            end

            local lastRefresh = 0

            while autoFarm
                and thisGeneration
                == farmGeneration
            do
                if not characterAlive() then
                    RunService.Heartbeat:Wait()
                    continue
                end

                if respawning then
                    RunService.Heartbeat:Wait()
                    continue
                end

                if farmLoadedRegion
                    ~= selectedRegion
                then
                    currentFarmTarget = nil

                    if not loadFarmArea() then
                        break
                    end
                end

                local npc, distance =
                    findNearestRegionNPC(
                        selectedRegion,
                        selectedNPC
                    )

                if targetIsValid(npc)
                    and distance
                    <= maxTargetDistance
                then
                    currentFarmTarget =
                        npc

                    positionAtNPC(npc)

                else
                    currentFarmTarget =
                        nil

                    if os.clock()
                        - lastRefresh
                        >= 2
                    then
                        lastRefresh =
                            os.clock()

                        refreshAreaNPCs(
                            selectedRegion
                        )
                    end
                end

                RunService.Heartbeat:Wait()
            end
        end)
    end
})

