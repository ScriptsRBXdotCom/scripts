-- farm

local selectedNPC =
    discoveredNPCs[1]

local selectedFarmRegion = nil
local autoFarm = false

local farmHeight = 3
local maxTargetDistance = 5000

-- melee is part of Auto Farm

local hitDistance = 8
local meleeInterval = 0.05
local meleeHoldTime = 0.015

local currentFarmTarget = nil

local farmGeneration = 0
local respawning = false

local function selectedNPCMatches(
    npc,
    targetName
)
    if not targetIsValid(npc) then
        return false
    end

    targetName =
        targetName or selectedNPC

    return cleanNPCName(npc.Name)
        == cleanNPCName(targetName)
end

local function findNPCInRegion(
    regionName,
    targetName
)
    if not regionName
        or not targetName
    then
        return nil, math.huge
    end

    local playerRoot =
        getRoot()

    if not playerRoot then
        return nil, math.huge
    end

    local bestNPC = nil
    local bestDistance =
        math.huge

    for _, npc in ipairs(
        getRegionNPCs(regionName)
    ) do
        if selectedNPCMatches(
            npc,
            targetName
        ) then
            local distance =
                (
                    playerRoot.Position
                    - npc.Root.Position
                ).Magnitude

            if distance < bestDistance then
                bestNPC = npc
                bestDistance = distance
            end
        end
    end

    return bestNPC, bestDistance
end

local function positionAtNPC(npc)
    if not targetIsValid(npc)
        or not characterAlive()
    then
        return false
    end

    local root =
        getRoot()

    if not root then
        return false
    end

    local targetPosition =
        npc.Root.Position
        + Vector3.new(
            0,
            farmHeight,
            0
        )

    root.CFrame =
        CFrame.new(targetPosition)

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

local function prepareFarmGeneration(
    generation,
    targetName
)
    discoverNPCs()

    if not autoFarm
        or generation ~= farmGeneration
    then
        return false
    end

    local regionName =
        npcRegionMap[
            cleanNPCName(targetName)
        ]

    if not regionName then
        warn(
            "[NPC] No region found for:",
            targetName
        )

        return false
    end

    if IGNORED_NPC_REGIONS[regionName] then
        return false
    end

    selectedFarmRegion =
        regionName

    print(
        "[NPC]",
        targetName,
        "->",
        regionName
    )

    print(
        "[NPC] Teleporting:",
        regionName
    )

    local success =
        teleportToRegion(
            regionName,
            true
        )

    -- NPC may have changed while
    -- crystal/prompt was loading

    if not autoFarm
        or generation ~= farmGeneration
    then
        return false
    end

    if not success then
        warn(
            "[NPC] Could not prepare:",
            regionName
        )

        return false
    end

    print(
        "[NPC] Waiting for:",
        targetName
    )

    -- controller may already exist while
    -- actual Humanoid/HRP is still streaming

    while autoFarm
        and generation == farmGeneration
    do
        local npc =
            select(
                1,
                findNPCInRegion(
                    regionName,
                    targetName
                )
            )

        if npc
            and targetIsValid(npc)
        then
            currentFarmTarget =
                npc

            positionAtNPC(npc)

            print(
                "[NPC] Loaded:",
                npc.Name
            )

            return true
        end

        task.wait(0.15)
    end

    return false
end

local function startFarmGeneration()
    if not autoFarm then
        return
    end

    farmGeneration += 1

    local generation =
        farmGeneration

    local targetName =
        selectedNPC

    currentFarmTarget =
        nil

    selectedFarmRegion =
        nil

    pcall(combatRelease)

    print(
        "[NPC] Switching to:",
        targetName
    )

    task.spawn(function()
        local prepared =
            prepareFarmGeneration(
                generation,
                targetName
            )

        if not prepared
            or not autoFarm
            or generation ~= farmGeneration
        then
            return
        end

        while autoFarm
            and generation == farmGeneration
        do
            if not characterAlive()
                or respawning
            then
                task.wait(0.1)
                continue
            end

            if not targetIsValid(
                currentFarmTarget
            )
                or not selectedNPCMatches(
                    currentFarmTarget,
                    targetName
                )
            then
                currentFarmTarget =
                    nil
            end

            -- live ActiveNpcs rescan

            local npc, distance =
                findNPCInRegion(
                    selectedFarmRegion,
                    targetName
                )

            if npc
                and targetIsValid(npc)
                and distance <= maxTargetDistance
            then
                currentFarmTarget =
                    npc

                positionAtNPC(npc)
            else
                -- stay in same region and wait
                -- for replacement NPC

                currentFarmTarget =
                    nil
            end

            task.wait(0.05)
        end

        if generation == farmGeneration then
            currentFarmTarget =
                nil
        end
    end)
end

