local AREA_CRYSTALS = {
    ["Bamboo Grove"] = "SpawnCrystal",
    ["Butterfly Estate"] = "SpawnCrystal",
    ["Final Selection Plains"] = "SpawnCrystal - Final Selection",
    ["Hidden Mist Village"] = "SpawnCrystal",
    ["Iceveil Valley"] = "SpawnCrystal - Iceveil Settlement",
    ["Mistfall Harbor"] = "SpawnCrystal",
    ["Windy Peak"] = "SpawnCrystal"
}

local IGNORED_NPC_REGIONS = {
    ["Misc"] = true
}

local function findSpawnCrystal(region)
    if not region then
        return nil
    end

    local expected =
        AREA_CRYSTALS[region.Name]

    if expected then
        local crystal =
            region:FindFirstChild(expected)

        if crystal then
            return crystal
        end
    end

    local normal =
        region:FindFirstChild("SpawnCrystal")

    if normal then
        return normal
    end

    for _, object in ipairs(region:GetChildren()) do
        if string.find(
            string.lower(object.Name),
            "spawncrystal",
            1,
            true
        ) then
            return object
        end
    end

    return nil
end

local function getCrystalCFrame(crystal)
    if not crystal then
        return nil
    end

    if crystal:IsA("BasePart") then
        return crystal.CFrame
    end

    if crystal:IsA("Attachment") then
        return crystal.WorldCFrame
    end

    if crystal:IsA("Model") then
        local ok, pivot =
            pcall(function()
                return crystal:GetPivot()
            end)

        if ok and pivot then
            return pivot
        end
    end

    local part =
        crystal:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.CFrame
    end

    return nil
end

local function waitForSpawnCrystal(
    regionName,
    timeout
)
    timeout = timeout or 20

    local started = os.clock()

    while os.clock() - started < timeout do
        local region =
            getDebreeRegion(regionName)

        if region then
            local crystal =
                findSpawnCrystal(region)

            if crystal then
                local cf =
                    getCrystalCFrame(crystal)

                if cf then
                    return crystal, cf
                end
            end
        end

        task.wait(0.1)
    end

    return nil, nil
end

local function findSpawnPrompt(regionName)
    local region =
        getDebreeRegion(regionName)

    if not region then
        return nil
    end

    local crystal =
        findSpawnCrystal(region)

    if not crystal then
        return nil
    end

    -- SpawnCrystal.Root.At["Region Name"]

    local root =
        crystal:FindFirstChild("Root")

    if root then
        local at =
            root:FindFirstChild("At")

        if at then
            local prompt =
                at:FindFirstChild(regionName)

            if prompt
                and prompt:IsA("ProximityPrompt")
            then
                return prompt
            end
        end
    end

    -- fallback

    for _, object in ipairs(crystal:GetDescendants()) do
        if object:IsA("ProximityPrompt")
            and object.ActionText == "Set Spawn"
            and object.Name == regionName
        then
            return object
        end
    end

    return nil
end

local function waitForSpawnPrompt(
    regionName,
    timeout
)
    timeout = timeout or 30

    local started = os.clock()

    print("[NPC] Waiting for spawn:", regionName)

    while os.clock() - started < timeout do
        local prompt =
            findSpawnPrompt(regionName)

        if prompt
            and prompt.Parent
            and prompt.Enabled
        then
            print(
                "[NPC] Spawn prompt loaded:",
                regionName
            )

            return prompt
        end

        task.wait(0.1)
    end

    warn(
        "[NPC] Spawn prompt timeout:",
        regionName
    )

    return nil
end

local function activateSpawnPrompt(regionName)
    local prompt =
        waitForSpawnPrompt(
            regionName,
            30
        )

    if not prompt then
        return false
    end

    local _, _, root =
        waitForAliveCharacter()

    local promptParent =
        prompt.Parent

    if promptParent
        and promptParent:IsA("BasePart")
    then
        root.CFrame =
            promptParent.CFrame
            * CFrame.new(0, 3, 0)

        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero
    end

    task.wait(0.25)

    local ok, err =
        pcall(function()
            fireproximityprompt(prompt)
        end)

    if not ok then
        warn(
            "[NPC] Set Spawn failed:",
            err
        )

        return false
    end

    task.wait(1.25)

    print("[NPC] Spawn set:", regionName)

    return true
end

local function teleportToRegion(
    regionName,
    setSpawn
)
    local _, _, playerRoot =
        waitForAliveCharacter()

    local crystal, cf =
        waitForSpawnCrystal(
            regionName,
            20
        )

    if not crystal or not cf then
        warn(
            "[NPC] Crystal not loaded:",
            regionName
        )

        return false
    end

    -- teleport to crystal first so prompt streams

    playerRoot.CFrame =
        cf * CFrame.new(0, 4, 0)

    playerRoot.AssemblyLinearVelocity =
        Vector3.zero

    playerRoot.AssemblyAngularVelocity =
        Vector3.zero

    if setSpawn then
        return activateSpawnPrompt(regionName)
    end

    return true
end

local function getTeleportableRegions()
    local result = {}

    for _, region in ipairs(
        DebreeRegions:GetChildren()
    ) do
        if findSpawnCrystal(region) then
            table.insert(
                result,
                region.Name
            )
        end
    end

    table.sort(result)

    return result
end

-- npc

local function cleanNPCName(name)
    local value =
        tostring(name or "")

    value = value:gsub("%*", "")
    value = value:gsub("^%s+", "")
    value = value:gsub("%s+$", "")

    return string.lower(value)
end

local function displayNPCName(name)
    local value =
        tostring(name or "")

    value = value:gsub("%*", "")
    value = value:gsub("^%s+", "")
    value = value:gsub("%s+$", "")

    return value
end

local function getRegionActiveNPCs(
    regionName
)
    if IGNORED_NPC_REGIONS[regionName] then
        return nil
    end

    local regions =
        getHumanoidRegions()

    if not regions then
        return nil
    end

    local region =
        regions:FindFirstChild(regionName)

    if not region then
        return nil
    end

    return region:FindFirstChild("ActiveNpcs")
end

local function resolveCharacter(
    object,
    controller,
    regionName
)
    if not object then
        return nil
    end

    local humanoid =
        object:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return nil
    end

    local root =
        object:FindFirstChild("HumanoidRootPart")
        or object:FindFirstChild("LowerTorso")
        or object:FindFirstChild("Torso")
        or (
            object:IsA("Model")
            and object.PrimaryPart
        )
        or object:FindFirstChildWhichIsA(
            "BasePart"
        )

    if not root then
        return nil
    end

    return {
        Entry = controller or object,
        Character = object,
        Humanoid = humanoid,
        Root = root,
        Region = regionName,
        RawName = object.Name,
        Name = displayNPCName(object.Name)
    }
end

local function resolveNPC(
    entry,
    regionName
)
    if not entry then
        return nil
    end

    local direct =
        resolveCharacter(
            entry,
            entry,
            regionName
        )

    if direct then
        return direct
    end

    for _, child in ipairs(entry:GetChildren()) do
        local npc =
            resolveCharacter(
                child,
                entry,
                regionName
            )

        if npc then
            return npc
        end
    end

    return nil
end

local function targetIsValid(npc)
    return npc
        and npc.Entry
        and npc.Entry.Parent
        and npc.Character
        and npc.Character.Parent
        and npc.Humanoid
        and npc.Humanoid.Parent
        and npc.Humanoid.Health > 0
        and npc.Root
        and npc.Root.Parent
end

local function getRegionNPCs(regionName)
    local active =
        getRegionActiveNPCs(regionName)

    if not active then
        return {}
    end

    local result = {}

    for _, entry in ipairs(
        active:GetChildren()
    ) do
        local npc =
            resolveNPC(
                entry,
                regionName
            )

        if targetIsValid(npc) then
            table.insert(
                result,
                npc
            )
        end
    end

    return result
end

local function getAllLiveNPCs()
    local regions =
        getHumanoidRegions()

    if not regions then
        return {}
    end

    local result = {}

    for _, region in ipairs(
        regions:GetChildren()
    ) do
        -- Misc completely ignored

        if not IGNORED_NPC_REGIONS[
            region.Name
        ] then
            local active =
                region:FindFirstChild(
                    "ActiveNpcs"
                )

            if active then
                for _, entry in ipairs(
                    active:GetChildren()
                ) do
                    local npc =
                        resolveNPC(
                            entry,
                            region.Name
                        )

                    if targetIsValid(npc) then
                        table.insert(
                            result,
                            npc
                        )
                    end
                end
            end
        end
    end

    return result
end

-- npc discovery

local npcRegionMap = {}
local npcDisplayMap = {}

local function getControllerNPCName(
    controller
)
    if not controller then
        return nil
    end

    local npc =
        resolveNPC(
            controller,
            nil
        )

    if npc then
        return npc.Name
    end

    -- actual NPC model may exist before
    -- Humanoid/HRP finishes loading

    for _, child in ipairs(
        controller:GetChildren()
    ) do
        if child:IsA("Model") then
            local name =
                displayNPCName(
                    child.Name
                )

            if name ~= "" then
                return name
            end
        end
    end

    -- otherwise controller name identifies
    -- the NPC type

    return displayNPCName(
        controller.Name
    )
end

local function discoverNPCs()
    local regions =
        getHumanoidRegions()

    local names = {}
    local seen = {}

    npcRegionMap = {}
    npcDisplayMap = {}

    if not regions then
        return names
    end

    for _, region in ipairs(
        regions:GetChildren()
    ) do
        if not IGNORED_NPC_REGIONS[
            region.Name
        ] then
            local active =
                region:FindFirstChild(
                    "ActiveNpcs"
                )

            if active then
                for _, controller in ipairs(
                    active:GetChildren()
                ) do
                    local name =
                        getControllerNPCName(
                            controller
                        )

                    if name and name ~= "" then
                        local key =
                            cleanNPCName(name)

                        if key ~= "" then
                            if not npcRegionMap[key] then
                                npcRegionMap[key] =
                                    region.Name
                            end

                            npcDisplayMap[key] =
                                name

                            if not seen[key] then
                                seen[key] = true

                                table.insert(
                                    names,
                                    name
                                )
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(names)

    return names
end

local function refreshNPCDiscovery()
    local names =
        discoverNPCs()

    print(
        "[NPC] Discovered:",
        #names
    )

    for _, name in ipairs(names) do
        print(
            "[NPC]",
            name,
            "->",
            npcRegionMap[
                cleanNPCName(name)
            ] or "?"
        )
    end

    return names
end

