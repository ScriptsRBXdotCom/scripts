-- movement

local speedEnabled = false
local speedAmount = 50

local originalWalkSpeed = nil
local speedHumanoid = nil

local function applyWalkSpeed()
    if not speedEnabled then
        return
    end

    local humanoid =
        getHumanoid()

    if not humanoid then
        return
    end

    -- new character / respawn

    if speedHumanoid ~= humanoid then
        speedHumanoid =
            humanoid

        originalWalkSpeed =
            humanoid.WalkSpeed
    end

    humanoid.WalkSpeed =
        speedAmount
end

local function restoreWalkSpeed()
    local humanoid =
        getHumanoid()

    if humanoid
        and originalWalkSpeed
    then
        humanoid.WalkSpeed =
            originalWalkSpeed
    end

    speedHumanoid = nil
    originalWalkSpeed = nil
end

