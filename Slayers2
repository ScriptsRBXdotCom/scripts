task.spawn(function()
    while task.wait(0.5) do
        if activeESP then
            scanActiveESP()
        end

        if stationaryESP then
            scanStationaryESP()
        end

        local remove = {}

        for object, data in pairs(
            ESPObjects
        ) do
            if not object.Parent
                or not data.Root
                or not data.Root.Parent
            then
                table.insert(
                    remove,
                    object
                )

            elseif characterAlive() then
                local playerRoot =
                    getRoot()

                if playerRoot then
                    local distance =
                        (
                            playerRoot.Position
                            - data.Root.Position
                        ).Magnitude

                    data.Label.Text =
                        data.Name
                        .. "\n"
                        .. math.floor(distance)
                        .. " studs"
                end
            end
        end

        for _, object in ipairs(remove) do
            removeESP(object)
        end
    end
end)

