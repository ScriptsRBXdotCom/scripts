RunService:BindToRenderStep(
    "NPCPlaytestSpeed",
    Enum.RenderPriority.Character.Value + 1,

    function(dt)
        if not speedEnabled
            or autoFarm
            or not characterAlive()
        then
            return
        end

        local humanoid =
            getHumanoid()

        local root =
            getRoot()

        if not humanoid
            or not root
        then
            return
        end

        local direction =
            humanoid.MoveDirection

        if direction.Magnitude
            <= 0.01
        then
            return
        end

        local extra =
            math.max(
                0,
                speedAmount - 16
            )

        root.CFrame =
            root.CFrame
            + direction.Unit
            * extra
            * dt
    end
)

