local AREA_CRYSTALS = {
    ["Bamboo Grove"] = "SpawnCrystal",
    ["Butterfly Estate"] = "SpawnCrystal",
    ["Final Selection Plains"] = "SpawnCrystal - Final Selection",
    ["Hidden Mist Village"] = "SpawnCrystal",
    ["Iceveil Valley"] = "SpawnCrystal - Iceveil Settlement",
    ["Mistfall Harbor"] = "SpawnCrystal",
    ["Windy Peak"] = "SpawnCrystal"
}

local function findSpawnCrystal(region)
    if not region then
        return nil
    end

    local expected =
        AREA_CRYSTALS[region.Name]

    if expected then
        local crystal =
            region:FindFirstChild(expected)

        if crystal then
            return crystal
        end
    end

    local normal =
        region:FindFirstChild("SpawnCrystal")

    if normal then
        return normal
    end

    for _, object in ipairs(
        region:GetChildren()
    ) do
        if string.find(
            string.lower(object.Name),
            "spawncrystal",
            1,
            true
        ) then
            return object
        end
    end

    return nil
end

local function waitForSpawnCrystal(
    regionName,
    timeout
)
    timeout = timeout or 15

    local started = os.clock()

    while os.clock() - started < timeout do
        local region =
            getDebreeRegion(regionName)

        if region then
            local crystal =
                findSpawnCrystal(region)

            if crystal then
                local cf = nil

                if crystal:IsA("BasePart") then
                    cf = crystal.CFrame

                elseif crystal:IsA("Model") then
                    local ok, pivot =
                        pcall(function()
                            return crystal:GetPivot()
                        end)

                    if ok then
                        cf = pivot
                    end
                end

                if not cf then
                    local part =
                        crystal:FindFirstChildWhichIsA(
                            "BasePart",
                            true
                        )

                    if part then
                        cf = part.CFrame
                    end
                end

                if cf then
                    return crystal, cf
                end
            end
        end

        task.wait(0.1)
    end

    return nil, nil
end

local function findSpawnPrompt(regionName)
    local region =
        getDebreeRegion(regionName)

    if not region then
        return nil
    end

    local crystal =
        findSpawnCrystal(region)

    if not crystal then
        return nil
    end

    local root =
        crystal:FindFirstChild("Root")

    if not root then
        return nil
    end

    local at =
        root:FindFirstChild("At")

    if not at then
        return nil
    end

    local exact =
        at:FindFirstChild(regionName)

    if exact
        and exact:IsA("ProximityPrompt")
    then
        return exact
    end

    return nil
end

local function waitForSpawnPrompt(
    regionName,
    timeout
)
    timeout = timeout or 20

    local started = os.clock()

    print(
        "[NPC] Waiting for spawn:",
        regionName
    )

    while os.clock() - started < timeout do
        local prompt =
            findSpawnPrompt(regionName)

        if prompt
            and prompt.Parent
            and prompt.Enabled
        then
            print(
                "[NPC] Spawn prompt loaded:",
                regionName
            )

            return prompt
        end

        task.wait(0.1)
    end

    warn(
        "[NPC] Spawn prompt timeout:",
        regionName
    )

    return nil
end

local function activateSpawnPrompt(regionName)
    local prompt =
        waitForSpawnPrompt(
            regionName,
            20
        )

    if not prompt then
        return false
    end

    local _, _, root =
        waitForAliveCharacter()

    local promptParent =
        prompt.Parent

    if promptParent
        and promptParent:IsA("BasePart")
    then
        root.CFrame =
            promptParent.CFrame
            * CFrame.new(0, 3, 0)

        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero
    end

    task.wait(0.25)

    local ok, err =
        pcall(function()
            fireproximityprompt(prompt)
        end)

    if not ok then
        warn(
            "[NPC] Set Spawn failed:",
            err
        )

        return false
    end

    -- let server process spawn change

    task.wait(1)

    print(
        "[NPC] Spawn set:",
        regionName
    )

    return true
end

local function teleportToRegion(
    regionName,
    setSpawn
)
    if not characterAlive() then
        waitForAliveCharacter()
    end

    local crystal, cf =
        waitForSpawnCrystal(
            regionName,
            15
        )

    if not crystal or not cf then
        warn(
            "[NPC] Crystal timeout:",
            regionName
        )

        return false
    end

    local _, _, root =
        waitForAliveCharacter()

    root.CFrame =
        cf * CFrame.new(0, 4, 0)

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    -- being close causes the rest of the crystal
    -- structure to stream in

    if setSpawn then
        local success =
            activateSpawnPrompt(regionName)

        if not success then
            return false
        end
    end

    return true
end

local function getTeleportableRegions()
    local result = {}

    for _, region in ipairs(
        DebreeRegions:GetChildren()
    ) do
        if findSpawnCrystal(region) then
            table.insert(
                result,
                region.Name
            )
        end
    end

    table.sort(result)

    return result
end

-- npc

local function cleanNPCName(name)
    local value =
        tostring(name or "")

    value = value:gsub("%*", "")
    value = value:gsub("^%s+", "")
    value = value:gsub("%s+$", "")

    return string.lower(value)
end

local function displayNPCName(name)
    local value =
        tostring(name or "")

    value = value:gsub("%*", "")
    value = value:gsub("^%s+", "")
    value = value:gsub("%s+$", "")

    return value
end

local function resolveCharacter(
    object,
    controller,
    regionName
)
    if not object then
        return nil
    end

    local humanoid =
        object:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return nil
    end

    local root =
        object:FindFirstChild(
            "HumanoidRootPart"
        )
        or object:FindFirstChild(
            "LowerTorso"
        )
        or object:FindFirstChild(
            "Torso"
        )
        or (
            object:IsA("Model")
            and object.PrimaryPart
        )
        or object:FindFirstChildWhichIsA(
            "BasePart"
        )

    if not root then
        return nil
    end

    return {
        Entry = controller or object,
        Character = object,
        Humanoid = humanoid,
        Root = root,

        Region = regionName,

        RawName = object.Name,
        Name = displayNPCName(
            object.Name
        )
    }
end

local function resolveNPC(
    entry,
    regionName
)
    if not entry then
        return nil
    end

    -- npc itself may be the entry

    local direct =
        resolveCharacter(
            entry,
            entry,
            regionName
        )

    if direct then
        return direct
    end

    -- known structure:
    --
    -- ActiveNpcs
    --   Controller
    --     Bear Cub
    --       Humanoid
    --       HumanoidRootPart
    --
    -- same structure works for Bandit,
    -- *Civilian*, Zuko, etc.

    for _, child in ipairs(
        entry:GetChildren()
    ) do
        local npc =
            resolveCharacter(
                child,
                entry,
                regionName
            )

        if npc then
            return npc
        end
    end

    return nil
end

local function targetIsValid(npc)
    return npc
        and npc.Entry
        and npc.Entry.Parent
        and npc.Character
        and npc.Character.Parent
        and npc.Humanoid
        and npc.Humanoid.Parent
        and npc.Humanoid.Health > 0
        and npc.Root
        and npc.Root.Parent
end

local function getRegionActiveNPCs(
    regionName
)
    local regions =
        getHumanoidRegions()

    if not regions then
        return nil
    end

    local region =
        regions:FindFirstChild(
            regionName
        )

    if not region then
        return nil
    end

    return region:FindFirstChild(
        "ActiveNpcs"
    )
end

local function getRegionNPCs(
    regionName
)
    local active =
        getRegionActiveNPCs(
            regionName
        )

    if not active then
        return {}
    end

    local result = {}

    for _, entry in ipairs(
        active:GetChildren()
    ) do
        local npc =
            resolveNPC(
                entry,
                regionName
            )

        if targetIsValid(npc) then
            table.insert(
                result,
                npc
            )
        end
    end

    return result
end

local function getAllLiveNPCs()
    local regions =
        getHumanoidRegions()

    if not regions then
        return {}
    end

    local result = {}

    for _, region in ipairs(
        regions:GetChildren()
    ) do
        local active =
            region:FindFirstChild(
                "ActiveNpcs"
            )

        if active then
            for _, entry in ipairs(
                active:GetChildren()
            ) do
                local npc =
                    resolveNPC(
                        entry,
                        region.Name
                    )

                if targetIsValid(npc) then
                    table.insert(
                        result,
                        npc
                    )
                end
            end
        end
    end

    return result
end

local function refreshNPCs()
    local npcs =
        getAllLiveNPCs()

    local counts = {}
    local regionCounts = {}

    for _, npc in ipairs(npcs) do
        local name =
            npc.Name

        counts[name] =
            (counts[name] or 0) + 1

        local region =
            npc.Region or "Unknown"

        regionCounts[region] =
            (regionCounts[region] or 0) + 1
    end

    local names = {}

    for name in pairs(counts) do
        table.insert(
            names,
            name
        )
    end

    table.sort(names)

    for _, name in ipairs(names) do
        print(
            "[NPC]",
            name,
            "x" .. tostring(
                counts[name]
            )
        )
    end

    local regionNames = {}

    for region in pairs(
        regionCounts
    ) do
        table.insert(
            regionNames,
            region
        )
    end

    table.sort(regionNames)

    for _, region in ipairs(
        regionNames
    ) do
        print(
            "[NPC]",
            region,
            "total:",
            regionCounts[region]
        )
    end

    print(
        "[NPC] Total:",
        #npcs
    )

    return npcs
end

