            while autoFarm
                and generation
                == farmGeneration
            do
                if not characterAlive()
                    or respawning
                then
                    RunService.Heartbeat:Wait()
                    continue
                end

                -- discard dead / removed npc

                if not targetIsValid(
                    currentFarmTarget
                )
                    or not npcMatchesSelection(
                        currentFarmTarget
                    )
                then
                    currentFarmTarget =
                        nil
                end

                -- fresh scan EVERY cycle

                local target, distance =
                    acquireFarmTarget()

                if target
                    and targetIsValid(target)
                    and distance
                    <= maxTargetDistance
                then
                    currentFarmTarget =
                        target

                    positionAtNPC(
                        target
                    )
                else
                    currentFarmTarget =
                        nil
                end

                RunService.Heartbeat:Wait()
            end

            currentFarmTarget = nil
        end)
    end
})

-- respawn

local function returnToFarmAfterRespawn()
    if respawning then
        return
    end

    respawning = true

    task.spawn(function()
        pcall(
            combatRelease
        )

        waitForAliveCharacter()

        -- let character finish loading

        task.wait(0.75)

        if not autoFarm then
            respawning = false
            return
        end

        currentFarmTarget = nil

        local timeout =
            os.clock() + 15

        while autoFarm
            and os.clock() < timeout
        do
            local target =
                select(
                    1,
                    acquireFarmTarget()
                )

            if target
                and targetIsValid(target)
            then
                currentFarmTarget =
                    target

                positionAtNPC(
                    target
                )

                print(
                    "[FARM] Respawn ->",
                    target.Name
                )

                break
            end

            task.wait(0.1)
        end

        respawning = false
    end)
end

Player.CharacterRemoving:Connect(
    function()
        currentFarmTarget = nil

        pcall(
            combatRelease
        )
    end
)

Player.CharacterAdded:Connect(
    function()
        if autoFarm then
            task.spawn(function()
                task.wait(0.1)

                returnToFarmAfterRespawn()
            end)
        end
    end
)

