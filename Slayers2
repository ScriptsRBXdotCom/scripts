-- esp

local activeESP = false
local stationaryESP = false

local ESPObjects = {}

local function createESP(
    model,
    npcName,
    stationary
)
    if not model
        or ESPObjects[model]
    then
        return
    end

    local root =
        getObjectRoot(model)

    if not root then
        return
    end

    local name =
        displayNPCName(
            npcName or model.Name
        )

    local highlight =
        Instance.new("Highlight")

    highlight.Name =
        "_NPC_PLAYTEST_ESP"

    highlight.Adornee =
        model

    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.FillTransparency =
        0.5

    highlight.OutlineTransparency =
        0

    if stationary then
        highlight.FillColor =
            Color3.fromRGB(
                180,
                80,
                255
            )

    elseif cleanNPCName(name)
        == "civilian"
    then
        highlight.FillColor =
            Color3.fromRGB(
                0,
                170,
                255
            )

    else
        highlight.FillColor =
            Color3.fromRGB(
                255,
                70,
                70
            )
    end

    highlight.OutlineColor =
        Color3.fromRGB(
            255,
            255,
            255
        )

    highlight.Parent =
        model

    local billboard =
        Instance.new("BillboardGui")

    billboard.Name =
        "_NPC_PLAYTEST_ESP"

    billboard.Adornee =
        root

    billboard.Size =
        UDim2.new(
            0,
            180,
            0,
            45
        )

    billboard.StudsOffset =
        Vector3.new(
            0,
            3.5,
            0
        )

    billboard.AlwaysOnTop =
        true

    billboard.Parent =
        root

    local label =
        Instance.new("TextLabel")

    label.Size =
        UDim2.fromScale(1, 1)

    label.BackgroundTransparency =
        1

    label.Text =
        name

    label.TextColor3 =
        Color3.fromRGB(
            255,
            255,
            255
        )

    label.TextStrokeTransparency =
        0

    label.TextSize =
        14

    label.Font =
        Enum.Font.GothamBold

    label.Parent =
        billboard

    ESPObjects[model] = {
        Highlight = highlight,
        Billboard = billboard,
        Label = label,
        Root = root,
        Name = name,
        Stationary = stationary
    }
end

local function removeESP(model)
    local data =
        ESPObjects[model]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    ESPObjects[model] = nil
end

local function clearESP(stationary)
    local remove = {}

    for model, data in pairs(
        ESPObjects
    ) do
        if data.Stationary
            == stationary
        then
            table.insert(
                remove,
                model
            )
        end
    end

    for _, model in ipairs(remove) do
        removeESP(model)
    end
end

local function scanActiveESP()
    if not activeESP then
        return
    end

    -- exact same resolver as auto farm

    for _, npc in ipairs(
        getAllLiveNPCs()
    ) do
        if targetIsValid(npc) then
            createESP(
                npc.Character,
                npc.Name,
                false
            )
        end
    end
end

local function scanStationaryESP()
    if not stationaryESP then
        return
    end

    for _, region in ipairs(
        DebreeRegions:GetChildren()
    ) do
        local folder =
            region:FindFirstChild(
                "StationaryNpcs"
            )

        if folder then
            for _, entry in ipairs(
                folder:GetChildren()
            ) do
                local npc =
                    resolveNPC(
                        entry,
                        region.Name
                    )

                if npc then
                    createESP(
                        npc.Character,
                        npc.Name,
                        true
                    )

                elseif getObjectRoot(entry) then
                    createESP(
                        entry,
                        entry.Name,
                        true
                    )
                end
            end
        end
    end
end

