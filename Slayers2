-- automatic farm melee

task.spawn(function()
    while true do
        if autoFarm
            and not respawning
            and characterAlive()
        then
            local npc =
                currentFarmTarget

            if targetIsValid(npc) then
                local root =
                    getRoot()

                if root then
                    local distance =
                        (
                            root.Position
                            - npc.Root.Position
                        ).Magnitude

                    if distance <= hitDistance then
                        combatClick(
                            meleeHoldTime
                        )
                    end
                end
            end
        end

        task.wait(meleeInterval)
    end
end)

-- respawn

local function returnToFarmAfterRespawn()
    if respawning then
        return
    end

    respawning = true

    task.spawn(function()
        pcall(combatRelease)

        waitForAliveCharacter()

        task.wait(0.75)

        if not autoFarm then
            respawning = false
            return
        end

        local generation =
            farmGeneration

        local targetName =
            selectedNPC

        local regionName =
            selectedFarmRegion

        currentFarmTarget =
            nil

        -- spawn should already be set to the
        -- farm region, so just reacquire NPC

        if regionName then
            print(
                "[NPC] Respawn waiting for:",
                targetName
            )

            while autoFarm
                and generation == farmGeneration
            do
                local npc =
                    select(
                        1,
                        findNPCInRegion(
                            regionName,
                            targetName
                        )
                    )

                if npc
                    and targetIsValid(npc)
                then
                    currentFarmTarget =
                        npc

                    positionAtNPC(npc)

                    print(
                        "[NPC] Respawn ->",
                        npc.Name
                    )

                    break
                end

                task.wait(0.1)
            end
        end

        respawning = false
    end)
end

