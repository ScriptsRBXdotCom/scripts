--==================================================
-- Rarity Priority
--==================================================

local RarityOrder = {
    "Secret",
    "Eternal",
    "Mythic",
    "Legendary",
    "Epic",
    "Rare",
    "Uncommon",
    "Common",
}

local RarityPriority = {}

for index, rarity in ipairs(RarityOrder) do
    RarityPriority[string.lower(rarity)] = index
end


--==================================================
-- Notification
--==================================================

local function notify(title, content, duration)

    pcall(function()
        Rayfield:Notify({
            title = tostring(title),
            content = tostring(content),
            duration = duration or 3,
        })
    end)

end


--==================================================
-- Character
--==================================================

local function getCharacter()

    return Player.Character
        or Player.CharacterAdded:Wait()

end


local function getHumanoid()

    local character = getCharacter()

    return character:FindFirstChildOfClass("Humanoid")
        or character:WaitForChild("Humanoid")

end


local function getRootPart()

    local character = getCharacter()

    return character:FindFirstChild("HumanoidRootPart")
        or character:WaitForChild("HumanoidRootPart")

end


--==================================================
-- Movement
--==================================================

local function applyMovement()

    local humanoid = getHumanoid()

    humanoid.WalkSpeed = WalkSpeed

    pcall(function()
        humanoid.UseJumpPower = true
    end)

    humanoid.JumpPower = JumpPower
end


Player.CharacterAdded:Connect(function()

    task.wait(0.5)

    applyMovement()

end)


--==================================================
-- Target CFrame
--==================================================

local function getObjectCFrame(object)

    if not object or not object.Parent then
        return nil
    end

    if object:IsA("Model") then
        return object:GetPivot()
    end

    if object:IsA("BasePart") then
        return object.CFrame
    end

    local part = object:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

    if part then
        return part.CFrame
    end

    return nil
end


--==================================================
-- Normal Teleport
--==================================================

local function teleport(object)

    local cf = getObjectCFrame(object)

    if not cf then
        return false
    end

    local character = getCharacter()
    local root = getRootPart()

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    character:PivotTo(
        cf * CFrame.new(0, SafeHeightOffset, 0)
    )

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    return true
end


--==================================================
-- Sticky / Safe Teleport
--==================================================

local function getLoadTimeForRarity(rarity)

    rarity = string.lower(
        tostring(rarity or "")
    )

    if rarity == "secret"
    or rarity == "eternal"
    or rarity == "mythic" then

        return RareLoadTime
    end

    return NormalLoadTime
end


local function safeTeleportAndLoad(object, rarity)

    if not object or not object.Parent then
        return false
    end

    local character = getCharacter()
    local root = getRootPart()

    local loadTime =
        getLoadTimeForRarity(rarity)

    local started = tick()


    while tick() - started < loadTime do

        if not object.Parent then
            return false
        end


        local targetCF =
            getObjectCFrame(object)

        if not targetCF then

            task.wait(
                ReTeleportInterval
            )

            continue
        end


        local targetPosition =
            targetCF.Position


        -- Kill falling velocity
        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero


        -- Re-teleport continuously while target loads
        character:PivotTo(
            targetCF
            * CFrame.new(
                0,
                SafeHeightOffset,
                0
            )
        )


        root.AssemblyLinearVelocity =
            Vector3.zero

        root.AssemblyAngularVelocity =
            Vector3.zero


        task.wait(
            ReTeleportInterval
        )


        -- Safety check:
        -- if character somehow falls under the target,
        -- put them back immediately.
        if root.Position.Y
            < targetPosition.Y - FallDistance then

            character:PivotTo(
                targetCF
                * CFrame.new(
                    0,
                    SafeHeightOffset,
                    0
                )
            )


            root.AssemblyLinearVelocity =
                Vector3.zero
        end

    end


    -- Final teleport after streaming/loading
    return teleport(object)
end


--==================================================
-- Find Player Plot
--==================================================

local function getMyPlot()

    for _, plot in ipairs(
        Plots:GetChildren()
    ) do

        for attributeName, value in pairs(
            plot:GetAttributes()
        ) do

            local name =
                string.lower(
                    attributeName
                )


            if name == "owneruserid"
            or name == "userid"
            or name == "ownerid" then

                if tonumber(value)
                    == Player.UserId then

                    return plot
                end
            end
        end
    end

    return nil
end


--==================================================
-- Egg Detection
--==================================================

local function isEggModel(egg)

    if not egg:IsA("Model") then
        return false
    end


    if egg.Parent ~= LiveAreaEggs then
        return false
    end


    if egg:GetAttribute("Rarity")
        == nil then

        return false
    end


    if egg:GetAttribute("PlotPet")
        == true then

        return false
    end


    return true
end


local function isAvailableEgg(egg)

    if not isEggModel(egg) then
        return false
    end


    if egg:GetAttribute("CarriedBy")
        ~= nil then

        return false
    end


    return true
end


--==================================================
-- Available Counts
--==================================================

local function getAvailableCounts()

    local counts = {}


    for _, egg in ipairs(
        LiveAreaEggs:GetChildren()
    ) do

        if isAvailableEgg(egg) then

            local rarity =
                tostring(
                    egg:GetAttribute(
                        "Rarity"
                    )
                )


            counts[rarity] =
                (counts[rarity] or 0)
                + 1
        end
    end


    return counts
end


--==================================================
-- Available Text
--==================================================

local function getAvailableText()

    local counts =
        getAvailableCounts()

    local output = {}
    local added = {}


    for _, rarity in ipairs(
        RarityOrder
    ) do

        for actualRarity, count
        in pairs(counts) do

            if string.lower(
                actualRarity
            ) == string.lower(
                rarity
            ) then

                table.insert(
                    output,
                    actualRarity
                    .. ": "
                    .. tostring(count)
                )


                added[
                    string.lower(
                        actualRarity
                    )
                ] = true

            end
        end
    end


    local extras = {}


    for rarity, count
    in pairs(counts) do

        if not added[
            string.lower(rarity)
        ] then

            table.insert(
                extras,
                {
                    rarity = rarity,
                    count = count,
                }
            )

        end
    end


    table.sort(
        extras,
        function(a, b)

            return a.rarity
                < b.rarity

        end
    )


    for _, info
    in ipairs(extras) do

        table.insert(
            output,
            info.rarity
            .. ": "
            .. tostring(info.count)
        )

    end


    if #output == 0 then
        return "No available eggs"
    end


    return table.concat(
        output,
        "\n"
    )
end


--==================================================
-- Get Rarities
--==================================================

local function getRarities()

    local found = {}
    local list = {}


    for _, egg in ipairs(
        LiveAreaEggs:GetChildren()
    ) do

        if egg:IsA("Model") then

            local rarity =
                egg:GetAttribute(
                    "Rarity"
                )


            if rarity ~= nil then

                rarity =
                    tostring(rarity)

                local key =
                    string.lower(rarity)


                if not found[key] then

                    found[key] = true

                    table.insert(
                        list,
                        rarity
                    )

                end
            end
        end
    end


    table.sort(
        list,
        function(a, b)

            local pa =
                RarityPriority[
                    string.lower(a)
                ] or 999

            local pb =
                RarityPriority[
                    string.lower(b)
                ] or 999


            if pa == pb then
                return a < b
            end


            return pa < pb
        end
    )


    return list
end


local Rarities =
    getRarities()


if #Rarities > 0 then
    SelectedRarity =
        Rarities[1]
end


