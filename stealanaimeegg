--==================================================
-- Find Selected Egg
--==================================================

local function findEgg()

    if not SelectedRarity then
        return nil
    end


    local wanted =
        string.lower(
            tostring(
                SelectedRarity
            )
        )


    for _, egg in ipairs(
        LiveAreaEggs:GetChildren()
    ) do

        if isAvailableEgg(egg) then

            local rarity =
                tostring(
                    egg:GetAttribute(
                        "Rarity"
                    )
                )


            if string.lower(rarity)
                == wanted then

                return egg

            end
        end
    end


    return nil
end


--==================================================
-- Find Prompt
--==================================================

local function findEggPrompt(egg)

    -- Search egg descendants first
    for _, object in ipairs(
        egg:GetDescendants()
    ) do

        if object:IsA(
            "ProximityPrompt"
        ) then

            local action =
                string.lower(
                    tostring(
                        object.ActionText
                    )
                )


            if object.Name
                == "CarryAreaEgg"
            or string.find(
                action,
                "steal"
            ) then

                return object

            end
        end
    end


    -- Smart prompt may be elsewhere.
    local targetCF =
        getObjectCFrame(egg)

    if not targetCF then
        return nil
    end


    local eggPosition =
        targetCF.Position

    local closestPrompt = nil
    local closestDistance =
        math.huge


    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA(
            "ProximityPrompt"
        ) then

            local action =
                string.lower(
                    tostring(
                        object.ActionText
                    )
                )


            if object.Name
                == "CarryAreaEgg"
            or string.find(
                action,
                "steal"
            ) then

                local parent =
                    object.Parent

                local part = nil


                if parent then

                    if parent:IsA(
                        "BasePart"
                    ) then

                        part = parent

                    elseif parent:IsA(
                        "Attachment"
                    )
                    and parent.Parent
                    and parent.Parent:IsA(
                        "BasePart"
                    ) then

                        part =
                            parent.Parent
                    end
                end


                if part then

                    local distance =
                        (
                            part.Position
                            - eggPosition
                        ).Magnitude


                    if distance
                        < closestDistance then

                        closestDistance =
                            distance

                        closestPrompt =
                            object

                    end
                end
            end
        end
    end


    if closestPrompt
    and closestDistance <= 15 then

        return closestPrompt
    end


    return nil
end


--==================================================
-- Wait For Prompt To Load
--==================================================

local function waitForEggPrompt(
    egg,
    timeout
)

    local started = tick()


    repeat

        local prompt =
            findEggPrompt(egg)

        if prompt then
            return prompt
        end


        -- Keep us at the egg while prompt loads
        teleport(egg)

        task.wait(0.15)


    until tick() - started
        >= timeout


    return nil
end


--==================================================
-- Hold Time
--==================================================

local function getHoldTime(prompt)

    if prompt then

        local duration =
            tonumber(
                prompt.HoldDuration
            )


        if duration
        and duration > 0 then

            return duration
        end
    end


    return DefaultHoldTime
end


--==================================================
-- Claim Egg
--==================================================

local function claimEgg()

    local egg = findEgg()


    if not egg then

        if tick()
            - LastNoEggNotification
            > 4 then

            LastNoEggNotification =
                tick()


            notify(
                "No Egg Available",
                "No "
                .. tostring(
                    SelectedRarity
                )
                .. " egg is available.\n\n"
                .. getAvailableText(),
                4
            )

        end


        return false
    end


    local plot =
        getMyPlot()


    if not plot then

        notify(
            "Plot Not Found",
            "Could not find your plot.",
            3
        )

        return false
    end


    local eggName =
        egg.Name

    local rarity =
        tostring(
            egg:GetAttribute(
                "Rarity"
            )
        )


    --==================================================
    -- Sticky TP + load
    --==================================================

    notify(
        "Loading Egg",
        eggName
        .. " ["
        .. rarity
        .. "]",
        2
    )


    local loaded =
        safeTeleportAndLoad(
            egg,
            rarity
        )


    if not loaded then

        notify(
            "Teleport Failed",
            "Could not load "
            .. eggName,
            3
        )

        return false
    end


    if not egg.Parent then

        teleport(plot)

        return false
    end


    --==================================================
    -- Wait For Prompt
    --==================================================

    local prompt =
        waitForEggPrompt(
            egg,
            2.5
        )


    local holdTime =
        getHoldTime(prompt)


    notify(
        "Stealing Egg",
        eggName
        .. "\nHold: "
        .. string.format(
            "%.1f",
            holdTime
        )
        .. "s",
        math.max(
            2,
            holdTime
        )
    )


    --==================================================
    -- Prompt Hold
    --==================================================

    if prompt then

        pcall(function()
            prompt:InputHoldBegin()
        end)


        local holdStarted =
            tick()


        while tick()
            - holdStarted
            < holdTime + 0.15 do

            if not egg.Parent then
                break
            end


            -- Keep character at target
            -- during long Secret/etc prompt.
            local targetCF =
                getObjectCFrame(egg)

            local root =
                getRootPart()


            if targetCF then

                local distance =
                    (
                        root.Position
                        - targetCF.Position
                    ).Magnitude


                if distance > 9
                or root.Position.Y
                    < targetCF.Position.Y
                    - FallDistance then

                    teleport(egg)

                end
            end


            root.AssemblyLinearVelocity =
                Vector3.zero


            task.wait(0.1)
        end


        pcall(function()
            prompt:InputHoldEnd()
        end)

    else

        -- Prompt wasn't found.
        -- Stay at egg for fallback hold.
        local started =
            tick()


        while tick() - started
            < holdTime do

            if not egg.Parent then
                break
            end


            teleport(egg)

            task.wait(0.15)
        end

    end


    --==================================================
    -- Direct Remote Fallback
    --==================================================

    if egg.Parent then

        local held =
            tostring(
                Player:GetAttribute(
                    "HeldEggUid"
                )
                or ""
            )


        if held == "" then

            local eggUid =
                egg:GetAttribute(
                    "EggUid"
                )


            if eggUid ~= nil then

                StealEgg:FireServer(
                    egg,
                    eggUid
                )

            end
        end
    end


    --==================================================
    -- Confirmation
    --==================================================

    local started =
        tick()

    local success =
        false


    repeat

        task.wait(0.05)


        local held =
            tostring(
                Player:GetAttribute(
                    "HeldEggUid"
                )
                or ""
            )


        if held ~= "" then

            success = true
            break

        end


        if not egg.Parent then

            success = true
            break

        end


        if egg:GetAttribute(
            "CarriedBy"
        ) ~= nil then

            success = true
            break

        end


    until tick() - started
        > ClaimWait


    --==================================================
    -- Safe return
    --==================================================

    safeTeleportAndLoad(
        plot,
        "Common"
    )


    if success then

        notify(
            "Egg Claimed",
            eggName
            .. " ["
            .. rarity
            .. "]\nReturned to plot.",
            2
        )

    else

        notify(
            "Claim Timed Out",
            eggName
            .. " did not confirm.",
            3
        )

    end


    refreshAvailableEggs()

    return success
end


