--==================================================
-- HELPERS
--==================================================

local function getPlot()
	local plotName = LocalPlayer:GetAttribute("PlotName")

	if not plotName then
		return nil
	end

	local plots = workspace:FindFirstChild("Plots")

	if not plots then
		return nil
	end

	return plots:FindFirstChild(plotName)
end

local function getSpinnerFolder()
	local plot = getPlot()

	if not plot then
		return nil
	end

	return plot:FindFirstChild("PlayerSpinners")
end

