--========================================================
-- BEST TNT LOOP
--========================================================

task.spawn(function()
	while true do
		if not BombShopTripBusy
			and not BombShopBusy
			and not RefillBusy
			and not RebirthBusy
			and not AreaPurchaseBusy
			and not MineReturnBusy then

			if AutoBuyBestBomb
				or AutoEquipBestBomb then

				local Affordable =
					AutoBuyBestBomb
					and GetBestAffordableUnownedBomb()
					or nil

				local Best =
					AutoEquipBestBomb
					and GetBestOwnedBomb()
					or nil

				local NeedsEquip =
					Best
					and SafeRawGet(
						Session,
						"EquippedBomb"
					) ~= Best.Name

				if Affordable
					or NeedsEquip then

					RunBombShopTrip()
				end
			end
		end

		task.wait(
			BOMB_SHOP_DELAY
		)
	end
end)

--========================================================
-- FARM WATCHDOG
--========================================================

task.spawn(function()
	while true do
		if AutoFarm
			and not RefillBusy
			and not RebirthBusy
			and not BombShopTripBusy
			and not AreaPurchaseBusy then

			-- With bombs available and no active TNT, several
			-- seconds without a successful place/ignite means
			-- the local farm state is stale.
			local Held =
				tonumber(
					SafeRawGet(
						Session,
						"HeldBombs"
					)
				) or 0

			if Held > 0
				and EffectiveActiveCount() == 0
				and os.clock() - LastFarmProgress > 3 then

				RecoverFarmState()
			end
		end

		task.wait(0.5)
	end
end)

