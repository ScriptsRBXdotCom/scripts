--========================================================
-- SAFE MINE RETURN
--========================================================

local function GetMineReturnCFrame()
	local AreaName =
		GetOwnedArea()
		or GetCurrentAreaName()

	if not AreaName then
		return nil
	end

	local Area =
		GetAreaModel(AreaName)

	if not Area then
		return nil
	end

	local Mine =
		Area:FindFirstChild("Mine")

	if not Mine then
		return nil
	end

	local BlocksArea =
		Mine:FindFirstChild(
			"BlocksArea"
		)

	if not BlocksArea
		or not BlocksArea:IsA("BasePart") then

		return nil
	end

	local Position =
		BlocksArea.Position
		+
		BlocksArea.CFrame.UpVector
		*
		(
			BlocksArea.Size.Y / 2
			+ 6
		)

	return CFrame.new(
		Position,
		Position
		+ BlocksArea.CFrame.LookVector
	)
end

local function ReturnToMineIfNeeded()
	if not AutoFarm
		or RefillBusy
		or RebirthBusy
		or MineReturnBusy
		or BombShopBusy
		or BombShopTripBusy
		or AreaPurchaseBusy then

		return false
	end

	if IsInMine() then
		return true
	end

	local Root = GetRoot()
	local Target = GetMineReturnCFrame()

	if not Root or not Target then
		return false
	end

	MineReturnBusy = true

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Root.CFrame = Target

	local Deadline =
		os.clock() + 5

	while os.clock() < Deadline do
		if IsInMine() then
			ClearReservations()
			table.clear(PendingBombs)

			MineReturnBusy = false

			return true
		end

		task.wait(0.1)
	end

	MineReturnBusy = false

	return false
end

--========================================================
-- VOID RECOVERY
--========================================================

local function RecoverFromVoid()
	if os.clock()
		< VoidRecoveryCooldown then

		return false
	end

	local Root = GetRoot()

	if not Root then
		return false
	end

	if Root.Position.Y >
		workspace.FallenPartsDestroyHeight + 128 then

		return false
	end

	VoidRecoveryCooldown =
		os.clock() + 2

	local Result =
		CallSession(
			"RecoverFromVoid"
		)

	return Result ~= false
end

local function ValidatePlayerPosition()
	local Root = GetRoot()

	if not Root then
		return
	end

	if Root.Position.Y <=
		workspace.FallenPartsDestroyHeight + 128 then

		RecoverFromVoid()
		return
	end

	if IsInMine() then
		local Safe =
			GetMineReturnCFrame()

		if Safe
			and Root.Position.Y
				< Safe.Position.Y - 80 then

			Root.AssemblyLinearVelocity =
				Vector3.zero

			Root.CFrame = Safe
		end
	end
end

