--========================================================
-- AREA PURCHASE / AREA SWITCHING
--========================================================

local function GetNextAreaToBuy()
	local HighestOwned =
		GetOwnedArea()

	if not HighestOwned then
		return nil
	end

	return
		AreasConfig.GetNextName(
			HighestOwned
		)
end

local function GetAreaPrice(AreaName)
	local Config =
		AreasConfig[AreaName]

	return
		Config
		and tonumber(Config.Price)
		or nil
end

local function MirrorOwnedArea(AreaName)
	local OwnedAreas =
		SafeRawGet(
			Session,
			"OwnedAreas"
		)

	if typeof(OwnedAreas) ~= "table" then
		return
	end

	local ArrayStyle = false

	for Key, Value in pairs(OwnedAreas) do
		if typeof(Key) == "number"
			and typeof(Value) == "string" then

			ArrayStyle = true
			break
		end
	end

	if ArrayStyle then
		if not table.find(
			OwnedAreas,
			AreaName
		) then

			table.insert(
				OwnedAreas,
				AreaName
			)
		end
	else
		OwnedAreas[AreaName] = true
	end
end

local function WaitForAreaRendered(
	AreaName,
	Timeout
)
	local Deadline =
		os.clock()
		+ (Timeout or 8)

	while os.clock() < Deadline do
		local Area =
			GetAreaModel(
				AreaName
			)

		if Area
			and Area:GetAttribute(
				"MineRenderReady"
			) ~= false then

			local Mine =
				Area:FindFirstChild(
					"Mine"
				)

			local BlocksArea =
				Mine
				and Mine:FindFirstChild(
					"BlocksArea"
				)

			if BlocksArea
				and BlocksArea:IsA(
					"BasePart"
				) then

				return Area
			end
		end

		task.wait(0.1)
	end

	return nil
end

local function TeleportToAreaMine(
	AreaName
)
	local Area =
		WaitForAreaRendered(
			AreaName,
			10
		)

	if not Area then
		return false
	end

	local Mine =
		Area:FindFirstChild(
			"Mine"
		)

	local BlocksArea =
		Mine
		and Mine:FindFirstChild(
			"BlocksArea"
		)

	local Root =
		GetRoot()

	if not Root
		or not BlocksArea
		or not BlocksArea:IsA(
			"BasePart"
		) then

		return false
	end

	local Position =
		BlocksArea.Position
		+
		BlocksArea.CFrame.UpVector
		*
		(
			BlocksArea.Size.Y / 2
			+ 6
		)

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Root.CFrame =
		CFrame.new(
			Position,
			Position
			+ BlocksArea.CFrame.LookVector
		)

	-- MineAreaEngine swaps the active rendered mine into the
	-- same ClientMineBlocks folder when the new zone is entered.
	local Deadline =
		os.clock() + 6

	while os.clock() < Deadline do
		if GetCurrentAreaName()
			== AreaName
			and IsInMine() then

			ClearReservations()
			table.clear(
				PendingBombs
			)

			RejectStreak = 0
			LastFarmProgress =
				os.clock()

			return true
		end

		task.wait(0.1)
	end

	return false
end

local function PurchaseNextArea()
	if AreaPurchaseBusy
		or RefillBusy
		or RebirthBusy
		or BombShopBusy
		or BombShopTripBusy
		or MineReturnBusy then

		return false
	end

	local NextArea =
		GetNextAreaToBuy()

	if not NextArea then
		return false
	end

	local Price =
		GetAreaPrice(
			NextArea
		)

	local Money =
		tonumber(
			SafeRawGet(
				Session,
				"Money"
			)
		) or 0

	if not Price
		or Money < Price then

		return false
	end

	AreaPurchaseBusy = true

	-- Pause creation of new TNT while the area renderer swaps
	-- the shared ClientMineBlocks contents.
	FarmBusy = false

	local Ok, Result =
		pcall(function()
			return ClientAction:InvokeServer({
				"PurchaseArea",
				{
					NextArea
				}
			})
		end)

	if not Ok
		or (
			typeof(Result) == "table"
			and Result.Success == false
		) then

		AreaPurchaseBusy = false
		return false
	end

	-- Allow normal player-data replication first.
	task.wait(0.2)

	local Confirmed =
		OwnsArea(
			NextArea
		)
		or (
			typeof(Result) == "table"
			and Result.Success == true
		)

	if not Confirmed then
		AreaPurchaseBusy = false
		return false
	end

	-- If the server confirmed success but the local session copy
	-- hasn't updated yet, mirror it so area/UI listeners refresh.
	if not OwnsArea(
		NextArea
	) then

		MirrorOwnedArea(
			NextArea
		)
	end

	pcall(function()
		Signals.Fire(
			"OwnedAreasChanged",
			Session,
			SafeRawGet(
				Session,
				"OwnedAreas"
			)
		)
	end)

	-- Wait for AreaPurchaseEngine/AreaRenderer to create the new
	-- area, then enter its mine. ClientMineBlocks will repopulate
	-- automatically for that area.
	task.wait(0.25)

	local Entered =
		TeleportToAreaMine(
			NextArea
		)

	AreaPurchaseBusy = false

	return Entered
end

--========================================================
-- BOMB SHOP
-- The playtest only reliably accepts BuyBomb after the
-- player has been in the lobby/shop area briefly.
--
-- Flow:
-- 1. Pause automation.
-- 2. Let current TNT finish.
-- 3. Teleport to BombShop PromptPart.
-- 4. Wait ~2 seconds.
-- 5. Buy best affordable TNT.
-- 6. Equip it.
-- 7. Refresh local shop/hotbar state.
-- 8. Return to the mine and resume everything.
--========================================================

local SortedBombs = {}

for Name, Config in pairs(BombsConfig) do
	if Name ~= "Default"
		and typeof(Config) == "table" then

		SortedBombs[#SortedBombs + 1] = {
			Name = Name,
			Price = tonumber(Config.Price) or 0,
			Damage = tonumber(Config.DamagePerClick) or 0,
		}
	end
end

table.sort(SortedBombs, function(A, B)
	if A.Damage ~= B.Damage then
		return A.Damage > B.Damage
	end

	return A.Price > B.Price
end)

local function OwnsBomb(Name)
	return CallSession(
		"OwnsBomb",
		Name
	) == true
end

local function GetBestOwnedBomb()
	for _, Bomb in ipairs(SortedBombs) do
		if OwnsBomb(Bomb.Name) then
			return Bomb
		end
	end

	return nil
end

local function GetBestAffordableUnownedBomb()
	local Money =
		tonumber(
			SafeRawGet(
				Session,
				"Money"
			)
		) or 0

	for _, Bomb in ipairs(SortedBombs) do
		if Bomb.Price <= Money
			and not OwnsBomb(Bomb.Name) then

			return Bomb
		end
	end

	return nil
end

local function InvokeBombAction(Action, Name)
	local Ok, Result =
		pcall(function()
			return ClientAction:InvokeServer({
				Action,
				{
					Name
				}
			})
		end)

	if not Ok then
		warn(
			"[BOMB SHOP]",
			Action,
			Name,
			Result
		)

		return nil
	end

	return Result
end

local function MirrorOwnedBomb(Name)
	local OwnedBombs =
		SafeRawGet(
			Session,
			"OwnedBombs"
		)

	if typeof(OwnedBombs) ~= "table" then
		return
	end

	local ArrayStyle = false

	for Key, Value in pairs(OwnedBombs) do
		if typeof(Key) == "number"
			and typeof(Value) == "string" then

			ArrayStyle = true
			break
		end
	end

	if ArrayStyle then
		if not table.find(
			OwnedBombs,
			Name
		) then

			table.insert(
				OwnedBombs,
				Name
			)
		end
	else
		OwnedBombs[Name] = true
	end
end

local function MirrorEquippedBomb(Name)
	if SafeRawGet(
		Session,
		"EquippedBomb"
	) ~= Name then

		pcall(function()
			rawset(
				Session,
				"EquippedBomb",
				Name
			)
		end)
	end
end

local function RefreshBombUi(Action, Name)
	pcall(function()
		if Action == "BuyBomb" then
			Signals.Fire(
				"BombGranted",
				Name
			)

			Signals.Fire(
				"OwnedBombsChanged",
				Name
			)
		end

		if Action == "EquipBomb" then
			Signals.Fire(
				"EquippedBombChanged",
				Name
			)
		end
	end)
end

local function WaitUntilNoActiveBombs(Timeout)
	local Deadline =
		os.clock()
		+ (Timeout or 8)

	while os.clock() < Deadline do
		RefreshPendingBombs()

		if EffectiveActiveCount() <= 0 then
			return true
		end

		task.wait(0.1)
	end

	-- Do not let stale local pending state permanently block a shop trip.
	table.clear(PendingBombs)

	return
		EffectiveActiveCount() <= 0
end

local function GetBombShopPromptPart()
	local Map =
		workspace:FindFirstChild(
			"Map"
		)

	local Lobby =
		Map
		and Map:FindFirstChild(
			"Lobby"
		)

	local Shop =
		Lobby
		and Lobby:FindFirstChild(
			"BombShop"
		)

	local PromptPart =
		Shop
		and Shop:FindFirstChild(
			"PromptPart"
		)

	if PromptPart
		and PromptPart:IsA(
			"BasePart"
		) then

		return PromptPart
	end

	return nil
end

local function GoToBombShop()
	local Root =
		GetRoot()

	local PromptPart =
		GetBombShopPromptPart()

	if not Root
		or not PromptPart then

		return false
	end

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Root.CFrame =
		PromptPart.CFrame
		* CFrame.new(
			0,
			3,
			-4
		)

	-- Leaving a mine resets ActiveBombs and switches the player's
	-- area state. The playtest appears to need a short lobby dwell
	-- before BuyBomb is accepted reliably.
	task.wait(
		BOMB_SHOP_LOBBY_WAIT
	)

	return true
end

local function WaitForBombOwned(Name, Timeout)
	local Deadline =
		os.clock()
		+ (Timeout or 3)

	while os.clock() < Deadline do
		if OwnsBomb(Name) then
			return true
		end

		task.wait(0.1)
	end

	return false
end

local function WaitForBombEquipped(Name, Timeout)
	local Deadline =
		os.clock()
		+ (Timeout or 3)

	while os.clock() < Deadline do
		if SafeRawGet(
			Session,
			"EquippedBomb"
		) == Name then

			return true
		end

		task.wait(0.1)
	end

	return false
end

local function BuyBombAtShop(Name)
	local Result =
		InvokeBombAction(
			"BuyBomb",
			Name
		)

	if typeof(Result) == "table"
		and Result.Success == false then

		return false
	end

	local Confirmed =
		WaitForBombOwned(
			Name,
			3
		)

	if not Confirmed
		and typeof(Result) == "table"
		and Result.Success == true then

		-- Server confirmed the purchase but this client's session
		-- copy has not caught up yet.
		MirrorOwnedBomb(
			Name
		)

		Confirmed = true
	end

	if Confirmed then
		RefreshBombUi(
			"BuyBomb",
			Name
		)
	end

	return Confirmed
end

local function EquipBombAtShop(Name)
	if not OwnsBomb(Name) then
		return false
	end

	if SafeRawGet(
		Session,
		"EquippedBomb"
	) == Name then

		return true
	end

	local Result =
		InvokeBombAction(
			"EquipBomb",
			Name
		)

	if typeof(Result) == "table"
		and Result.Success == false then

		return false
	end

	local Confirmed =
		WaitForBombEquipped(
			Name,
			3
		)

	if not Confirmed
		and typeof(Result) == "table"
		and Result.Success == true then

		MirrorEquippedBomb(
			Name
		)

		Confirmed = true
	end

	if Confirmed then
		MirrorEquippedBomb(
			Name
		)

		RefreshBombUi(
			"EquipBomb",
			Name
		)
	end

	return Confirmed
end

local function ReturnAfterBombShop(
	PreviousArea,
	PreviousCFrame
)
	-- Prefer returning to the highest owned mine because a purchase
	-- may have happened alongside an area unlock.
	local TargetArea =
		GetOwnedArea()
		or PreviousArea

	if TargetArea then
		local Entered =
			TeleportToAreaMine(
				TargetArea
			)

		if Entered then
			return true
		end
	end

	-- Fallback to the precise position we had before the shop trip.
	local Root =
		GetRoot()

	if Root
		and PreviousCFrame then

		Root.AssemblyLinearVelocity =
			Vector3.zero

		Root.AssemblyAngularVelocity =
			Vector3.zero

		Root.CFrame =
			PreviousCFrame

		task.wait(0.35)

		return true
	end

	return false
end

local function RunBombShopTrip()
	if BombShopTripBusy
		or BombShopBusy
		or RefillBusy
		or RebirthBusy
		or AreaPurchaseBusy
		or MineReturnBusy
		or os.clock() < BombShopRetryAt then

		return false
	end

	local BombToBuy =
		AutoBuyBestBomb
		and GetBestAffordableUnownedBomb()
		or nil

	local BestOwned =
		AutoEquipBestBomb
		and GetBestOwnedBomb()
		or nil

	local NeedsEquip =
		BestOwned
		and SafeRawGet(
			Session,
			"EquippedBomb"
		) ~= BestOwned.Name

	if not BombToBuy
		and not NeedsEquip then

		return false
	end

	BombShopTripBusy = true

	-- Stop new work from all automation loops.
	FarmBusy = false
	CollectBusy = false

	-- Let placed TNT finish so leaving the mine does not strand
	-- the active-bomb bookkeeping.
	WaitUntilNoActiveBombs(
		8
	)

	local Root =
		GetRoot()

	local PreviousCFrame =
		Root
		and Root.CFrame
		or nil

	local PreviousArea =
		GetCurrentAreaName()
		or GetOwnedArea()

	if not GoToBombShop() then
		BombShopRetryAt =
			os.clock() + 3

		BombShopTripBusy = false

		return false
	end

	BombShopBusy = true
	BombShopBusySince =
		os.clock()

	local DidWork = false

	-- Re-evaluate after reaching the lobby because money or ownership
	-- may have updated while the farm was winding down.
	if AutoBuyBestBomb then
		BombToBuy =
			GetBestAffordableUnownedBomb()

		if BombToBuy then
			if BuyBombAtShop(
				BombToBuy.Name
			) then

				DidWork = true

				if AutoEquipBestBomb then
					task.wait(0.1)

					EquipBombAtShop(
						BombToBuy.Name
					)
				end
			end
		end
	end

	if AutoEquipBestBomb then
		BestOwned =
			GetBestOwnedBomb()

		if BestOwned
			and SafeRawGet(
				Session,
				"EquippedBomb"
			) ~= BestOwned.Name then

			if EquipBombAtShop(
				BestOwned.Name
			) then

				DidWork = true
			end
		end
	end

	BombShopBusy = false
	BombShopBusySince = 0

	-- Make sure the shop/hotbar listeners have processed the changes.
	task.wait(0.25)

	ReturnAfterBombShop(
		PreviousArea,
		PreviousCFrame
	)

	ClearReservations()
	table.clear(PendingBombs)

	RejectStreak = 0
	LastFarmProgress =
		os.clock()

	-- Small settle time after MineAreaEngine swaps ClientMineBlocks.
	task.wait(0.35)

	BombShopTripBusy = false

	if not DidWork then
		BombShopRetryAt =
			os.clock() + 2
	end

	return DidWork
end

local function EquipBestBomb()
	if not AutoEquipBestBomb then
		return false
	end

	return RunBombShopTrip()
end

local function BuyBestAffordableBomb()
	if not AutoBuyBestBomb then
		return false
	end

	return RunBombShopTrip()
end

