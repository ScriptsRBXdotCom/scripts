--========================================================
-- SAFE SESSION HELPERS
--========================================================

local function SafeRawGet(Object, Key)
	if typeof(Object) ~= "table" then
		return nil
	end

	local Ok, Value = pcall(rawget, Object, Key)

	if Ok then
		return Value
	end

	return nil
end

local function GetMetaSafe(Object)
	local Ok, Result = pcall(function()
		if getrawmetatable then
			return getrawmetatable(Object)
		end

		return getmetatable(Object)
	end)

	return Ok and Result or nil
end

local function GetMethodRaw(Object, Name)
	if typeof(Object) ~= "table" then
		return nil
	end

	local Direct = SafeRawGet(Object, Name)

	if type(Direct) == "function" then
		return Direct
	end

	local Meta = GetMetaSafe(Object)

	if typeof(Meta) ~= "table" then
		return nil
	end

	local Index = SafeRawGet(Meta, "__index")

	if typeof(Index) == "table" then
		local Method = SafeRawGet(Index, Name)

		if type(Method) == "function" then
			return Method
		end
	end

	return nil
end

local function LooksLikeSession(Object)
	if typeof(Object) ~= "table" then
		return false
	end

	if SafeRawGet(Object, "HeldBombs") == nil then
		return false
	end

	if SafeRawGet(Object, "ActiveBombs") == nil then
		return false
	end

	if SafeRawGet(Object, "EquippedBomb") == nil then
		return false
	end

	return
		GetMethodRaw(Object, "PlaceBomb") ~= nil
		and GetMethodRaw(Object, "IgniteBomb") ~= nil
		and GetMethodRaw(Object, "IsInMineArea") ~= nil
end

local function FindSession()
	if getgc then
		local Ok, Objects = pcall(getgc, true)

		if Ok and typeof(Objects) == "table" then
			for _, Object in ipairs(Objects) do
				local Success, Match = pcall(
					LooksLikeSession,
					Object
				)

				if Success and Match then
					return Object
				end
			end
		end
	end

	if getreg then
		local Ok, Registry = pcall(getreg)

		if Ok and typeof(Registry) == "table" then
			for _, Object in pairs(Registry) do
				local Success, Match = pcall(
					LooksLikeSession,
					Object
				)

				if Success and Match then
					return Object
				end
			end
		end
	end

	return nil
end

local Session

repeat
	Session = FindSession()

	if not Session then
		task.wait(0.5)
	end
until Session

local function CallSession(Name, ...)
	local Method = GetMethodRaw(Session, Name)

	if type(Method) ~= "function" then
		return nil
	end

	local Args = table.pack(...)

	local Ok, Result = pcall(function()
		return Method(
			Session,
			table.unpack(Args, 1, Args.n)
		)
	end)

	if not Ok then
		warn("[SESSION]", Name, Result)
		return nil
	end

	return Result
end

