task.spawn(function()
	while true do
		if AutoFarm then
			if not IsInMine()
				and not RefillBusy
				and not RebirthBusy
				and not MineReturnBusy
				and not BombShopBusy
				and not BombShopTripBusy
				and not AreaPurchaseBusy then

				ReturnToMineIfNeeded()
			end

			if IsInMine()
				and not BombShopBusy
				and not BombShopTripBusy
				and not AreaPurchaseBusy then

				FarmTick()
			end

			task.wait(FARM_DELAY)

		else
			task.wait(0.2)
		end
	end
end)

