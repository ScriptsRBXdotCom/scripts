local function GetAreaModel(AreaName)
	local Map =
		workspace:FindFirstChild("Map")

	local Areas =
		Map
		and Map:FindFirstChild("Areas")

	if not Areas then
		return nil
	end

	for _, Area in ipairs(
		Areas:GetChildren()
	) do
