local function GetRoot()
	local Character = Player.Character

	return Character
		and Character:FindFirstChild("HumanoidRootPart")
end

local function IsInMine()
	return CallSession("IsInMineArea") == true
end

local function GetCurrentAreaName()
	local Ok, AreaName = pcall(function()
		return MineStateService.GetAreaName()
	end)

	if Ok and AreaName then
		return AreaName
	end

	return nil
end

local function GetOwnedArea()
	local OwnedAreas =
		SafeRawGet(
			Session,
			"OwnedAreas"
		)

	if typeof(OwnedAreas) ~= "table" then
		return nil
	end

	-- Always return the highest progression area, not an
	-- arbitrary pairs() entry.
	local Ordered =
		AreasConfig.GetOrderedNames()

	for Index = #Ordered, 1, -1 do
		local AreaName =
			Ordered[Index]

		if OwnedAreas[AreaName] then
			return AreaName
		end

		-- Support array-style ownership too.
		if table.find(
			OwnedAreas,
			AreaName
		) then

			return AreaName
		end
	end

	return nil
end

local function OwnsArea(AreaName)
	local OwnedAreas =
		SafeRawGet(
			Session,
			"OwnedAreas"
		)

	if typeof(OwnedAreas) ~= "table" then
		return false
	end

	return
		OwnedAreas[AreaName] == true
		or table.find(
			OwnedAreas,
			AreaName
		) ~= nil
end

