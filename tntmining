-- UPGRADES
--========================================================

local function BuyUpgrade(Name)
	local Result =
		CallSession(
			"BuyUpgrade",
			Name
		)

	return
		typeof(Result) == "table"
		and Result.Success == true
end

local function BuyMineLuck()
