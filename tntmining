--========================================================

local function GetLobbySpawn()
	local Map =
		workspace:FindFirstChild("Map")

	local Lobby =
		Map
		and Map:FindFirstChild("Lobby")

	local Spawn =
		Lobby
		and Lobby:FindFirstChild(
			"SpawnLocation"
		)

	return Spawn
end

local function RefillBombs()
	if RefillBusy
		or BombShopTripBusy
		or not AutoRefill
		or not IsInMine() then

		return false
	end

	local Held =
		tonumber(
			SafeRawGet(
				Session,
				"HeldBombs"
			)
		) or 0

	if Held > 0 then
		return true
	end

	if os.clock()
		- LastFailedRefill < 5 then

		return false
	end

	local Root = GetRoot()
	local Spawn = GetLobbySpawn()

	if not Root
		or not Spawn
		or not Spawn:IsA("BasePart") then

		return false
	end

	RefillBusy = true
	FarmBusy = false

	Root.AssemblyLinearVelocity =
		Vector3.zero

	Root.AssemblyAngularVelocity =
		Vector3.zero

	Root.CFrame =
		Spawn.CFrame
		* CFrame.new(0, 4, 0)

	local LeaveTimeout =
		os.clock() + 4

	while os.clock() < LeaveTimeout do
		if not IsInMine() then
			break
		end

		task.wait(0.1)
	end

	if IsInMine() then
		LastFailedRefill = os.clock()
		RefillBusy = false

		return false
	end

	if AutoSell then
		SellBlocks()
	end

	local RefillTimeout =
		os.clock() + 10

	while os.clock() < RefillTimeout do
		local Current =
			tonumber(
				SafeRawGet(
					Session,
					"HeldBombs"
				)
			) or 0

		if Current > 0 then
			ClearReservations()
			table.clear(PendingBombs)

			RejectStreak = 0
			RefillBusy = false

			if AutoFarm then
				task.wait(0.25)

				ReturnToMineIfNeeded()
			end

			return true
		end

		task.wait(0.4)
	end

	LastFailedRefill = os.clock()
	RefillBusy = false

	return false
end

--========================================================
-- FARM
--========================================================

local function RecoverFarmState()
	if os.clock() - LastFarmRecovery < 2 then
		return
	end

	LastFarmRecovery = os.clock()

	ClearReservations()
	table.clear(PendingBombs)
	RejectStreak = 0
	FarmBusy = false

	-- Never let a stale shop lock freeze the mine forever.
	if BombShopBusy
		and BombShopBusySince > 0
		and os.clock() - BombShopBusySince > 3 then

		BombShopBusy = false
		BombShopBusySince = 0
	end

	ValidatePlayerPosition()

	if AutoFarm
		and not IsInMine()
		and not RefillBusy
		and not RebirthBusy then

		task.spawn(
			ReturnToMineIfNeeded
		)
	end
end

local function FarmTick()
	if not AutoFarm
		or FarmBusy
		or RefillBusy
		or RebirthBusy
		or MineReturnBusy
		or BombShopBusy
		or AreaPurchaseBusy then

		return
	end

	if not IsInMine() then
		RecoverFarmState()
		return
	end

	ValidatePlayerPosition()

	local Held =
		tonumber(
			SafeRawGet(
				Session,
				"HeldBombs"
			)
		) or 0

	if Held <= 0 then
		if AutoRefill then
			task.spawn(
				RefillBombs
			)
		end

		return
	end

	RefreshPendingBombs()

	if EffectiveActiveCount()
		>= MaxActiveBombs() then

		return
	end

	FarmBusy = true

	local Block =
		GetNextBombBlock()

	if not Block then
		FarmBusy = false

		-- Mine regenerated / client block list changed.
		-- Clear stale reservations instead of getting stuck.
		if os.clock() - LastFarmProgress > 1.5 then
			RecoverFarmState()
		end

		return
	end

	ReserveBlock(
		Block,
		1.5
	)

	local Id =
		PlaceBomb(Block)

	if Id then
		RejectStreak = 0

		ReserveBlock(
			Block,
			3
		)

		IgniteBomb(Id)

	else
		ReserveBlock(
			Block,
			0.35
		)

		RejectStreak += 1

		-- If a batch of placements is rejected, reset the
		-- local bookkeeping immediately. Do not refill unless
		-- HeldBombs is actually zero.
		if RejectStreak >= 5 then
			RecoverFarmState()
		end
	end

	FarmBusy = false
end

--========================================================
-- COLLECT
--========================================================

local function GetCollectiblePosition(Object)
	if Object:IsA("BasePart") then
		return Object.Position
	end

	if Object:IsA("Model") then
		return Object:GetPivot().Position
	end

	local Part =
		Object:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	return Part and Part.Position
end

local function CollectOne(Id)
	local Result =
		CallSession(
			"CollectBlocks",
			{ Id },
			true
		)

	if typeof(Result) == "table" then
		if Result.Success
			and GetMethodRaw(
				Session,
				"ApplyCollectedBlocks"
			) then

			CallSession(
				"ApplyCollectedBlocks",
				Result
			)
		end

		return Result.Success == true
	end

	return false
end

local function CollectEverything()
	if not AutoCollect
		or CollectBusy
		or RefillBusy
		or RebirthBusy
		or MineReturnBusy
		or BombShopBusy
		or BombShopTripBusy
		or not IsInMine() then

		return
	end

	CollectBusy = true

	local Folder =
		workspace:FindFirstChild(
			"ClientCollectibleBlocks"
		)

	local Root = GetRoot()

	if not Folder or not Root then
		CollectBusy = false
		return
	end

	local ReturnCFrame =
		Root.CFrame

	local Items = {}

	for _, Object in ipairs(
		Folder:GetChildren()
	) do
		if string.find(
			Object.Name,
			":",
			1,
			true
		) then

			local Position =
				GetCollectiblePosition(Object)

			if Position then
				Items[#Items + 1] = {
					Id = Object.Name,
					Position = Position,
				}
			end
		end
	end

	for _, Item in ipairs(Items) do
		if not AutoCollect
			or not IsInMine()
			or RefillBusy
			or RebirthBusy
			or MineReturnBusy
			or BombShopBusy then

			break
		end

		local CurrentFolder =
			workspace:FindFirstChild(
				"ClientCollectibleBlocks"
			)

		local Object =
			CurrentFolder
			and CurrentFolder
				:FindFirstChild(Item.Id)

		if Object then
			Root = GetRoot()

			local Position =
				GetCollectiblePosition(Object)

			if Root and Position then
				Root.AssemblyLinearVelocity =
					Vector3.zero

				Root.AssemblyAngularVelocity =
					Vector3.zero

				Root.CFrame =
					CFrame.new(
						Position
						+ Vector3.new(
							0,
							2.5,
							0
						)
					)

				task.wait(
					COLLECT_MOVE_DELAY
				)

				CollectOne(Item.Id)

				task.wait(0.035)
			end
		end
	end

	Root = GetRoot()

	if Root
		and IsInMine()
		and not RefillBusy then

		Root.AssemblyLinearVelocity =
			Vector3.zero

		Root.CFrame =
			ReturnCFrame

		task.wait(0.1)

		ValidatePlayerPosition()
	end

	CollectBusy = false
end

--========================================================
-- REBIRTH
--========================================================

local function PerformRebirth()
	if RebirthBusy
		or RefillBusy
		or BombShopBusy
		or BombShopTripBusy
		or AreaPurchaseBusy then

		return false
	end

	RebirthBusy = true
	FarmBusy = false

	local Result =
		CallSession(
			"PerformRebirth"
		)

	if typeof(Result) == "table"
		and Result.Success then

		ClearReservations()
		table.clear(PendingBombs)

		RejectStreak = 0

		task.wait(1)

		RebirthBusy = false

		if AutoFarm then
			task.spawn(
				ReturnToMineIfNeeded
			)
		end

		return true
	end

	RebirthBusy = false

	return false
end

