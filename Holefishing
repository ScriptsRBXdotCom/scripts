--========================================================--
-- HELPERS
--========================================================--

local function round1(number)
    return math.floor(number * 10 + 0.5) / 10
end

local function safeFire(remote, ...)
    local args = {...}

    local ok, err = pcall(function()
        remote:FireServer(table.unpack(args))
    end)

    if not ok then
        warn("[Remote Error]", err)
    end

    return ok
end

local function safeInvoke(remote, ...)
    local args = {...}

    local ok, result = pcall(function()
        return remote:InvokeServer(table.unpack(args))
    end)

    if not ok then
        warn("[Invoke Error]", result)
    end

    return ok, result
end

local function getFishScale(fishName, kg)
    local config = FishConfig[fishName]

    if not config then
        return 1
    end

    if
        not config.minKg
        or not config.maxKg
        or not config.minScale
        or not config.maxScale
    then
        return config.maxScale or config.minScale or 1
    end

    local percent =
        (kg - config.minKg)
        / math.max(
            1,
            config.maxKg - config.minKg
        )

    return
        config.minScale
        + percent
        * (config.maxScale - config.minScale)
end

local function randomWeight(fishName)
    local config = FishConfig[fishName]

    if not config then
        return 1
    end

    local minKg = config.minKg or 1
    local maxKg = config.maxKg or minKg

    return round1(
        minKg
        + math.random()
        * (maxKg - minKg)
    )
end

--========================================================--
-- FISH DROPDOWN LIST
--========================================================--

local FishOptions = {}
local DisplayToFish = {}

for fishName, data in pairs(FishConfig) do

    local rarity =
        data.rarity
        or data.Rarity
        or "Unknown"

    local display =
        string.format(
            "%s  [%s]",
            fishName,
            rarity
        )

    table.insert(
        FishOptions,
        display
    )

    DisplayToFish[display] =
        fishName
end

table.sort(FishOptions)

--========================================================--
-- SELECTED FISH STATE
--========================================================--

local firstDisplay = FishOptions[1]

local selectedFish =
    firstDisplay
    and DisplayToFish[firstDisplay]
    or "Emberfin"

local selectedMutation = ""

local selectedKg = 1
local selectedScale = 1

local spawnCount = 1

local function setFishToMaximum()
    local config =
        FishConfig[selectedFish]

    if not config then
        return
    end

    selectedKg =
        config.maxKg
        or config.minKg
        or 1

    selectedScale =
        config.maxScale
        or getFishScale(
            selectedFish,
            selectedKg
        )
end

setFishToMaximum()

--========================================================--
-- SPAWNER
--========================================================--

local function spawnSelectedFish()
    CaughtFish:FireServer(
        selectedFish,
        selectedKg,
        selectedMutation,
        selectedScale,
        false
    )
end

local function printSelectedFish()
    local config =
        FishConfig[selectedFish]

    if not config then
        return
    end

    print("================================")
    print("Fish:", selectedFish)
    print(
        "Rarity:",
        config.rarity
        or config.Rarity
        or "Unknown"
    )

    print(
        "Weight:",
        selectedKg
    )

    print(
        "Scale:",
        selectedScale
    )

    print(
        "Configured KG:",
        config.minKg,
        "->",
        config.maxKg
    )

    print(
        "Configured Scale:",
        config.minScale,
        "->",
        config.maxScale
    )

    print(
        "Price / KG:",
        config.pricePerKg
    )

    print(
        "Night:",
        config.night
    )

    print(
        "Mutation:",
        selectedMutation == ""
        and "None"
        or selectedMutation
    )

    print("================================")
end

