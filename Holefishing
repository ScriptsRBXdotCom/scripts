    })

FishTab:CreateDropdown({
    name = "Fish Name + Rarity",

    options = FishOptions,

    value = firstDisplay,

    callback = function(displayName)

        local fishName =
            DisplayToFish[displayName]

        if not fishName then
            return
        end

        selectedFish = fishName

        -- Automatically use maximum stats
        -- when another fish is selected.

        setFishToMaximum()

        printSelectedFish()
    end
})

FishTab:CreateDropdown({
    name = "Mutation",

    options = {
        "None",
        "Big",
        "Huge",
        "Big,Huge"
    },

    value = "None",

    callback = function(value)

        if value == "None" then
            selectedMutation = ""
        else
            selectedMutation = value
        end
    end
})

FishTab:CreateInput({
    name = "Amount",

    placeholder = "1",

    numeric = true,

    callback = function(value)

        local number =
            tonumber(value)

        if not number then
            return
        end

        spawnCount =
            math.clamp(
                math.floor(number),
                1,
                10
            )
    end
})

FishTab:CreateButton({
    name = "Spawn Selected Fish",

    callback = function()

        for i = 1, spawnCount do

            spawnSelectedFish()

            if i < spawnCount then
                task.wait(0.2)
            end
        end
    end
})

FishTab:CreateButton({
    name = "Spawn Maximum Fish",

    callback = function()

        setFishToMaximum()

        for i = 1, spawnCount do

            spawnSelectedFish()

            if i < spawnCount then
                task.wait(0.2)
            end
        end
    end
})

FishTab:CreateButton({
    name = "Spawn Random Legit Weight",

    callback = function()

        for i = 1, spawnCount do

            selectedKg =
                randomWeight(selectedFish)

            selectedScale =
                getFishScale(
                    selectedFish,
                    selectedKg
                )

            spawnSelectedFish()

            if i < spawnCount then
                task.wait(0.2)
            end
        end
    end
})

FishTab:CreateButton({
    name = "Print Fish Information",

    callback = function()
        printSelectedFish()
    end
})

