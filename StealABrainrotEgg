--//========================================================
--// Teleport Tab - Zone Selection
--//========================================================

TeleportTab:CreateSection({
    name = "Zones"
})

local zones = getZones()

local SelectedZone =
    zones[1]
    and zones[1].Number
    or 1

local SelectedNest = 1

local ZoneDropdown
local NestDropdown

ZoneDropdown = TeleportTab:CreateDropdown({
    name = "Select Zone",

    description = "Choose the zone you want to visit.",

    options = buildZoneOptions(),

    value = "Zone " .. tostring(SelectedZone),

    flag = "SelectedZone",

    callback = function(selected)
        if typeof(selected) ~= "string" then
            return
        end

        local number = tonumber(
            selected:match("%d+")
        )

        if not number then
            return
        end

        SelectedZone = number
        SelectedNest = 1

        if NestDropdown then
            local options =
                buildNestOptions(SelectedZone)

            NestDropdown:Refresh(options)

            if options[1]
                and options[1] ~= "No Egg Nests Found" then

                NestDropdown:Set(
                    options[1],
                    true
                )
            end
        end
    end
})

TeleportTab:CreateButton({
    name = "Teleport to Selected Zone",

    description = "Teleports to the currently selected zone.",

    callback = function()
        teleportToZone(SelectedZone)
    end
})

--//========================================================
--// Teleport Tab - Eggs In Selected Zone
--//========================================================

TeleportTab:CreateSection({
    name = "Eggs In Selected Zone"
})

NestDropdown = TeleportTab:CreateDropdown({
    name = "Select Egg Nest",

    description = "Choose an egg nest inside the selected zone.",

    options = buildNestOptions(SelectedZone),

    value = "Egg Nest #1",

    flag = "SelectedEggNest",

    callback = function(selected)
        if typeof(selected) ~= "string" then
            return
        end

        local number = tonumber(
            selected:match("%d+")
        )

        if number then
            SelectedNest = number
        end
    end
})

TeleportTab:CreateButton({
    name = "Teleport to Selected Egg",

    description = "Teleports to the selected egg nest.",

    callback = function()
        teleportToNest(
            SelectedZone,
            SelectedNest
        )
    end
})

TeleportTab:CreateButton({
    name = "Nearest Egg in Selected Zone",

    description = "Teleports to the closest egg nest in this zone.",

    callback = function()
        local root = getRoot()

        if not root then
            return
        end

        local nests = getEggNests(SelectedZone)

        if #nests == 0 then
            notify(
                "Egg Nests",
                "No egg nests found in Zone "
                    .. tostring(SelectedZone)
            )

            return
        end

        local nearest
        local nearestIndex
        local nearestDistance = math.huge

        for index, nest in ipairs(nests) do
            local position = getPosition(nest)

            if position then
                local distance =
                    (root.Position - position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = nest
                    nearestIndex = index
                end
            end
        end

        if nearest then
            SelectedNest = nearestIndex

            if NestDropdown then
                NestDropdown:Set(
                    "Egg Nest #" .. tostring(nearestIndex),
                    true
                )
            end

            teleportTo(nearest, 4)

            notify(
                "Egg Nests",
                "Zone "
                    .. tostring(SelectedZone)
                    .. " • Egg Nest #"
                    .. tostring(nearestIndex)
            )
        end
    end
})

--//========================================================
--// Egg Navigation
--//========================================================

TeleportTab:CreateSection({
    name = "Egg Navigation"
})

TeleportTab:CreateButton({
    name = "Previous Egg",

    description = "Moves to the previous egg nest in this zone.",

    callback = function()
        local nests = getEggNests(SelectedZone)

        if #nests == 0 then
            notify(
                "Egg Nests",
                "No egg nests found in Zone "
                    .. tostring(SelectedZone)
            )

            return
        end

        SelectedNest -= 1

        if SelectedNest < 1 then
            SelectedNest = #nests
        end

        if NestDropdown then
            NestDropdown:Set(
                "Egg Nest #" .. tostring(SelectedNest),
                true
            )
        end

        teleportToNest(
            SelectedZone,
            SelectedNest
        )
    end
})

TeleportTab:CreateButton({
    name = "Next Egg",

    description = "Moves to the next egg nest in this zone.",

    callback = function()
        local nests = getEggNests(SelectedZone)

        if #nests == 0 then
            notify(
                "Egg Nests",
                "No egg nests found in Zone "
                    .. tostring(SelectedZone)
            )

            return
        end

        SelectedNest += 1

        if SelectedNest > #nests then
            SelectedNest = 1
        end

        if NestDropdown then
            NestDropdown:Set(
                "Egg Nest #" .. tostring(SelectedNest),
                true
            )
        end

        teleportToNest(
            SelectedZone,
            SelectedNest
        )
    end
})

--//========================================================
--// Refresh
--//========================================================

TeleportTab:CreateSection({
    name = "Refresh"
})

TeleportTab:CreateButton({
    name = "Refresh Zones & Eggs",

    description = "Refreshes the zone and egg lists if the map changes.",

    callback = function()
        local zoneOptions = buildZoneOptions()

        ZoneDropdown:Refresh(zoneOptions)

        local currentZoneExists =
            getZone(SelectedZone) ~= nil

        if not currentZoneExists then
            local currentZones = getZones()

            if currentZones[1] then
                SelectedZone =
                    currentZones[1].Number
            end
        end

        ZoneDropdown:Set(
            "Zone " .. tostring(SelectedZone),
            true
        )

        local nestOptions =
            buildNestOptions(SelectedZone)

        NestDropdown:Refresh(nestOptions)

        SelectedNest = 1

        if nestOptions[1]
            and nestOptions[1] ~= "No Egg Nests Found" then

            NestDropdown:Set(
                nestOptions[1],
                true
            )
        end

        notify(
            "Teleports",
            "Zone and egg lists refreshed."
        )
    end
})

