--//========================================================
--// Character Utilities
--//========================================================

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getRoot()
    local character = getCharacter()

    return character:FindFirstChild("HumanoidRootPart")
        or character:WaitForChild("HumanoidRootPart", 5)
end

local function getPosition(target)
    if not target then
        return nil
    end

    if target:IsA("BasePart") then
        return target.Position
    end

    if target:IsA("Model") then
        return target:GetPivot().Position
    end

    local part = target:FindFirstChildWhichIsA("BasePart", true)

    if part then
        return part.Position
    end

    return nil
end

local function teleportTo(target, yOffset)
    local root = getRoot()

    if not root or not target then
        return false
    end

    yOffset = yOffset or 5

    local targetCFrame

    if target:IsA("BasePart") then
        targetCFrame = target.CFrame

    elseif target:IsA("Model") then
        targetCFrame = target:GetPivot()

    else
        local part = target:FindFirstChildWhichIsA("BasePart", true)

        if part then
            targetCFrame = part.CFrame
        end
    end

    if not targetCFrame then
        return false
    end

    root.CFrame = targetCFrame * CFrame.new(0, yOffset, 0)

    return true
end

--//========================================================
--// Plot Utilities
--//========================================================

local function getPlotIndex()
    return LocalPlayer:GetAttribute("PlotIndex")
end

local function getNumberedPlot()
    local plots = Workspace:FindFirstChild("Plots")
    local index = getPlotIndex()

    if not plots or index == nil then
        return nil
    end

    return plots:FindFirstChild(tostring(index))
end

local function getOwnedEggPlot()
    return Workspace:FindFirstChild(
        "Plot_" .. LocalPlayer.Name
    )
end

local function getEggHatchFolder()
    local plot = getOwnedEggPlot()

    if not plot then
        return nil
    end

    return plot:FindFirstChild("EggHatch")
end

--//========================================================
--// Egg Hatching
--//========================================================

local function isEggReady(egg)
    if not egg
        or not egg:IsA("Model")
        or egg:GetAttribute("IsEgg") ~= true then

        return false
    end

    local now = Workspace:GetServerTimeNow()

    local readyAt = egg:GetAttribute("ReadyAt")

    if typeof(readyAt) == "number" then
        return now >= readyAt
    end

    local hatchStart = egg:GetAttribute("HatchStartTime")
    local hatchTime = egg:GetAttribute("HatchTime")

    if typeof(hatchStart) == "number"
        and typeof(hatchTime) == "number" then

        return now >= (hatchStart + hatchTime)
    end

    return false
end

local function hatchEgg(egg)
    if not RequestHatch then
        RequestHatch = Events:FindFirstChild("RequestHatch")
    end

    if not RequestHatch then
        return false
    end

    if not egg or not egg.Parent then
        return false
    end

    RequestHatch:FireServer(egg)

    return true
end

local function hatchAllReady()
    local eggHatch = getEggHatchFolder()

    if not eggHatch then
        return 0
    end

    local count = 0

    for _, egg in ipairs(eggHatch:GetChildren()) do
        if isEggReady(egg) then
            if hatchEgg(egg) then
                count += 1
                task.wait(0.15)
            end
        end
    end

    return count
end

--//========================================================
--// Auto Hatch
--//========================================================

local AutoHatch = false
local AutoHatchThread = nil

local function startAutoHatch()
    if AutoHatchThread then
        return
    end

    AutoHatchThread = task.spawn(function()
        while AutoHatch do
            local eggHatch = getEggHatchFolder()

            if eggHatch then
                for _, egg in ipairs(eggHatch:GetChildren()) do
                    if not AutoHatch then
                        break
                    end

                    if isEggReady(egg) then
                        hatchEgg(egg)
                        task.wait(0.2)
                    end
                end
            end

            task.wait(0.5)
        end

        AutoHatchThread = nil
    end)
end

--//========================================================
--// Zone / Egg Nest Utilities
--//========================================================

local EggsFolder = Workspace:WaitForChild("Eggs")

local function extractZoneNumber(name)
    return tonumber(
        string.match(name, "^Zone(%d+)$")
    )
end

local function getZones()
    local zones = {}

    for _, child in ipairs(EggsFolder:GetChildren()) do
        local number = extractZoneNumber(child.Name)

        if number then
            table.insert(zones, {
                Number = number,
                Object = child
            })
        end
    end

    table.sort(zones, function(a, b)
        return a.Number < b.Number
    end)

    return zones
end

local function getZone(zoneNumber)
    return EggsFolder:FindFirstChild(
        "Zone" .. tostring(zoneNumber)
    )
end

local function getEggNests(zoneNumber)
    local zone = getZone(zoneNumber)

    if not zone then
        return {}
    end

    local nests = {}

    for _, child in ipairs(zone:GetChildren()) do
        if child.Name == "EggNest" then
            table.insert(nests, child)
        end
    end

    return nests
end

local function buildZoneOptions()
    local options = {}

    for _, zone in ipairs(getZones()) do
        table.insert(
            options,
            "Zone " .. tostring(zone.Number)
        )
    end

    if #options == 0 then
        table.insert(options, "No Zones Found")
    end

    return options
end

local function buildNestOptions(zoneNumber)
    local nests = getEggNests(zoneNumber)
    local options = {}

    for i = 1, #nests do
        table.insert(
            options,
            "Egg Nest #" .. tostring(i)
        )
    end

    if #options == 0 then
        table.insert(options, "No Egg Nests Found")
    end

    return options
end

--//========================================================
--// Zone Teleport
--//========================================================

local function teleportToZone(zoneNumber)
    local zone = getZone(zoneNumber)

    if not zone then
        notify(
            "Zones",
            "Zone " .. tostring(zoneNumber) .. " was not found."
        )
        return
    end

    local nests = getEggNests(zoneNumber)

    -- Prefer the first egg nest as the zone destination
    if #nests > 0 then
        if teleportTo(nests[1], 5) then
            notify(
                "Zones",
                "Teleported to Zone " .. tostring(zoneNumber)
            )
        end

        return
    end

    -- Otherwise try the zone container itself
    if teleportTo(zone, 5) then
        notify(
            "Zones",
            "Teleported to Zone " .. tostring(zoneNumber)
        )
    else
        notify(
            "Zones",
            "Couldn't find a teleportable object in Zone "
                .. tostring(zoneNumber)
        )
    end
end

local function teleportToNest(zoneNumber, nestIndex)
    local nests = getEggNests(zoneNumber)
    local nest = nests[nestIndex]

    if not nest then
        notify(
            "Egg Nests",
            "Egg Nest #" .. tostring(nestIndex)
                .. " was not found in Zone "
                .. tostring(zoneNumber)
        )

        return false
    end

    if teleportTo(nest, 4) then
        notify(
            "Egg Nests",
            "Zone "
                .. tostring(zoneNumber)
                .. " • Egg Nest #"
                .. tostring(nestIndex)
        )

        return true
    end

    notify(
        "Egg Nests",
        "Couldn't teleport to this egg nest."
    )

    return false
end

