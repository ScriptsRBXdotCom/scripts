--============================================================
-- BASIC HELPERS
--============================================================

local function getMyPlot()

    local plots =
        Workspace:FindFirstChild("Plots")

    if not plots then
        return nil
    end

    for _, plot in ipairs(
        plots:GetChildren()
    ) do

        if plot:GetAttribute(
            "OwnerUserId"
        ) == LP.UserId then

            return plot
        end

    end

    return nil
end

------------------------------------------------------------

local function getRoot()

    local character = LP.Character

    if not character then
        return nil
    end

    return character:
        FindFirstChild("HumanoidRootPart")
end

------------------------------------------------------------

local function battleActive()

    local plot = getMyPlot()

    if not plot then
        return false
    end

    return plot:GetAttribute(
        "BattleEndsAt"
    ) ~= nil
end

--============================================================
-- AUTO COLLECT
--============================================================

local function getIncomeBuilds()

    local output = {}

    local plot = getMyPlot()

    if not plot then
        return output
    end

    local builds =
        plot:FindFirstChild("Builds")

    if not builds then
        return output
    end

    for _, build in ipairs(
        builds:GetChildren()
    ) do

        if build:IsA("Model") then

            local itemId =
                build:GetAttribute("ItemId")

            if itemId then

                local ok, config =
                    pcall(function()

                        return BuildConfig.Get(
                            itemId
                        )

                    end)

                if ok
                    and config
                    and config.Income
                then

                    table.insert(
                        output,
                        build
                    )
                end

            end

        end

    end

    return output
end

------------------------------------------------------------
-- The test confirmed that reaching building:GetPivot()
-- triggers the server-side income collection.
------------------------------------------------------------

local CollectBusy = false

local function collectIncome()

    if CollectBusy then
        return
    end

    if battleActive() then
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    CollectBusy = true

    local originalRoot =
        root.CFrame

    local camera =
        Workspace.CurrentCamera

    local oldCameraType
    local oldCameraCF
    local oldSubject

    --------------------------------------------------------
    -- Keep camera still
    --------------------------------------------------------

    if camera then

        oldCameraType =
            camera.CameraType

        oldCameraCF =
            camera.CFrame

        oldSubject =
            camera.CameraSubject

        camera.CameraType =
            Enum.CameraType.Scriptable

        camera.CFrame =
            oldCameraCF
    end

    --------------------------------------------------------
    -- Collect buildings
    --------------------------------------------------------

    for _, build in ipairs(
        getIncomeBuilds()
    ) do

        if not State.AutoCollect then
            break
        end

        if build.Parent
            and root.Parent
        then

            local pivot =
                build:GetPivot()

            root.CFrame =
                CFrame.new(
                    pivot.Position
                    + Vector3.new(
                        0,
                        2,
                        0
                    )
                )

            if camera
                and oldCameraCF
            then

                camera.CFrame =
                    oldCameraCF
            end

            task.wait(0.16)
        end

    end

    --------------------------------------------------------
    -- Return player
    --------------------------------------------------------

    if root
        and root.Parent
    then

        root.CFrame =
            originalRoot
    end

    task.wait()

    --------------------------------------------------------
    -- Restore camera
    --------------------------------------------------------

    if camera then

        if oldCameraCF then
            camera.CFrame =
                oldCameraCF
        end

        if oldSubject then
            camera.CameraSubject =
                oldSubject
        end

        camera.CameraType =
            oldCameraType
            or Enum.CameraType.Custom
    end

    CollectBusy = false
end

--============================================================
-- AUTO LOCK
--============================================================

local function autoLock()

    if LP:GetAttribute(
        "BaseLocked"
    ) == true then

        return
    end

    local plot = getMyPlot()

    if not plot then
        return
    end

    --------------------------------------------------------
    -- Don't lock during active combat
    --------------------------------------------------------

    if plot:GetAttribute(
        "BattleEndsAt"
    ) ~= nil then

        return
    end

    local cooldownUntil =
        plot:GetAttribute(
            "LockCooldownUntil"
        ) or 0

    if cooldownUntil >
        Workspace:GetServerTimeNow()
    then

        return
    end

    ToggleLock:FireServer()

    task.wait(1)
end

--============================================================
-- AUTO UPGRADE BUILDINGS
--============================================================

local function autoUpgradeBuildings()

    local plot = getMyPlot()

    if not plot then
        return
    end

    local folder =
        plot:FindFirstChild("Builds")

    if not folder then
        return
    end

    for _, build in ipairs(
        folder:GetChildren()
    ) do

        if not State.AutoUpgrade then
            return
        end

        if build:IsA("Model") then

            pcall(function()

                UpgradeBuilding:
                    FireServer(build)

            end)

            task.wait(0.27)
        end

    end
end

