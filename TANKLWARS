local function selectionContains(
    selection,
    itemId
)

    for _, value in pairs(
        selection or {}
    ) do

        if value == itemId then
            return true
        end
    end

    return false
end

------------------------------------------------------------

local function selectedShopItems()

    local selected = {}

    --------------------------------------------------------
    -- BUILDINGS
    --------------------------------------------------------

    for _, itemId in ipairs(
        State.SelectedBuildings
    ) do

        selected[itemId] = true
    end

    --------------------------------------------------------
    -- DEFENSE
    --------------------------------------------------------

    for _, itemId in ipairs(
        State.SelectedDefense
    ) do

        selected[itemId] = true
    end

    --------------------------------------------------------
    -- TANKS
    --------------------------------------------------------

    for _, itemId in ipairs(
        State.SelectedTanks
    ) do

        selected[itemId] = true
    end

    --------------------------------------------------------
    -- Convert set -> array
    --------------------------------------------------------

    local result = {}

    for itemId in pairs(
        selected
    ) do

        table.insert(
            result,
            itemId
        )
    end

    --------------------------------------------------------
    -- Buy cheaper selected items first
    --------------------------------------------------------

    table.sort(
        result,
        function(a, b)

            local priceA =
                BuildConfig.PriceOf(a)
                or 0

            local priceB =
                BuildConfig.PriceOf(b)
                or 0

            return priceA < priceB
        end
    )

    return result
end

--============================================================
-- STOCK CHECK
--============================================================

local function stockFromUI(itemId)

    local playerGui =
        LP:FindFirstChild(
            "PlayerGui"
        )

    if not playerGui then
        return nil
    end

    for _, object in ipairs(
        playerGui:GetDescendants()
    ) do

        if object:IsA("Frame")
            and object.Name == itemId
        then

            local main =
                object:FindFirstChild(
                    "Main"
                )

            local item =
                main
                and main:
                    FindFirstChild(
                        "Item"
                    )

            local stockLabel =
                item
                and item:
                    FindFirstChild(
                        "Stock"
                    )

            if stockLabel
                and stockLabel:
                    IsA("TextLabel")
            then

                local stock =
                    string.match(
                        stockLabel.Text,
                        "%d+"
                    )

                if stock then
                    return tonumber(stock)
                end

            end

        end

    end

    return nil
end

------------------------------------------------------------

local function getStock(itemId)

    local value =
        CurrentStock[itemId]

    if type(value)
        == "number"
    then

        return value
    end

    return stockFromUI(
        itemId
    )
end

--============================================================
-- AUTO BUY SELECTED
--============================================================

local function autoBuySelected()

    local selected =
        selectedShopItems()

    if #selected == 0 then
        return
    end

    for _, itemId in ipairs(
        selected
    ) do

        if not State.AutoBuy then
            return
        end

        ----------------------------------------------------
        -- Does item still exist?
        ----------------------------------------------------

        local config =
            BuildConfig.Get(itemId)

        if not config then
            continue
        end

        ----------------------------------------------------
        -- Rank
        ----------------------------------------------------

        local requiredRank

        pcall(function()

            requiredRank =
                BuildConfig.RankRequired(
                    itemId
                )

        end)

        if requiredRank then

            local rank =
                LP:GetAttribute("Rank")
                or 1

            if rank < requiredRank then
                continue
            end

        end

        ----------------------------------------------------
        -- STOCK
        ----------------------------------------------------

        local stock =
            getStock(itemId)

        if stock ~= nil
            and stock <= 0
        then

            continue
        end

        ----------------------------------------------------
        -- CASH
        ----------------------------------------------------

        local price =
            BuildConfig.PriceOf(
                itemId
            )

        local cash =
            LP:GetAttribute("Cash")
            or 0

        if price
            and cash < price
        then

            continue
        end

        ----------------------------------------------------
        -- BUY EXACT SELECTED ITEM
        ----------------------------------------------------

        print(
            "[AUTO BUY]",
            itemId,
            "Stock:",
            stock,
            "Price:",
            price
        )

        BuyItem:FireServer(
            itemId
        )

        ----------------------------------------------------
        -- Local cache estimate until ShopStock updates
        ----------------------------------------------------

        if stock
            and stock > 0
        then

            CurrentStock[itemId] =
                stock - 1
        end

        task.wait(0.20)
    end
end

