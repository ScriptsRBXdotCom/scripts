local function inventoryCounts()

    local counts = {}

    local function scan(container)

        if not container then
            return
        end

        for _, object in ipairs(
            container:GetChildren()
        ) do

            if object:IsA("Tool") then

                local itemId =
                    object:GetAttribute(
                        "ItemId"
                    )

                if itemId
                    and BuildConfig.Get(
                        itemId
                    )
                then

                    counts[itemId] =
                        (
                            counts[itemId]
                            or 0
                        ) + 1
                end

            end

        end
    end

    scan(
        LP:FindFirstChildOfClass(
            "Backpack"
        )
    )

    scan(LP.Character)

    return counts
end

------------------------------------------------------------

local function inventoryCount(
    itemId
)

    return
        inventoryCounts()[itemId]
        or 0
end

--============================================================
-- AUTO PLACE
--============================================================

local function placedCount(category)

    local plot = getMyPlot()

    if not plot then
        return 0
    end

    local folderName =
        category == "Tank"
        and "Tanks"
        or "Builds"

    local folder =
        plot:FindFirstChild(
            folderName
        )

    if not folder then
        return 0
    end

    local count = 0

    for _, object in ipairs(
        folder:GetChildren()
    ) do

        if object:IsA("Model")
            and not object:GetAttribute(
                "_Optimistic"
            )
        then

            count += 1
        end

    end

    return count
end

