local function findFreePosition(itemId)

    local plot = getMyPlot()

    if not plot then
        return nil
    end

    local main =
        plot:FindFirstChild(
            "MainPlotPart"
        )

    if not main then
        return nil
    end

    local config =
        BuildConfig.Get(itemId)

    local template =
        templateFor(itemId)

    if not config
        or not template
    then

        return nil
    end

    local footprintCF,
          footprintSize =
        PlacementMath.FootprintBox(
            template
        )

    local pivotOffset =
        template:GetPivot():
            ToObjectSpace(
                footprintCF
            )

    local halfX =
        main.Size.X / 2

    local halfZ =
        main.Size.Z / 2

    local margin =
        math.max(
            footprintSize.X,
            footprintSize.Z
        ) / 2 + 1

    local step =
        math.max(
            BuildConfig.GridSize or 4,
            math.min(
                footprintSize.X,
                footprintSize.Z
            )
        )

    --------------------------------------------------------
    -- Search legal placement
    --------------------------------------------------------

    for _, rotation in ipairs({
        0,
        90,
        180,
        270
    }) do

        for x =
            -halfX + margin,
            halfX - margin,
            step
        do

            for z =
                -halfZ + margin,
                halfZ - margin,
                step
            do

                local worldPosition =
                    main.CFrame:
                        PointToWorldSpace(
                            Vector3.new(
                                x,
                                0,
                                z
                            )
                        )

                local success,
                      resolved =
                    pcall(function()

                        return
                            PlacementMath.Resolve(
                                plot,
                                main,
                                template,
                                config,
                                worldPosition,
                                rotation,
                                false
                            )

                    end)

                if success
                    and resolved
                then

                    local occupied = true

                    pcall(function()

                        occupied =
                            PlacementMath.IsOccupied(
                                plot,
                                resolved
                                    * pivotOffset,
                                footprintSize,
                                config
                            )

                    end)

                    if not occupied then

                        return
                            resolved.Position,
                            rotation
                    end

                end

            end

        end

    end

    return nil
end

------------------------------------------------------------

local function placeOne(itemId)

    local config =
        BuildConfig.Get(itemId)

    if not config then
        return false
    end

    local category =
        BuildConfig.CategoryOf(
            itemId
        )

    local limit =
        UpgradeEffects.PlacedLimitFor(
            LP,
            category
        )

    if placedCount(category)
        >= limit
    then

        return false
    end

    local position,
          rotation =
        findFreePosition(
            itemId
        )

    if not position then
        return false
    end

    local success,
          result =
        pcall(function()

            return
                PlaceBuild:InvokeServer(
                    itemId,
                    position,
                    rotation
                )

        end)

    return
        success
        and result == true
end

------------------------------------------------------------

local function autoPlaceInventory()

    if battleActive() then
        return
    end

    local inventory =
        inventoryCounts()

    local ids = {}

    for id in pairs(
        inventory
    ) do

        table.insert(ids, id)
    end

    table.sort(ids)

    for _, itemId in ipairs(ids) do

        if not State.AutoPlace then
            return
        end

        while inventoryCount(itemId)
            > 0
        do

            if not State.AutoPlace then
                return
            end

            local placed =
                placeOne(itemId)

            if not placed then
                break
            end

            task.wait(0.35)
        end

    end
end

