--============================================================

local function playerForPlot(plot)

    local userId =
        plot:GetAttribute(
            "OwnerUserId"
        )

    if typeof(userId)
        ~= "number"
    then

        return nil
    end

    return Players:
        GetPlayerByUserId(
            userId
        )
end

------------------------------------------------------------

local function plotForPlayer(player)

    if not player then
        return nil
    end

    local plots =
        Workspace:
            FindFirstChild(
                "Plots"
            )

    if not plots then
        return nil
    end

    for _, plot in ipairs(
        plots:GetChildren()
    ) do

        if plot:GetAttribute(
            "OwnerUserId"
        ) == player.UserId
        then

            return plot
        end

    end

    return nil
end

------------------------------------------------------------

local function targetLocked(plot)

    local player =
        playerForPlot(plot)

    if not player then
        return true
    end

    if player:GetAttribute(
        "BaseLocked"
    ) == true
    then

        return true
    end

    local expiry =
        player:GetAttribute(
            "LockExpiry"
        )

    return
        typeof(expiry) == "number"
        and expiry >
            Workspace:GetServerTimeNow()
end

------------------------------------------------------------

local function validTarget(plot)

    if not plot
        or not plot:IsA("Model")
    then

        return false
    end

    if plot == getMyPlot() then
        return false
    end

    local player =
        playerForPlot(plot)

    if not player
        or player == LP
    then

        return false
    end

    if targetLocked(plot) then
        return false
    end

    if plot:GetAttribute(
        "BattleEndsAt"
    ) ~= nil
    then

        return false
    end

    return true
end

------------------------------------------------------------

local function plotPosition(plot)

    local main =
        plot:FindFirstChild(
            "MainPlotPart"
        )

    if main
        and main:IsA("BasePart")
    then

        return main.Position
    end

    return plot:
        GetPivot().Position
end

------------------------------------------------------------

local function availableTargets()

    local result = {}

    local plots =
        Workspace:
            FindFirstChild(
                "Plots"
            )

    if not plots then
        return result
    end

    for _, plot in ipairs(
        plots:GetChildren()
    ) do

        if validTarget(plot) then

            table.insert(
                result,
                plot
            )
        end

    end

    return result
end

------------------------------------------------------------

local AttackIndex = 1

local function chooseTarget()

    --------------------------------------------------------
    -- SELECTED PLAYER
    --------------------------------------------------------

    if State.AttackMode
        == "Selected Player"
    then

        if not State.SelectedPlayer then
            return nil
        end

        local player =
            Players:FindFirstChild(
                State.SelectedPlayer
            )

        local plot =
            plotForPlayer(player)

        if plot
            and validTarget(plot)
        then

            return plot
        end

        return nil
    end

    local targets =
        availableTargets()

    if #targets == 0 then
        return nil
    end

    --------------------------------------------------------
    -- CLOSEST
    --------------------------------------------------------

    if State.AttackMode
        == "Closest Unlocked"
    then

        local own =
            getMyPlot()

        if not own then
            return targets[1]
        end

        local origin =
            plotPosition(own)

        table.sort(
            targets,
            function(a, b)

                local distanceA =
                    (
                        plotPosition(a)
                        - origin
                    ).Magnitude

                local distanceB =
                    (
                        plotPosition(b)
                        - origin
                    ).Magnitude

                return
                    distanceA
                    < distanceB
            end
        )

        return targets[1]
    end

    --------------------------------------------------------
    -- ANY UNLOCKED
    --------------------------------------------------------

    if AttackIndex >
        #targets
    then

        AttackIndex = 1
    end

    local target =
        targets[AttackIndex]

    AttackIndex += 1

    return target
end

------------------------------------------------------------

local LastAttack =
    0

local function autoAttack()

    if battleActive() then
        return
    end

    if os.clock()
        - LastAttack
        < 2.2
    then

        return
    end

    local target =
        chooseTarget()

    if not target then
        return
    end

    --------------------------------------------------------
    -- Lock state could change after list creation.
    --------------------------------------------------------

    if targetLocked(
        target
    ) then

        return
    end

    local player =
        playerForPlot(
            target
        )

    print(
        "[AUTO ATTACK]",
        player
            and player.Name
            or "?",
        target.Name
    )

    LastAttack =
        os.clock()

    StartAttack:
        FireServer(
            target
        )
end

