-- UPGRADE TREE
--============================================================

local TREE_OPTIONS = {}

if type(
    UpgradeTreeConfig.Nodes
) == "table"
then

    local branchSet = {}

    for nodeId in pairs(
        UpgradeTreeConfig.Nodes
    ) do

        local branch =
            string.match(
                nodeId,
                "^(.-)%d+$"
            )

        if branch then
            branchSet[branch] =
                true
        end

    end

    for branch in pairs(
        branchSet
    ) do

        table.insert(
            TREE_OPTIONS,
            branch
        )
    end

end

table.sort(TREE_OPTIONS)

------------------------------------------------------------

local function treeSelected(
    branch
)

    return selectionContains(
        State.SelectedTree,
        branch
    )
end

------------------------------------------------------------

local function autoTree()

    if type(
        UpgradeTreeConfig.Nodes
    ) ~= "table"
    then

        return
    end

    local nodes = {}

    for nodeId, data in pairs(
        UpgradeTreeConfig.Nodes
    ) do

        local branch =
            string.match(
                nodeId,
                "^(.-)%d+$"
            )

        local tier =
            tonumber(
                string.match(
                    nodeId,
                    "(%d+)$"
                )
            ) or 0

        if branch
            and treeSelected(
                branch
            )
        then

            table.insert(
                nodes,
                {
                    Id = nodeId,
                    Tier = tier,
                    Cost =
                        data.Cost
                        or 0
                }
            )

        end

    end

    --------------------------------------------------------
    -- Earlier tiers first
    --------------------------------------------------------

    table.sort(
        nodes,
        function(a, b)

            if a.Tier ~= b.Tier then
                return a.Tier < b.Tier
            end

            return a.Cost < b.Cost
        end
    )

    for _, node in ipairs(nodes) do

        if not State.AutoTree then
            return
        end

        local cash =
            LP:GetAttribute("Cash")
            or 0

        if cash >= node.Cost then

            BuyTreeUpgrade:
                FireServer(
                    node.Id
                )

            task.wait(0.15)
        end

    end
end

