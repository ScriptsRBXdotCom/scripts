-- ===================== STREAMING FIXES =====================

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local SAVED_PLOT_POSITION = nil

local function getHRP()
	local char = player.Character or player.CharacterAdded:Wait()
	return char:WaitForChild("HumanoidRootPart")
end

-- create permanent streaming loader parts
local function createStreamPart(pos, name)

	if workspace:FindFirstChild(name) then
		return
	end

	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.Transparency = 1
	p.Size = Vector3.new(10,10,10)
	p.Name = name
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace

	return p
end

-- ===================== SAVE PLOT POSITION =====================

task.spawn(function()

	while not SAVED_PLOT_POSITION do

		for _, obj in pairs(workspace:GetDescendants()) do

			if obj:IsA("Model") and obj.Name == ("Plot_" .. player.Name) then

				local part =
					obj.PrimaryPart
					or obj:FindFirstChildWhichIsA("BasePart", true)

				if part then

					SAVED_PLOT_POSITION = part.Position

					createStreamPart(
						SAVED_PLOT_POSITION,
						"SRBX_PlotLoader"
					)

					print("Saved Plot Position:", SAVED_PLOT_POSITION)

					break
				end
			end
		end

		task.wait(1)

	end

end)

